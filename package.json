{
  "name": "kirmes-thueringen",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "npm run db:up && npm run db:migrate && npm run build -w @kirmes/core && concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "predev": "node -e \"const fs=require('fs'); if(!fs.existsSync('.env')){fs.copyFileSync('.env.example','.env'); console.log('.env aus .env.example angelegt')}\"",
    "dev:api": "npm run dev -w @kirmes/api",
    "dev:web": "npm run dev -w @kirmes/web",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint . && prettier --check . && node scripts/migrationen-pruefen.mjs && node scripts/client-skripte-pruefen.mjs && depcruise packages apps/api/src apps/web/src --config .dependency-cruiser.cjs",
    "format": "prettier --write .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:up": "docker compose up -d --wait db",
    "db:stop": "docker compose stop db",
    "db:migrate": "npm run migrate -w @kirmes/api",
    "db:backup": "./scripts/db-backup.sh",
    "db:restore": "./scripts/db-restore.sh",
    "link": "npm run link -w @kirmes/api --",
    "db:orte": "npm run orte -w @kirmes/api",
    "db:beispiele": "npm run beispiele -w @kirmes/api",
    "termine:import": "npm run termine:import -w @kirmes/api --",
    "orte:aktualisieren": "node scripts/ortsverzeichnis.mjs",
    "admin": "npm run admin -w @kirmes/api --",
    "test:db": "./scripts/test-db.sh"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@vitest/coverage-v8": "5.0.3",
    "concurrently": "^10.0.6",
    "dependency-cruiser": "^17.0.0",
    "eslint": "10.12.0",
    "eslint-config-prettier": "^10.1.0",
    "prettier": "^3.6.0",
    "prettier-plugin-astro": "^0.14.0",
    "sharp": "^0.35.5",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "5.0.3"
  }
}
