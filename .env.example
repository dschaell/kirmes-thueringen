# Lokale Entwicklung. Kopie nach .env (wird von Git ignoriert) – `npm run dev` legt sie automatisch an.
# Niemals echte Zugangsdaten committen. Für den Server: siehe deploy/.env.server.example

# Data-Tier: PostgreSQL im Docker-Container (docker-compose.yml, Dienst "db")
POSTGRES_PASSWORD=kirmes_dev_only
DATABASE_URL=postgres://kirmes:kirmes_dev_only@127.0.0.1:5432/kirmes
DB_SSL=false

# Server-Tier: API
API_PORT=3100
LOG_LEVEL=info

# Client-Tier: Website ruft die API serverseitig hier auf
API_URL=http://127.0.0.1:3100
