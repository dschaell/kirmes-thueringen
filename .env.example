# Lokale Entwicklung. Kopie nach .env (wird von Git ignoriert) – `npm run dev` legt sie automatisch an.
# Niemals echte Zugangsdaten committen. Für den Server: siehe deploy/.env.server.example

# Data-Tier: PostgreSQL im Docker-Container (docker-compose.yml, Dienst "db")
POSTGRES_PASSWORD=kirmes_dev_only
# Login der API ohne DDL-Rechte (Docker/Produktion; mind. 16 Zeichen, in Produktion zufällig)
APP_DB_PASSWORD=kirmes_app_dev_only_pw
DATABASE_URL=postgres://kirmes:kirmes_dev_only@127.0.0.1:5432/kirmes
DB_SSL=false

# Server-Tier: API
API_PORT=3100
LOG_LEVEL=info

# Client-Tier: Website ruft die API serverseitig hier auf
API_URL=http://127.0.0.1:3100
# Öffentliche Adresse der Website (Grundlage für Bearbeitungslinks)
WEBSITE_URL=http://localhost:4321
# Adresse der Docker-App (docker compose --profile app), getrennt von npm run dev
# APP_URL=http://localhost:8080

# Integrationstests: eigene Datenbank (npm run test:db), NIE die Arbeitsdatenbank
TEST_DATABASE_URL=postgres://kirmes:kirmes_dev_only@127.0.0.1:5432/kirmes_test

# ── E-Mail (Brevo SMTP) – Meldungen aus „Termin melden“ an die Redaktion ─────────────────
# Brevo → Einstellungen → „SMTP & API“ → SMTP: Login und SMTP-Schlüssel. Nie committen!
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=xxxxxx@smtp-brevo.com
# SMTP_PASS=
# MAIL_FROM="Kirmeskalender Thüringen <noreply@deine-domain.de>"   # in Brevo verifizierter Absender
# MAIL_AN=redaktion@deine-domain.de
# Lokal ohne echten Versand: docker compose --profile mail up -d mailpit, dann
# SMTP_HOST=localhost SMTP_PORT=1025 SMTP_OHNE_TLS=nur-lokal (Mails unter http://localhost:8025)
