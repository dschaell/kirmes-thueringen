---
import Base from '../layouts/Base.astro';
import TerminListe from '../components/TerminListe.astro';
import { termine, kommende, orte, KREISE, kreisSlug, heute, eventJsonLd } from '../lib/data';

const h = heute();
const plus = (tage: number) => new Date(Date.parse(h) + tage * 864e5).toISOString().slice(0, 10);
const naechste = kommende().filter((t) => t.datum! <= plus(21));
const kreise = Object.entries(KREISE)
  .map(([k, name]) => ({ k, name, n: termine.filter((t) => t.kreis === k).length }))
  .filter((x) => x.n > 0)
  .sort((a, b) => b.n - a.n);
const jahr = h.slice(0, 4);
---
<Base
  title={`Kirmes Termine Thüringen ${jahr} – Kirmeskalender mit ${orte.length} Orten`}
  description={`Alle Kirmes-Termine in Thüringen ${jahr}: Kirmestanz, Kindertanz, Zeltkirmes und Brauchtum in ${orte.length} Orten. Suchen nach Ort, Landkreis oder Band – kostenlos als Kalender abonnieren.`}
  jsonLd={[
    {
      '@context': 'https://schema.org', '@type': 'WebSite', name: 'Kirmeskalender Thüringen', url: Astro.site,
      potentialAction: { '@type': 'SearchAction', target: new URL('/termine?q={suche}', Astro.site).href, 'query-input': 'required name=suche' },
    },
    ...naechste.slice(0, 20).map((t) => eventJsonLd(t, Astro.site!)),
  ]}
>
  <section class="hero">
    <h1>Kirmes in Thüringen {jahr}</h1>
    <p class="muted">Der Kirmeskalender für ganz Thüringen – {termine.length.toLocaleString('de-DE')} Termine in {orte.length} Orten. Finde die nächste Kirmes in deiner Nähe.</p>
    <form class="suche" action="/termine" method="get" role="search">
      <label class="sr" for="q" hidden>Suche</label>
      <input id="q" name="q" type="search" placeholder="Ort, Band oder Veranstaltung – z. B. „Mühlberg“ oder „Kindertanz“" autocomplete="off" />
      <button type="submit">Suchen</button>
    </form>
  </section>

  <div class="stats">
    <div class="stat"><b>{kommende().length}</b>kommende Termine</div>
    <div class="stat"><b>{orte.length}</b>Orte</div>
    <div class="stat"><b>{kreise.length}</b>Landkreise</div>
    <div class="stat"><b><a href="/kalender.ics">iCal</a></b>Kalender abonnieren</div>
  </div>

  <h2>Die nächsten drei Wochen</h2>
  {naechste.length ? <TerminListe termine={naechste} /> : <p class="leer">In den nächsten drei Wochen sind keine Termine eingetragen. <a href="/termine">Alle Termine ansehen</a></p>}
  <p><a class="btn" href="/termine">Alle Termine durchsuchen →</a></p>

  <h2>Kirmes nach Landkreis</h2>
  <div class="grid">
    {kreise.map((x) => (
      <a class="card" href={`/kreise/${kreisSlug(x.k)}`} style="text-decoration:none">
        <strong>{x.name}</strong><br /><span class="muted small">{x.n} Termine</span>
      </a>
    ))}
  </div>

  <div class="hinweis">
    <strong>Deine Kirmes fehlt oder ein Termin stimmt nicht?</strong>
    Kirmesgesellschaften und Veranstalter können Termine kostenlos <a href="/termin-melden">hier melden</a>.
  </div>
</Base>
