# Öffentlicher Einstiegspunkt: HTTPS (automatisch via Let's Encrypt) → Website.
# Die API ist nicht öffentlich; die Website ruft sie im internen Docker-Netz auf.
{$DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	reverse_proxy web:4321
}

# www → ohne www (bzw. umgekehrt: DOMAIN entsprechend setzen)
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
