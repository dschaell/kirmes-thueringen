---
/**
 * Suche & Filter werden serverseitig über die API ausgeführt (funktioniert auch ohne JavaScript).
 * Mehrere Filter können vor dem Anwenden gemeinsam ausgewählt werden.
 */
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import TerminListe from '../components/TerminListe.astro';
import KeineTreffer from '../components/KeineTreffer.astro';
import {
  alleTermine,
  listeOrte,
  sucheTermine,
  UngueltigeAnfrage,
  type TerminDto,
  type TerminSeite,
} from '../lib/api';
import { findeOrtEindeutig, sucheOrte, type OrtTreffer } from '../lib/ortssuche';
import {
  KATEGORIEN,
  LANDKREISE,
  anzahl,
  heute,
  wochenende,
  zeitraumKurz,
  imKreis,
  kreisKurz,
  suchZeitraum,
  artName,
  entfernungKm,
  standortAus,
  UMKREISE,
} from '../lib/anzeige';
import type { LandkreisKuerzel } from '@kirmes/core';

const SEITE = 60;
const p = Astro.url.searchParams;
const q = p.get('q')?.slice(0, 100) ?? '';
const kreis = p.get('kreis') ?? '';
const zeitParam = p.get('zeit');
const kat = p.getAll('kat');
const nurBest = p.get('best') === '1';
const vonRoh = p.get('von') ?? '';
const vonParam = /^\d{4}-\d{2}-\d{2}$/.test(vonRoh) ? vonRoh : null;
const offset = Math.max(0, Math.floor(Number(p.get('seite') ?? 1)) - 1) * SEITE || 0;
// In meiner Nähe (Issue #296): eigener Standort (gerundet) oder ein gewählter Ort als Mitte
const um = p.get('um')?.trim().slice(0, 200) ?? '';
const standort = standortAus(p.get('nahe'));
const kmRoh = Number(p.get('km'));
const km = (UMKREISE as readonly number[]).includes(kmRoh) ? kmRoh : 20;
const orte = !standort && um ? await listeOrte() : [];
const umSlug = orte.length ? findeOrtEindeutig(orte, um)?.slug : undefined;
const umOrt = orte.find((o) => o.slug === umSlug) ?? null;
const mitte = standort ?? umOrt?.koordinate ?? null;
const umkreisText = standort ? 'deinen Standort' : (umOrt?.name ?? um);

const h = heute();
const {
  zeit,
  text: suchtext,
  ...zeitraum
} = suchZeitraum({ q, zeit: zeitParam, von: vonParam }, h);
const jahr = zeit === 'jahr' && zeitraum.von ? zeitraum.von.slice(0, 4) : h.slice(0, 4);

let ergebnis: TerminSeite = { gesamt: 0, termine: [] };
let fehler: string | null = null;
const entfernung: Record<string, number> = {};
const suche = {
  ...zeitraum,
  q: suchtext,
  landkreis: kreis ? [kreis] : [],
  kategorie: kat,
  bestaetigt: nurBest || undefined,
};
try {
  if (um && !mitte) {
    fehler = umOrt
      ? `Für ${umOrt.name} ist noch kein Kartenpunkt hinterlegt – bitte einen Nachbarort wählen.`
      : `Ort „${um}“ nicht gefunden – bitte aus der Liste wählen.`;
    Astro.response.status = 400;
  } else if (mitte) {
    // Umkreis: Entfernung zum Festplatz, sonst zur Ortsmitte; Reihenfolge bleibt nach Datum
    const nah = (await alleTermine(suche)).filter((t) => {
      const punkt = t.festplatz ?? t.ort.koordinate;
      if (!punkt) return false;
      entfernung[t.id] = entfernungKm(mitte, punkt);
      return entfernung[t.id]! <= km;
    });
    ergebnis = { gesamt: nah.length, termine: nah.slice(offset, offset + SEITE) };
  } else ergebnis = await sucheTermine({ ...suche, limit: SEITE, offset });
} catch (e) {
  if (!(e instanceof UngueltigeAnfrage)) throw e;
  fehler = e.fehler.map((f) => f.meldung).join(' ');
  Astro.response.status = 400;
}

// Keine Treffer? Auswege statt Sackgasse (Issue #104)
let ortTreffer: OrtTreffer[] = [];
let naechste: TerminDto[] = [];
let breiter: { href: string; text: string } | null = null;
if (!fehler && ergebnis.gesamt === 0) {
  if (suchtext) ortTreffer = sucheOrte(await listeOrte(), suchtext, 3);
  if (zeit !== 'alle') {
    const u = new URLSearchParams(p);
    u.set('zeit', 'alle');
    u.delete('seite');
    u.delete('von');
    breiter = { href: `/termine?${u}`, text: 'Auch vergangene Termine durchsuchen' };
  }
  naechste = (await sucheTermine({ von: h, limit: 5 })).termine;
}

const aktiveFilter =
  (kreis ? 1 : 0) + (zeit !== 'kommend' ? 1 : 0) + kat.length + (nurBest ? 1 : 0) + (mitte ? 1 : 0);
const seiten = Math.ceil(ergebnis.gesamt / SEITE);
const aktuell = offset / SEITE + 1;
const seitenLink = (n: number) => {
  const u = new URLSearchParams(p);
  u.set('seite', String(n));
  return `?${u}`;
};
const kreisListe = (Object.keys(LANDKREISE) as LandkreisKuerzel[]).sort((a, b) =>
  kreisKurz(a).localeCompare(kreisKurz(b), 'de'),
);
const kreisGewaehlt = kreisListe.find((k) => k === kreis);
const ueberschrift = q
  ? `Termine zu „${q}“`
  : [
      zeit === 'wochenende' ? 'Kirmes am Wochenende' : 'Kirmes-Termine',
      kreisGewaehlt && imKreis(kreisGewaehlt),
    ]
      .filter(Boolean)
      .join(' ');
// Aktive Filter als einzeln entfernbare Chips (Issue #111)
const ohne = (name: string, wert?: string) => {
  const u = new URLSearchParams(p);
  u.delete('seite');
  if (wert === undefined) u.delete(name);
  else {
    const rest = u.getAll(name).filter((v) => v !== wert);
    u.delete(name);
    for (const v of rest) u.append(name, v);
  }
  const sauber = new URLSearchParams([...u].filter(([, v]) => v !== ''));
  const text = sauber.toString();
  return text ? `/termine?${text}` : '/termine';
};
const ZEIT_TEXT: Record<string, string> = {
  wochenende: 'Dieses Wochenende',
  jahr: `Ganzes Jahr ${jahr}`,
  vergangen: 'Vergangene Termine',
  alle: 'Alle Termine (±1 Jahr)',
};
const chips = [
  ...(kreisGewaehlt ? [{ text: kreisKurz(kreisGewaehlt), href: ohne('kreis') }] : []),
  ...(zeit !== 'kommend' && zeitParam
    ? [{ text: ZEIT_TEXT[zeit] ?? zeit, href: ohne('zeit') }]
    : []),
  ...kat.filter((k) => k in KATEGORIEN).map((k) => ({ text: artName(k), href: ohne('kat', k) })),
  ...(nurBest ? [{ text: 'Nur bestätigte', href: ohne('best') }] : []),
  ...(mitte
    ? [{ text: `Bis ${km} km um ${umkreisText}`, href: ohne(standort ? 'nahe' : 'um') }]
    : []),
];
Astro.response.headers.set('Cache-Control', 'public, max-age=120');
---

<Base
  title={
    ueberschrift === 'Kirmes-Termine'
      ? `Kirmes-Termine in Thüringen ${heute().slice(0, 4)} – alle Kirmessen nach Datum`
      : ueberschrift === 'Kirmes am Wochenende'
        ? // Suchbegriff „Kirmes Wochenende Thüringen“ samt Datum im Titel (Issue #305)
          `Kirmes am Wochenende in Thüringen (${zeitraumKurz(wochenende().von, wochenende().bis)}) – Kirmeskalender`
        : `${ueberschrift} – Kirmeskalender Thüringen`
  }
  description={
    ueberschrift === 'Kirmes am Wochenende'
      ? `Wo ist dieses Wochenende Kirmes in Thüringen? ${anzahl(ergebnis.gesamt, 'Termin', 'Termine')} vom ${zeitraumKurz(wochenende().von, wochenende().bis)} – Kirmestanz, Frühschoppen, Kinderkirmes, mit Anfahrt.`
      : `Kirmes-Termine in Thüringen ${jahr} durchsuchen: nach Ort, Band, Landkreis, Zeitraum und Art der Veranstaltung.`
  }
>
  <section class="einstieg">
    <h1>{ueberschrift}</h1>
    <form id="filter" method="get" role="search">
      <div class="suchzeile">
        <input
          name="q"
          type="search"
          value={q}
          maxlength="100"
          placeholder="Ort oder Band"
          aria-label="Ort, Band oder Veranstaltung"
        />
        <button class="knopf" type="submit">
          <Icon name="suche" />
          Suchen
        </button>
      </div>
      <input type="hidden" name="nahe" value={standort ? `${standort.lat},${standort.lon}` : ''} />
      <button class="knopf zweit nahe-knopf" type="button" id="nahe-knopf" hidden>
        <Icon name="standort" />
        In meiner Nähe
      </button>
      <p class="klein leise" id="nahe-info" role="status"></p>
      <details class="filter" open={aktiveFilter - (mitte ? 1 : 0) > 0}>
        <summary>
          <Icon name="filter" />
          Filter {aktiveFilter > 0 && <span class="zahl">{aktiveFilter}</span>}
        </summary>
        <div class="filterfelder">
          <div class="zwei">
            <select name="kreis" aria-label="Landkreis">
              <option value="">Alle Landkreise</option>
              {kreisListe.map((k) => (
                <option value={k} selected={k === kreis}>
                  {kreisKurz(k)}
                </option>
              ))}
            </select>
            <select name="zeit" aria-label="Zeitraum">
              <option value="kommend" selected={zeit === 'kommend'}>
                Ab heute
              </option>
              <option value="wochenende" selected={zeit === 'wochenende'}>
                Dieses Wochenende
              </option>
              <option value="jahr" selected={zeit === 'jahr'}>
                Ganzes Jahr {jahr}
              </option>
              <option value="vergangen" selected={zeit === 'vergangen'}>
                Vergangene Termine
              </option>
              <option value="alle" selected={zeit === 'alle'}>
                Alle Termine (±1 Jahr)
              </option>
            </select>
          </div>
          <fieldset>
            <legend>Umkreis</legend>
            <div class="zwei">
              <label class="ortssuche">
                <span class="sr-only">Um Ort</span>
                <input
                  name="um"
                  maxlength="200"
                  placeholder="Um Ort, z. B. Arnstadt"
                  autocomplete="off"
                  value={standort ? '' : um}
                  data-ortssuche
                />
              </label>
              <select name="km" aria-label="Umkreis in km">
                {UMKREISE.map((k) => (
                  <option value={k} selected={k === km}>
                    bis {k} km
                  </option>
                ))}
              </select>
            </div>
          </fieldset>
          <fieldset>
            <legend>Art der Veranstaltung</legend>
            <div class="marken">
              {Object.entries(KATEGORIEN).map(([k, v]) => (
                <label>
                  <input type="checkbox" name="kat" value={k} checked={kat.includes(k)} />
                  {v.label}
                </label>
              ))}
            </div>
          </fieldset>
          <label class="klein">
            <input type="checkbox" name="best" value="1" checked={nurBest} /> Nur vom Veranstalter
            bestätigte Termine
          </label>
          {aktiveFilter > 0 && (
            <a class="klein" href="/termine">
              Alle Filter zurücksetzen
            </a>
          )}
          <button class="knopf" type="submit" data-ohne-js>
            Filter anwenden
          </button>
        </div>
      </details>
    </form>
  </section>

  {fehler && (
    <p class="meldung" role="alert">
      {fehler}
    </p>
  )}
  {chips.length > 0 && (
    <ul class="chips" aria-label="Aktive Filter">
      {chips.map((c) => (
        <li>
          <a href={c.href} aria-label={`Filter entfernen: ${c.text}`}>
            {c.text} <span aria-hidden="true">✕</span>
          </a>
        </li>
      ))}
    </ul>
  )}
  <p class="leise" aria-live="polite" id="trefferzahl">
    {anzahl(ergebnis.gesamt, 'Termin', 'Termine')}
  </p>
  <h2 class="sr-only">Gefundene Termine</h2>
  <TerminListe
    termine={ergebnis.termine}
    leer={false}
    entfernung={mitte ? entfernung : undefined}
  />
  {!fehler && ergebnis.gesamt === 0 && (
    <KeineTreffer orte={ortTreffer} breiter={breiter} naechste={naechste} />
  )}

  {seiten > 1 && (
    <nav class="seiten" aria-label="Seiten">
      {aktuell > 1 && (
        <a class="knopf zweit" href={seitenLink(aktuell - 1)}>
          Zurück
        </a>
      )}
      <span class="leise">
        Seite {aktuell} von {seiten}
      </span>
      {aktuell < seiten && (
        <a class="knopf zweit" href={seitenLink(aktuell + 1)}>
          Weiter
        </a>
      )}
    </nav>
  )}
</Base>
<script>
  import '../scripts/ortssuche';
  // In meiner Nähe (Issue #296): Standort nur auf Knopfdruck, gerundet (~1 km), nie gespeichert
  const naheKnopf = document.querySelector<HTMLButtonElement>('#nahe-knopf');
  const naheInfo = document.querySelector('#nahe-info');
  const filterForm = document.querySelector<HTMLFormElement>('#filter');
  if (naheKnopf && filterForm && 'geolocation' in navigator) {
    naheKnopf.hidden = false;
    naheKnopf.addEventListener('click', () => {
      if (naheInfo) naheInfo.textContent = 'Standort wird ermittelt …';
      navigator.geolocation.getCurrentPosition(
        ({ coords }) => {
          const feld = (n: string) => filterForm.elements.namedItem(n) as HTMLInputElement | null;
          const nahe = feld('nahe');
          if (nahe) nahe.value = `${coords.latitude.toFixed(2)},${coords.longitude.toFixed(2)}`;
          const um = feld('um');
          if (um) um.value = '';
          filterForm.submit();
        },
        () => {
          if (naheInfo)
            naheInfo.textContent =
              'Standort nicht verfügbar – unter „Filter“ einfach einen Ort eintragen.';
        },
        { maximumAge: 600_000, timeout: 10_000 },
      );
    });
  }
  // Ort eingetippt → eigener Standort gilt nicht mehr
  filterForm?.querySelector('input[name="um"]')?.addEventListener('input', () => {
    const nahe = filterForm.elements.namedItem('nahe') as HTMLInputElement | null;
    if (nahe) nahe.value = '';
  });
  // Filter sofort anwenden (Issue #111) – ohne JS bleibt „Filter anwenden“.
  const form = document.querySelector<HTMLFormElement>('#filter');
  const SCHLUESSEL = 'kirmes-filter-fokus';
  if (form) {
    form.querySelector<HTMLElement>('[data-ohne-js]')?.setAttribute('hidden', '');
    form.addEventListener('change', (e) => {
      const feld = e.target as HTMLInputElement | HTMLSelectElement;
      if (!feld.name || feld.name === 'q') return;
      try {
        sessionStorage.setItem(SCHLUESSEL, JSON.stringify([feld.name, feld.value]));
      } catch {
        /* privater Modus */
      }
      form.requestSubmit();
    });
    // Nach dem Neuladen dort weitermachen, wo man war
    try {
      const gemerkt = sessionStorage.getItem(SCHLUESSEL);
      sessionStorage.removeItem(SCHLUESSEL);
      if (gemerkt) {
        const [name, wert] = JSON.parse(gemerkt) as [string, string];
        // Erst nach dem Aufbau der eigenen Auswahlfelder: sichtbaren Knopf statt verstecktem select
        const fokus = () => {
          const ziel = [
            ...form.querySelectorAll<HTMLInputElement>(`[name="${CSS.escape(name)}"]`),
          ].find((el) => el.tagName === 'SELECT' || el.value === wert);
          const sichtbar =
            ziel?.closest('.auswahlfeld')?.querySelector<HTMLElement>('.auswahl-ausloeser') ?? ziel;
          sichtbar?.focus({ preventScroll: true });
        };
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', fokus);
        else setTimeout(fokus, 0);
      }
    } catch {
      /* privater Modus */
    }
  }
</script>
<style>
  #nahe-info:empty {
    display: none;
  }
  .nahe-knopf {
    margin-top: 10px;
  }
  .chips {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 0;
    margin: 0 0 12px;
  }
  .chips a {
    min-height: 40px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 0 12px;
    border-radius: 999px;
    border: 1px solid var(--linie);
    background: var(--flaeche);
    color: var(--tinte);
    text-decoration: none;
    font-weight: 600;
  }
  .chips a:hover {
    border-color: var(--rot);
  }
</style>
