---
/**
 * Suche & Filter werden serverseitig über die API ausgeführt (funktioniert auch ohne JavaScript).
 * Mehrere Filter können vor dem Anwenden gemeinsam ausgewählt werden.
 */
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import TerminListe from '../components/TerminListe.astro';
import { sucheTermine, UngueltigeAnfrage, type TerminSeite } from '../lib/api';
import {
  KATEGORIEN,
  LANDKREISE,
  anzahl,
  heute,
  imKreis,
  kreisKurz,
  suchZeitraum,
} from '../lib/anzeige';
import type { LandkreisKuerzel } from '@kirmes/core';

const SEITE = 60;
const p = Astro.url.searchParams;
const q = p.get('q')?.slice(0, 100) ?? '';
const kreis = p.get('kreis') ?? '';
const zeitParam = p.get('zeit');
const kat = p.getAll('kat');
const nurBest = p.get('best') === '1';
const vonRoh = p.get('von') ?? '';
const vonParam = /^\d{4}-\d{2}-\d{2}$/.test(vonRoh) ? vonRoh : null;
const offset = Math.max(0, Math.floor(Number(p.get('seite') ?? 1)) - 1) * SEITE || 0;

const h = heute();
const {
  zeit,
  text: suchtext,
  ...zeitraum
} = suchZeitraum({ q, zeit: zeitParam, von: vonParam }, h);
const jahr = zeit === 'jahr' && zeitraum.von ? zeitraum.von.slice(0, 4) : h.slice(0, 4);

let ergebnis: TerminSeite = { gesamt: 0, termine: [] };
let fehler: string | null = null;
try {
  ergebnis = await sucheTermine({
    ...zeitraum,
    q: suchtext,
    landkreis: kreis ? [kreis] : [],
    kategorie: kat,
    bestaetigt: nurBest || undefined,
    limit: SEITE,
    offset,
  });
} catch (e) {
  if (!(e instanceof UngueltigeAnfrage)) throw e;
  fehler = e.fehler.map((f) => f.meldung).join(' ');
  Astro.response.status = 400;
}

const aktiveFilter =
  (kreis ? 1 : 0) + (zeit !== 'kommend' ? 1 : 0) + kat.length + (nurBest ? 1 : 0);
const seiten = Math.ceil(ergebnis.gesamt / SEITE);
const aktuell = offset / SEITE + 1;
const seitenLink = (n: number) => {
  const u = new URLSearchParams(p);
  u.set('seite', String(n));
  return `?${u}`;
};
const kreisListe = (Object.keys(LANDKREISE) as LandkreisKuerzel[]).sort((a, b) =>
  kreisKurz(a).localeCompare(kreisKurz(b), 'de'),
);
const kreisGewaehlt = kreisListe.find((k) => k === kreis);
const ueberschrift = q
  ? `Termine zu „${q}“`
  : [
      zeit === 'wochenende' ? 'Kirmes am Wochenende' : 'Kirmes-Termine',
      kreisGewaehlt && imKreis(kreisGewaehlt),
    ]
      .filter(Boolean)
      .join(' ');
Astro.response.headers.set('Cache-Control', 'public, max-age=120');
---

<Base
  title={`${ueberschrift} – Kirmeskalender Thüringen`}
  description={`Kirmes-Termine in Thüringen ${jahr} durchsuchen: nach Ort, Band, Landkreis, Zeitraum und Art der Veranstaltung.`}
>
  <section class="einstieg">
    <h1>{ueberschrift}</h1>
    <form id="filter" method="get" role="search">
      <div class="suchzeile">
        <input
          name="q"
          type="search"
          value={q}
          maxlength="100"
          placeholder="Ort, Band oder Veranstaltung"
          aria-label="Ort, Band oder Veranstaltung"
        />
        <button class="knopf" type="submit"><Icon name="suche" />Suchen</button>
      </div>
      <details class="filter" open={aktiveFilter > 0}>
        <summary>
          <Icon name="filter" />Filter {
            aktiveFilter > 0 && <span class="zahl">{aktiveFilter}</span>
          }
        </summary>
        <div class="filterfelder">
          <div class="zwei">
            <select name="kreis" aria-label="Landkreis">
              <option value="">Alle Landkreise</option>
              {
                kreisListe.map((k) => (
                  <option value={k} selected={k === kreis}>
                    {kreisKurz(k)}
                  </option>
                ))
              }
            </select>
            <select name="zeit" aria-label="Zeitraum">
              <option value="kommend" selected={zeit === 'kommend'}>Ab heute</option>
              <option value="wochenende" selected={zeit === 'wochenende'}>Dieses Wochenende</option>
              <option value="jahr" selected={zeit === 'jahr'}>Ganzes Jahr {jahr}</option>
              <option value="vergangen" selected={zeit === 'vergangen'}>Vergangene Termine</option>
              <option value="alle" selected={zeit === 'alle'}>Ein Jahr zurück und voraus</option>
            </select>
          </div>
          <fieldset>
            <legend>Art der Veranstaltung</legend>
            <div class="marken">
              {
                Object.entries(KATEGORIEN).map(([k, v]) => (
                  <label>
                    <input type="checkbox" name="kat" value={k} checked={kat.includes(k)} />
                    {v.label}
                  </label>
                ))
              }
            </div>
          </fieldset>
          <label class="klein">
            <input type="checkbox" name="best" value="1" checked={nurBest} /> Nur vom Veranstalter bestätigte
            Termine
          </label>
          {
            aktiveFilter > 0 && (
              <a class="klein" href="/termine">
                Alle Filter zurücksetzen
              </a>
            )
          }
          <button class="knopf" type="submit">Filter anwenden</button>
        </div>
      </details>
    </form>
  </section>

  {
    fehler && (
      <p class="meldung" role="alert">
        {fehler}
      </p>
    )
  }
  <p class="leise" aria-live="polite">{anzahl(ergebnis.gesamt, 'Termin', 'Termine')}</p>
  <TerminListe termine={ergebnis.termine} />

  {
    seiten > 1 && (
      <nav class="seiten" aria-label="Seiten">
        {aktuell > 1 && (
          <a class="knopf zweit" href={seitenLink(aktuell - 1)}>
            Zurück
          </a>
        )}
        <span class="leise">
          Seite {aktuell} von {seiten}
        </span>
        {aktuell < seiten && (
          <a class="knopf zweit" href={seitenLink(aktuell + 1)}>
            Weiter
          </a>
        )}
      </nav>
    )
  }
</Base>
