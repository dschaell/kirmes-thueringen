---
/**
 * Suche & Filter werden serverseitig über die API ausgeführt (funktioniert auch ohne JavaScript).
 * Das kleine Skript unten schickt das Formular nur automatisch ab, wenn sich ein Filter ändert.
 */
import Base from '../layouts/Base.astro';
import TerminListe from '../components/TerminListe.astro';
import { sucheTermine, UngueltigeAnfrage, type TerminSeite } from '../lib/api';
import { KATEGORIEN, LANDKREISE, heute, plusTage } from '../lib/anzeige';

const SEITE = 50;
const p = Astro.url.searchParams;
const q = p.get('q')?.slice(0, 100) ?? '';
const kreis = p.get('kreis') ?? '';
const zeit = p.get('zeit') ?? 'kommend';
const kat = p.getAll('kat');
const nurBest = p.get('best') === '1';
const offset = Math.max(0, Number(p.get('seite') ?? 1) - 1) * SEITE;

const h = heute();
const tag = new Date(h).getUTCDay(); // 0 = So
const freitag = plusTage(h, tag === 0 ? -2 : tag === 6 ? -1 : 5 - tag);
const zeitraum =
  zeit === 'wochenende'
    ? { von: freitag, bis: plusTage(freitag, 2) }
    : zeit === 'jahr'
      ? { von: `${h.slice(0, 4)}-01-01`, bis: `${h.slice(0, 4)}-12-31` }
      : { von: h };

let ergebnis: TerminSeite = { gesamt: 0, termine: [] };
let fehler: string | null = null;
try {
  ergebnis = await sucheTermine({
    ...zeitraum,
    q,
    landkreis: kreis ? [kreis] : [],
    kategorie: kat,
    bestaetigt: nurBest || undefined,
    limit: SEITE,
    offset,
  });
} catch (e) {
  if (!(e instanceof UngueltigeAnfrage)) throw e;
  fehler = e.fehler.map((f) => f.meldung).join(' ');
  Astro.response.status = 400;
}

const seiten = Math.ceil(ergebnis.gesamt / SEITE);
const aktuell = offset / SEITE + 1;
const seitenLink = (n: number) => {
  const u = new URLSearchParams(p);
  u.set('seite', String(n));
  return `?${u}`;
};
const jahr = h.slice(0, 4);
Astro.response.headers.set('Cache-Control', 'public, max-age=120');
---

<Base
  title={`Alle Kirmes-Termine ${jahr} in Thüringen – suchen & filtern`}
  description={`Durchsuche alle Kirmes-Termine in Thüringen ${jahr} nach Ort, Landkreis, Zeitraum und Art der Veranstaltung.`}
>
  <section class="hero">
    <h1>Alle Termine</h1>
    <form class="filter" id="filter" method="get" role="search">
      <div class="suche">
        <input
          name="q"
          type="search"
          value={q}
          maxlength="100"
          placeholder="Ort, Band oder Veranstaltung …"
          autocomplete="off"
          aria-label="Suche"
        />
        <select name="kreis" aria-label="Landkreis">
          <option value="">Alle Landkreise</option>
          {
            Object.entries(LANDKREISE).map(([k, n]) => (
              <option value={k} selected={k === kreis}>
                {n}
              </option>
            ))
          }
        </select>
        <select name="zeit" aria-label="Zeitraum">
          <option value="kommend" selected={zeit === 'kommend'}>Ab heute</option>
          <option value="wochenende" selected={zeit === 'wochenende'}>Dieses Wochenende</option>
          <option value="jahr" selected={zeit === 'jahr'}>Ganzes Jahr {jahr}</option>
        </select>
        <button type="submit">Suchen</button>
      </div>
      <fieldset class="chips">
        <legend class="small muted">Art der Veranstaltung</legend>
        {
          Object.entries(KATEGORIEN).map(([k, v]) => (
            <label class="chip">
              <input type="checkbox" name="kat" value={k} checked={kat.includes(k)} />
              {v.emoji} {v.label}
            </label>
          ))
        }
      </fieldset>
      <label class="small muted">
        <input type="checkbox" name="best" value="1" checked={nurBest} /> nur bestätigte Termine
      </label>
    </form>
  </section>

  {
    fehler && (
      <p class="hinweis" role="alert">
        {fehler}
      </p>
    )
  }
  <p class="muted small" aria-live="polite">{ergebnis.gesamt} Termine gefunden</p>
  <TerminListe termine={ergebnis.termine} />

  {
    seiten > 1 && (
      <nav class="seiten" aria-label="Seiten">
        {aktuell > 1 && (
          <a class="btn ghost" href={seitenLink(aktuell - 1)}>
            ← Zurück
          </a>
        )}
        <span class="muted">
          Seite {aktuell} von {seiten}
        </span>
        {aktuell < seiten && (
          <a class="btn ghost" href={seitenLink(aktuell + 1)}>
            Weiter →
          </a>
        )}
      </nav>
    )
  }
</Base>

<script>
  // Fortschrittliche Verbesserung: Filteränderungen sofort anwenden.
  const form = document.getElementById('filter') as HTMLFormElement;
  form.addEventListener('change', (e) => {
    if ((e.target as HTMLElement).getAttribute('name') !== 'q') form.requestSubmit();
  });
</script>
