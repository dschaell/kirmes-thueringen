---
import Base from '../../layouts/Base.astro';
import { listeOrte } from '../../lib/api';
import { LANDKREISE, kreisSlug } from '../../lib/anzeige';

const orte = await listeOrte();
const kreise = Object.entries(LANDKREISE)
  .map(([k, name]) => {
    const imKreis = orte.filter((o) => o.landkreis === k);
    return { k, name, orte: imKreis.length, n: imKreis.reduce((s, o) => s + o.anzahlKommend, 0) };
  })
  .filter((x) => x.orte > 0)
  .sort((a, b) => a.name.localeCompare(b.name, 'de'));
Astro.response.headers.set('Cache-Control', 'public, max-age=600');
---

<Base
  title="Kirmes nach Landkreis – Thüringen"
  description="Kirmes-Termine in Thüringen nach Landkreis: Eichsfeld, Gotha, Ilm-Kreis, Weimarer Land, Wartburgkreis und mehr."
>
  <section class="hero"><h1>Landkreise</h1></section>
  <div class="grid">
    {
      kreise.map((x) => (
        <a class="card card-link" href={`/kreise/${kreisSlug(x.k)}`}>
          <strong>{x.name}</strong> <span class="badge">{x.k}</span>
          <br />
          <span class="muted small">
            {x.orte} Orte · {x.n} kommende Termine
          </span>
        </a>
      ))
    }
  </div>
</Base>
