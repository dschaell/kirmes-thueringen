---
import Base from '../../layouts/Base.astro';
import { KREISE, kreisSlug, orte, termine } from '../../lib/data';

const kreise = Object.entries(KREISE)
  .map(([k, name]) => ({
    k,
    name,
    orte: orte.filter((o) => o.kreis === k).length,
    n: termine.filter((t) => t.kreis === k).length,
  }))
  .filter((x) => x.n > 0)
  .sort((a, b) => a.name.localeCompare(b.name, 'de'));
---

<Base
  title="Kirmes nach Landkreis – Thüringen"
  description="Kirmes-Termine in Thüringen nach Landkreis: Eichsfeld, Gotha, Ilm-Kreis, Weimarer Land, Wartburgkreis und mehr."
>
  <section class="hero"><h1>Landkreise</h1></section>
  <div class="grid">
    {
      kreise.map((x) => (
        <a class="card card-link" href={`/kreise/${kreisSlug(x.k)}`}>
          <strong>{x.name}</strong>{' '}
          <>
            <span class="badge">{x.k}</span>
            <br />
          </>
          <span class="muted small">
            {x.orte} Orte · {x.n} Termine
          </span>
        </a>
      ))
    }
  </div>
</Base>
