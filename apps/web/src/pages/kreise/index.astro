---
import Base from '../../layouts/Base.astro';
import { listeOrte } from '../../lib/api';
import { LANDKREISE, anzahl, kreisKurz, kreisSlug } from '../../lib/anzeige';
import type { LandkreisKuerzel } from '@kirmes/core';

const orte = await listeOrte();
const kreise = (Object.keys(LANDKREISE) as LandkreisKuerzel[])
  .map((k) => {
    const imKreis = orte.filter((o) => o.landkreis === k);
    return { k, n: imKreis.reduce((s, o) => s + o.anzahlKommend, 0), orte: imKreis.length };
  })
  .sort((a, b) => kreisKurz(a.k).localeCompare(kreisKurz(b.k), 'de'));
Astro.response.headers.set('Cache-Control', 'public, max-age=600');
---

<Base
  title="Kirmes nach Landkreis – Kirmeskalender Thüringen"
  description="Kirmes-Termine in Thüringen nach Landkreis und kreisfreier Stadt: Eichsfeld, Gotha, Ilm-Kreis, Weimarer Land, Wartburgkreis und mehr."
>
  <section class="einstieg">
    <h1>Kirmes nach Landkreis</h1>
    <p class="unterzeile">
      Alle Landkreise und kreisfreien Städte Thüringens – mit der Zahl der kommenden Termine.
    </p>
  </section>
  <nav class="kreisraster" aria-label="Landkreise">
    {kreise.map((x) => (
      <a href={`/kreise/${kreisSlug(x.k)}`}>
        <strong>{kreisKurz(x.k)}</strong>
        <span>{anzahl(x.n, 'Termin', 'Termine', 'derzeit keine')}</span>
      </a>
    ))}
  </nav>
</Base>
