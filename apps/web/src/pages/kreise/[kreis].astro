---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import TerminListe from '../../components/TerminListe.astro';
import { listeOrte, sucheTermine } from '../../lib/api';
import { anzahl, heute, imKreis, kreisAusSlug, kreisName } from '../../lib/anzeige';

const k = kreisAusSlug(Astro.params.kreis ?? '');
if (!k) return Astro.rewrite('/404');

const name = kreisName(k);
const h = heute();
const jahr = h.slice(0, 4);
const [kommend, orte] = await Promise.all([
  sucheTermine({ landkreis: [k], von: h, limit: 120 }),
  listeOrte(),
]);
const ortListe = orte.filter((o) => o.landkreis === k);
const mitTerminen = ortListe.filter((o) => o.anzahlKommend > 0);
Astro.response.headers.set('Cache-Control', 'public, max-age=300');
---

<Base
  title={`Kirmes ${imKreis(k)} ${jahr} – alle Termine`}
  description={`Kirmes ${imKreis(k)}: ${anzahl(kommend.gesamt, 'kommender Termin', 'kommende Termine')} in ${anzahl(mitTerminen.length, 'Ort', 'Orten')} – Kirmestanz, Kindertanz und Brauchtum.`}
>
  <p class="brotkrumen"><a href="/kreise">Landkreise</a></p>
  <section class="einstieg">
    <h1>Kirmes {imKreis(k)}</h1>
    <p class="unterzeile">
      {anzahl(kommend.gesamt, 'kommender Termin', 'kommende Termine')} in {
        anzahl(mitTerminen.length, 'Ort', 'Orten')
      }.
    </p>
  </section>

  <div class="zweispaltig">
    <div>
      <TerminListe termine={kommend.termine} />
      {
        kommend.gesamt > kommend.termine.length && (
          <a class="mehr" href={`/termine?kreis=${encodeURIComponent(k)}`}>
            Alle {kommend.gesamt} Termine {imKreis(k)} <Icon name="pfeil" />
          </a>
        )
      }
    </div>
    <aside class="seitenleiste">
      <h2>Orte {imKreis(k)}</h2>
      <ul class="kreisliste">
        {
          ortListe.map((o) => (
            <li>
              <a href={`/orte/${o.slug}`}>{o.name}</a>
              {o.anzahlKommend > 0 && <span class="n">{o.anzahlKommend}</span>}
            </li>
          ))
        }
      </ul>
      <p class="leise klein">{name}: {anzahl(ortListe.length, 'Ort', 'Orte')} im Kalender.</p>
    </aside>
  </div>
</Base>
