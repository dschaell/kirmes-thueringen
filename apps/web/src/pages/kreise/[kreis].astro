---
import Base from '../../layouts/Base.astro';
import TerminListe from '../../components/TerminListe.astro';
import { listeOrte, sucheTermine } from '../../lib/api';
import { heute, kreisAusSlug, kreisName } from '../../lib/anzeige';

const k = kreisAusSlug(Astro.params.kreis ?? '');
if (!k) return Astro.rewrite('/404');

const name = kreisName(k);
const h = heute();
const jahr = h.slice(0, 4);
const [kommend, orte] = await Promise.all([
  sucheTermine({ landkreis: [k], von: h, limit: 200 }),
  listeOrte(),
]);
const ortListe = orte.filter((o) => o.landkreis === k);
Astro.response.headers.set('Cache-Control', 'public, max-age=300');
---

<Base
  title={`Kirmes ${name} ${jahr} – alle Termine im Landkreis`}
  description={`Kirmes-Termine ${jahr} im Landkreis ${name} (${k}): ${ortListe.length} Orte, Kirmestanz, Kindertanz und Zeltkirmes.`}
>
  <p class="small muted"><a href="/kreise">Landkreise</a> › {name}</p>
  <section class="hero">
    <h1>Kirmes im {name}</h1>
    <p class="muted">
      {ortListe.length} Orte · {kommend.gesamt} kommende Termine · <a
        href={`/termine?kreis=${encodeURIComponent(k)}`}>durchsuchen</a
      >
    </p>
  </section>
  <h2>Orte</h2>
  <ul class="ortliste">
    {
      ortListe.map((o) => (
        <li>
          <a href={`/orte/${o.slug}`}>{o.name}</a>
        </li>
      ))
    }
  </ul>
  <h2>Kommende Termine</h2>
  <TerminListe termine={kommend.termine} />
  {
    kommend.gesamt > kommend.termine.length && (
      <p>
        <a class="btn ghost" href={`/termine?kreis=${encodeURIComponent(k)}`}>
          Alle {kommend.gesamt} Termine anzeigen →
        </a>
      </p>
    )
  }
</Base>
