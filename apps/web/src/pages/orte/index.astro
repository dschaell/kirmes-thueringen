---
import Base from '../../layouts/Base.astro';
import { listeOrte, sucheTermine, type OrtUebersichtDto } from '../../lib/api';
import { anzahl, heute, wochenende } from '../../lib/anzeige';
import { findeOrtEindeutig, sucheOrte } from '../../lib/ortssuche';

// Liste: Orte mit kommenden Terminen. Suche: alle 3.000+ Orte (Issue #104).
const h = heute();
const we = wochenende(h);
const [alleOrte, bisSonntag] = await Promise.all([
  listeOrte(),
  sucheTermine({ von: h, bis: we.bis, limit: 200 }),
]);
// Wegweiser „Heute Kirmes in …“ (Issue #263) – nur Ortsnamen, die Termine stehen unter „Termine“
const ortePer = (bedingung: (datum: string) => boolean) => [
  ...new Map(
    bisSonntag.termine.filter((t) => bedingung(t.datum)).map((t) => [t.ort.slug, t.ort]),
  ).values(),
];
const heuteOrte = ortePer((d) => d === h);
const wochenendOrte = heuteOrte.length ? [] : ortePer((d) => d >= we.von);
const heuteSlugs = new Set(heuteOrte.map((o) => o.slug));
const q = (Astro.url.searchParams.get('q') ?? '').trim().slice(0, 100);
if (q) {
  const genau = findeOrtEindeutig(alleOrte, q);
  if (genau) return Astro.redirect(`/orte/${genau.slug}`, 303);
}
const treffer = q ? sucheOrte(alleOrte, q, 30) : [];
const orte = alleOrte.filter((o) => o.anzahlKommend > 0);
/** Sortierbuchstabe ohne Präfixe wie „Erfurt-“ und mit Umlauten unter dem Grundbuchstaben */
const buchstabe = (n: string) =>
  (n.replace(/^(Erfurt-|Apolda-|Sondershausen-|Suhl-|Ilmenau-|St\. )/, '')[0] ?? '#')
    .toUpperCase()
    .replace(/[ÄÖÜ]/, (c) => ({ Ä: 'A', Ö: 'O', Ü: 'U' })[c] ?? c);
const sortiert = [...orte].sort(
  (a, b) =>
    buchstabe(a.name).localeCompare(buchstabe(b.name)) || a.name.localeCompare(b.name, 'de'),
);
const gruppen = new Map<string, OrtUebersichtDto[]>();
for (const o of sortiert)
  gruppen.set(buchstabe(o.name), [...(gruppen.get(buchstabe(o.name)) ?? []), o]);
Astro.response.headers.set('Cache-Control', q ? 'no-store' : 'public, max-age=600');
---

<Base
  title={`Kirmesorte in Thüringen von A bis Z – Kirmeskalender Thüringen`}
  description={`Thüringer Orte mit Kirmes von A bis Z – mit Terminen für Kirmestanz, Kindertanz und Brauchtum.`}
>
  <section class="einstieg">
    <h1>Orte von A bis Z</h1>
    {orte.length > 0 && (
      <p class="unterzeile">{anzahl(orte.length, 'Ort', 'Orte')} mit kommenden Kirmes-Terminen.</p>
    )}
  </section>
  {(heuteOrte.length > 0 || wochenendOrte.length > 0) && (
    <p class="jetzt-los">
      <strong>{heuteOrte.length ? 'Heute Kirmes in:' : 'Dieses Wochenende:'}</strong>{' '}
      {(heuteOrte.length ? heuteOrte : wochenendOrte).map((o, i) => (
        <>
          {i > 0 && ' · '}
          <a href={`/orte/${o.slug}`}>{o.name}</a>
        </>
      ))}
    </p>
  )}
  <form class="ortsuche-form" method="get" action="/orte" role="search">
    <label>
      Jeden Ort in Thüringen finden
      <span class="ortssuche">
        <input
          name="q"
          type="search"
          maxlength="100"
          autocomplete="off"
          placeholder="Ort eingeben"
          data-ortssuche
          value={q}
        />
      </span>
    </label>
    <button class="knopf">Ort öffnen</button>
  </form>
  {q && (
    <section aria-labelledby="h-treffer">
      <h2 id="h-treffer">Orte zu „{q}“</h2>
      {treffer.length === 0 ? (
        <p class="leer">Kein Thüringer Ort gefunden. Bitte die Schreibweise prüfen.</p>
      ) : (
        <ul class="ortliste">
          {treffer.map((t) => (
            <li>
              <a href={`/orte/${t.slug}`}>{t.wert}</a>
            </li>
          ))}
        </ul>
      )}
    </section>
  )}
  {!q && orte.length > 0 && <h2 class="unterkopf">Orte mit kommenden Terminen</h2>}
  {orte.length === 0 && (
    <p class="leer">
      Noch sind keine Termine eingetragen. <a href="/termin-melden">Kennt ihr eine Kirmes?</a>
    </p>
  )}
  <nav class="abc" aria-label="Anfangsbuchstabe">
    {[...gruppen.keys()].map((b) => (
      <a href={`#${b}`}>{b}</a>
    ))}
  </nav>
  {[...gruppen].map(([b, liste]) => (
    <section>
      <h2 class="buchstabe" id={b}>
        {b}
      </h2>
      <ul class="ortliste">
        {liste.map((o) => (
          <li>
            <a href={`/orte/${o.slug}`}>{o.name}</a>
            {heuteSlugs.has(o.slug) && <span class="heute-marke">heute</span>}
            <span class="kz">{o.anzahlKommend}</span>
          </li>
        ))}
      </ul>
    </section>
  ))}
</Base>
<script>
  import '../../scripts/ortssuche';
</script>
<style>
  .jetzt-los {
    border-left: 4px solid var(--rot);
    padding: 10px 14px;
    margin: 0 0 20px;
    background: var(--flaeche);
    border-radius: var(--r);
    line-height: 2;
  }
  .jetzt-los a {
    display: inline-block;
    min-height: 44px;
    line-height: 44px;
  }
  .heute-marke {
    font: 600 0.875rem/1 var(--text);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--auf-knopf);
    background: var(--knopf);
    border-radius: 4px;
    padding: 4px 6px;
    margin-left: 6px;
  }
  .ortsuche-form {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: 12px;
    max-width: 640px;
    margin: 0 0 24px;
  }
  .ortsuche-form label {
    flex: 1 1 260px;
  }
</style>
