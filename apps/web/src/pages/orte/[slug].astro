---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import TerminListe from '../../components/TerminListe.astro';
import { alleTermine, findeOrt, listeOrte } from '../../lib/api';
import { nachKirmes } from '../../lib/terminliste';
import { voraussichtlich } from '../../lib/vorjahr';
import {
  anzahl,
  datumKurz,
  datumLang,
  datumLangJahr,
  brotkrumenJsonLd,
  eventJsonLd,
  heute,
  imKreis,
  kreisName,
  kreisSlug,
  plusTage,
  routenLinks,
} from '../../lib/anzeige';

const ort = await findeOrt(Astro.params.slug ?? '');
if (!ort) return Astro.rewrite('/404');

const h = heute();
const jahr = h.slice(0, 4);
// Zwei Abfragen, weil die API Zeiträume auf 366 Tage begrenzt: kommende und vergangene 12 Monate.
// Auch nach Neujahr bleibt so die letzte Kirmes sichtbar (Issue #106).
const [kommend, bisher, orte] = await Promise.all([
  alleTermine({ ort: ort.slug, von: h, bis: plusTage(h, 365) }),
  alleTermine({ ort: ort.slug, von: plusTage(h, -365), bis: plusTage(h, -1) }),
  listeOrte(),
]);
const vergangen = [...bisher].reverse();
const letzte = nachKirmes(bisher).at(-1);
const naechster = kommend[0];
const nachbarn = orte
  .filter((o) => o.landkreis === ort.landkreis && o.slug !== ort.slug && o.anzahlKommend > 0)
  .slice(0, 30);
// Einbett-Code für Vereins- und Gemeindeseiten (Issue #307)
const einbettCode = `<iframe src="${new URL(`/einbetten/${ort.slug}`, Astro.site).href}" title="Kirmes-Termine ${ort.name}" width="100%" height="420" style="border:0" loading="lazy"></iframe>`;
const route = routenLinks(naechster ?? { festplatz: null, veranstaltungsort: null, ort });
Astro.response.headers.set('Cache-Control', 'public, max-age=300');
---

<Base
  noindex={kommend.length === 0 && vergangen.length === 0}
  title={`Kirmes ${ort.name} ${jahr} – Termine & Anfahrt`}
  description={`Kirmes in ${ort.name} ${imKreis(ort.landkreis)}: ${naechster ? `nächster Termin ${datumLang(naechster.datum)} – ${naechster.titel}` : `alle Termine ${jahr}`}. Mit Anfahrt und Kalender.`}
  jsonLd={[
    brotkrumenJsonLd(
      [
        [kreisName(ort.landkreis), `/kreise/${kreisSlug(ort.landkreis)}`],
        [ort.name, `/orte/${ort.slug}`],
      ],
      Astro.site!,
    ),
    ...kommend.slice(0, 20).map((t) => eventJsonLd(t, Astro.site!)),
  ]}
>
  <p class="brotkrumen">
    <a href="/orte">Orte</a> ›{' '}
    <a href={`/kreise/${kreisSlug(ort.landkreis)}`}>{kreisName(ort.landkreis)}</a>
  </p>
  <section class="einstieg">
    <h1>Kirmes in {ort.name}</h1>
    <p class="unterzeile">
      {naechster ? (
        <>
          Nächster Termin:{' '}
          <strong>
            {naechster.datum.slice(0, 4) === jahr
              ? datumLang(naechster.datum)
              : datumLangJahr(naechster.datum)}
          </strong>{' '}
          – {naechster.titel}
        </>
      ) : letzte ? (
        <>
          {`Letzte Kirmes: ${
            letzte.von === letzte.bis
              ? datumLangJahr(letzte.von)
              : `${datumKurz(letzte.von)} – ${datumLangJahr(letzte.bis)}`
          }. Voraussichtlich wieder im ${voraussichtlich(letzte.von)} – der Termin ist noch nicht eingetragen.`}
        </>
      ) : (
        `Für die nächsten zwölf Monate ist in ${ort.name} noch nichts eingetragen.`
      )}
    </p>
    {!naechster && letzte && (
      <div class="knopfreihe">
        <a class="knopf" href={`/termin-melden?ort=${ort.slug}`}>
          Termin {voraussichtlich(letzte.von).slice(-4)} melden
        </a>
      </div>
    )}
    {naechster && route && (
      <div class="knopfreihe">
        <a
          class="knopf zweit"
          href={route.google}
          data-apple={route.apple}
          target="_blank"
          rel="noopener"
        >
          <Icon name="route" />
          Anfahrt
        </a>
      </div>
    )}
    <p class="klein">
      <a href={`/kalender-abonnieren?ort=${ort.slug}`}>
        Termine von {ort.name} im eigenen Kalender abonnieren
      </a>
    </p>
  </section>

  {kommend.length > 0 && (
    <>
      <h2>Kommende Termine</h2>
      <TerminListe termine={kommend} ortLinks={false} />
    </>
  )}
  {vergangen.length > 0 && (
    <>
      <h2>{naechster ? 'Bereits vorbei' : 'Letzte Kirmes'}</h2>
      <TerminListe termine={vergangen} ortLinks={false} hinweis={false} />
    </>
  )}

  {ort.profil && (
    // Vereinsprofil (Issue #310) – Text der Kirmesgesellschaft, Links ohne SEO-Empfehlung
    <section class="vereinsprofil" aria-labelledby="profil-titel">
      <h2 id="profil-titel">{ort.kgName ?? `Kirmesgesellschaft ${ort.name}`}</h2>
      {ort.profil.text && <p class="profil-text">{ort.profil.text}</p>}
      {(ort.profil.website || ort.profil.instagram || ort.profil.facebook) && (
        <ul class="profil-links">
          {ort.profil.website && (
            <li>
              <a href={ort.profil.website} rel="nofollow ugc noopener" target="_blank">
                Website
              </a>
            </li>
          )}
          {ort.profil.instagram && (
            <li>
              <a href={ort.profil.instagram} rel="nofollow ugc noopener" target="_blank">
                Instagram
              </a>
            </li>
          )}
          {ort.profil.facebook && (
            <li>
              <a href={ort.profil.facebook} rel="nofollow ugc noopener" target="_blank">
                Facebook
              </a>
            </li>
          )}
        </ul>
      )}
      {ort.profil.kontakt && <p class="klein">Kontakt: {ort.profil.kontakt}</p>}
    </section>
  )}

  <div class="kasten abstand">
    <h2>Kirmesgesellschaft {ort.name}?</h2>
    <p>
      Schickt uns neue Termine – oder pflegt sie mit einem eigenen Zugang selbst, samt Festplatz auf
      der Karte, damit „Route“ eure Gäste direkt dorthin führt.
    </p>
    <a class="mehr" href={`/termin-melden?ort=${ort.slug}`}>
      Termin melden <Icon name="pfeil" />
    </a>{' '}
    <a class="mehr" href="/redaktion-mitmachen">
      Eigenen Zugang anfragen <Icon name="pfeil" />
    </a>
    <details class="einbetten">
      <summary>Termine auf eurer Website zeigen</summary>
      <p class="klein">
        Diesen Code auf der Vereins- oder Gemeindeseite einfügen – die Termine aktualisieren sich
        dort von selbst. Ohne Cookies und ohne Tracking.
      </p>
      <textarea readonly rows="4" aria-label="Code zum Einbetten" set:text={einbettCode} />
      <p class="klein">
        <a href={`/einbetten/${ort.slug}`} target="_blank" rel="noopener">
          Vorschau ansehen
        </a>
      </p>
    </details>
  </div>

  {nachbarn.length > 0 && (
    <>
      <h2>Weitere Kirmesorte {imKreis(ort.landkreis)}</h2>
      <ul class="ortliste">
        {nachbarn.map((o) => (
          <li>
            <a href={`/orte/${o.slug}`}>{o.name}</a>
            <span class="kz">{anzahl(o.anzahlKommend, 'Termin', 'Termine')}</span>
          </li>
        ))}
      </ul>
    </>
  )}
</Base>

<script>
  if (/iPhone|iPad|Macintosh/.test(navigator.userAgent)) {
    for (const a of document.querySelectorAll<HTMLAnchorElement>('a[data-apple]'))
      a.href = a.dataset.apple!;
  }
</script>
