---
import Base from '../../layouts/Base.astro';
import TerminListe from '../../components/TerminListe.astro';
import { alleTermine, findeOrt, listeOrte } from '../../lib/api';
import { datumLang, eventJsonLd, heute, kreisName, kreisSlug, plusTage } from '../../lib/anzeige';

const slug = Astro.params.slug ?? '';
const ort = await findeOrt(slug);
if (!ort) return Astro.rewrite('/404');

const h = heute();
const jahr = h.slice(0, 4);
// Zwei Abfragen, weil die API Zeiträume auf 366 Tage begrenzt: kommende 12 Monate + bisher in diesem Jahr
const [kommend, bisher, orte] = await Promise.all([
  alleTermine({ ort: ort.slug, von: h, bis: plusTage(h, 365) }),
  h > `${jahr}-01-01`
    ? alleTermine({ ort: ort.slug, von: `${jahr}-01-01`, bis: plusTage(h, -1) })
    : Promise.resolve([]),
  listeOrte(),
]);
const vergangen = [...bisher].reverse();
const termine = [...bisher, ...kommend];
const kreis = kreisName(ort.landkreis);
const nachbarn = orte
  .filter((o) => o.landkreis === ort.landkreis && o.slug !== ort.slug)
  .slice(0, 24);
const erster = kommend[0];
Astro.response.headers.set('Cache-Control', 'public, max-age=300');
---

<Base
  title={`Kirmes ${ort.name} ${jahr} – Termine (${kreis})`}
  description={`Kirmes in ${ort.name}, ${kreis}: alle Termine ${jahr}${
    termine.length
      ? ' – ' +
        termine
          .slice(0, 3)
          .map((t) => t.titel)
          .join(', ')
      : ''
  }.`}
  jsonLd={kommend.map((t) => eventJsonLd(t, Astro.site!))}
>
  <p class="small muted">
    <a href="/orte">Orte</a> › <a href={`/kreise/${kreisSlug(ort.landkreis)}`}>{kreis}</a> › {
      ort.name
    }
  </p>
  <section class="hero">
    <h1>Kirmes in {ort.name}</h1>
    <p class="muted">
      {
        erster ? (
          <>
            Nächster Termin: <strong>{datumLang(erster.datum)}</strong> – {erster.titel}
          </>
        ) : (
          `Für ${jahr} sind keine weiteren Termine bekannt.`
        )
      }
    </p>
  </section>

  {
    kommend.length > 0 && (
      <>
        <h2>Kommende Termine</h2>
        <TerminListe termine={kommend} ortLinks={false} />
      </>
    )
  }
  {
    vergangen.length > 0 && (
      <>
        <h2>Bereits vorbei ({jahr})</h2>
        <TerminListe termine={vergangen} ortLinks={false} gruppieren={false} />
      </>
    )
  }

  <div class="hinweis">
    Du gehörst zur Kirmesgesellschaft {ort.name}? <a
      href={`/termin-melden?ort=${encodeURIComponent(ort.name)}`}
      >Termine bestätigen oder ergänzen</a
    >.
  </div>

  {
    nachbarn.length > 0 && (
      <>
        <h2>Weitere Kirmes im {kreis}</h2>
        <ul class="ortliste">
          {nachbarn.map((o) => (
            <li>
              <a href={`/orte/${o.slug}`}>{o.name}</a>
            </li>
          ))}
        </ul>
      </>
    )
  }
</Base>
