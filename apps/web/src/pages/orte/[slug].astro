---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import TerminListe from '../../components/TerminListe.astro';
import { alleTermine, findeOrt, listeOrte } from '../../lib/api';
import { nachKirmes } from '../../lib/terminliste';
import { voraussichtlich } from '../../lib/vorjahr';
import {
  anzahl,
  datumKurz,
  datumLang,
  datumLangJahr,
  eventJsonLd,
  heute,
  imKreis,
  kreisName,
  kreisSlug,
  plusTage,
  routenLinks,
} from '../../lib/anzeige';

const ort = await findeOrt(Astro.params.slug ?? '');
if (!ort) return Astro.rewrite('/404');

const h = heute();
const jahr = h.slice(0, 4);
// Zwei Abfragen, weil die API Zeiträume auf 366 Tage begrenzt: kommende und vergangene 12 Monate.
// Auch nach Neujahr bleibt so die letzte Kirmes sichtbar (Issue #106).
const [kommend, bisher, orte] = await Promise.all([
  alleTermine({ ort: ort.slug, von: h, bis: plusTage(h, 365) }),
  alleTermine({ ort: ort.slug, von: plusTage(h, -365), bis: plusTage(h, -1) }),
  listeOrte(),
]);
const vergangen = [...bisher].reverse();
const letzte = nachKirmes(bisher).at(-1);
const naechster = kommend[0];
const nachbarn = orte
  .filter((o) => o.landkreis === ort.landkreis && o.slug !== ort.slug && o.anzahlKommend > 0)
  .slice(0, 30);
const route = routenLinks(naechster ?? { festplatz: null, veranstaltungsort: null, ort });
Astro.response.headers.set('Cache-Control', 'public, max-age=300');
---

<Base
  noindex={kommend.length === 0 && vergangen.length === 0}
  title={`Kirmes ${ort.name} ${jahr} – Termine & Anfahrt`}
  description={`Kirmes in ${ort.name} ${imKreis(ort.landkreis)}: ${naechster ? `nächster Termin ${datumLang(naechster.datum)} – ${naechster.titel}` : `alle Termine ${jahr}`}. Mit Anfahrt und Kalender.`}
  jsonLd={kommend.slice(0, 20).map((t) => eventJsonLd(t, Astro.site!))}
>
  <p class="brotkrumen">
    <a href="/orte">Orte</a> › <a href={`/kreise/${kreisSlug(ort.landkreis)}`}
      >{kreisName(ort.landkreis)}</a
    >
  </p>
  <section class="einstieg">
    <h1>Kirmes in {ort.name}</h1>
    <p class="unterzeile">
      {
        naechster ? (
          <>
            Nächster Termin:{' '}
            <strong>
              {naechster.datum.slice(0, 4) === jahr
                ? datumLang(naechster.datum)
                : datumLangJahr(naechster.datum)}
            </strong>{' '}
            – {naechster.titel}
          </>
        ) : letzte ? (
          <>
            {`Letzte Kirmes: ${
              letzte.von === letzte.bis
                ? datumLangJahr(letzte.von)
                : `${datumKurz(letzte.von)} – ${datumLangJahr(letzte.bis)}`
            }. Voraussichtlich wieder im ${voraussichtlich(letzte.von)} – der Termin ist noch nicht eingetragen.`}
          </>
        ) : (
          `Für die nächsten zwölf Monate ist in ${ort.name} noch nichts eingetragen.`
        )
      }
    </p>
    {
      !naechster && letzte && (
        <div class="knopfreihe">
          <a class="knopf" href={`/termin-melden?ort=${ort.slug}`}>
            Termin {voraussichtlich(letzte.von).slice(-4)} melden
          </a>
        </div>
      )
    }
    {
      naechster && (
        <div class="knopfreihe">
          <a
            class="knopf zweit"
            href={route.google}
            data-apple={route.apple}
            target="_blank"
            rel="noopener"
          >
            <Icon name="route" />
            Anfahrt
          </a>
        </div>
      )
    }
    <p class="klein">
      <a href={`/kalender-abonnieren?ort=${ort.slug}`}>
        Termine von {ort.name} im eigenen Kalender abonnieren
      </a>
    </p>
  </section>

  {
    kommend.length > 0 && (
      <>
        <h2>Kommende Termine</h2>
        <TerminListe termine={kommend} ortLinks={false} />
      </>
    )
  }
  {
    vergangen.length > 0 && (
      <>
        <h2>{naechster ? 'Bereits vorbei' : 'Letzte Kirmes'}</h2>
        <TerminListe termine={vergangen} ortLinks={false} hinweis={false} />
      </>
    )
  }

  <div class="kasten abstand">
    <h2>Kirmesgesellschaft {ort.name}?</h2>
    <p>
      Bestätigt eure Termine oder schickt uns neue. Auf Wunsch bekommt ihr einen persönlichen Link,
      mit dem ihr euren Festplatz auf der Karte eintragt – dann führt „Route“ eure Gäste direkt
      dorthin.
    </p>
    <a class="mehr" href={`/termin-melden?ort=${ort.slug}`}
      >Termin melden oder Link anfordern <Icon name="pfeil" /></a
    >
  </div>

  {
    nachbarn.length > 0 && (
      <>
        <h2>Weitere Kirmesorte {imKreis(ort.landkreis)}</h2>
        <ul class="ortliste">
          {nachbarn.map((o) => (
            <li>
              <a href={`/orte/${o.slug}`}>{o.name}</a>
              <span class="kz">{anzahl(o.anzahlKommend, 'Termin', 'Termine')}</span>
            </li>
          ))}
        </ul>
      </>
    )
  }
</Base>

<script>
  if (/iPhone|iPad|Macintosh/.test(navigator.userAgent)) {
    for (const a of document.querySelectorAll<HTMLAnchorElement>('a[data-apple]'))
      a.href = a.dataset.apple!;
  }
</script>
