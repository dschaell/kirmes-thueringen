---
/**
 * In der Redaktion mitmachen (Issue #56). Die Anfrage geht per E-Mail an das Redaktionspostfach –
 * gespeichert wird nichts. Passt es, schickt ein Admin einen Einladungslink.
 * Schutz wie bei „Termin melden“: CSRF-Token, unsichtbare Falle, Mindestzeit, Drosselung je IP.
 */
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { besucherIp, sendeMeldung, type MeldungsErgebnis } from '../lib/meldung';
import { CSRF_FELD, FORMULAR_COOKIE, csrfGueltig, csrfToken } from '../lib/csrf';

const PFAD = '/redaktion-mitmachen';
const FELDER = ['absender', 'email', 'ort', 'info'] as const;
type Werte = Partial<Record<(typeof FELDER)[number], string>>;

let werte: Werte = {};
let ergebnis: MeldungsErgebnis | { status: 'abgelaufen' } | null = null;
const erwartet = Astro.cookies.get(FORMULAR_COOKIE)?.value;
if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  const text = (n: string) => {
    const v = f.get(n);
    return typeof v === 'string' ? v : '';
  };
  werte = Object.fromEntries(FELDER.map((n) => [n, text(n)]));
  const geladen = Number(text('geladen'));
  ergebnis = !csrfGueltig(erwartet, f.get(CSRF_FELD))
    ? { status: 'abgelaufen' }
    : await sendeMeldung(
        {
          ...Object.fromEntries(Object.entries(werte).filter(([, v]) => v !== '')),
          ort: werte.ort ?? '',
          art: 'mitmachen',
          falle: text('webseite'),
          dauerMs: Number.isFinite(geladen) ? Math.max(0, Date.now() - geladen) : 0,
        },
        besucherIp(Astro.request, Astro.clientAddress),
      );
  if (ergebnis.status === 'gesendet') werte = {};
  else {
    Astro.response.status =
      ergebnis.status === 'fehler' ? 400 : ergebnis.status === 'abgelaufen' ? 403 : 503;
  }
}
Astro.response.headers.set('Cache-Control', 'no-store');
const fehlerZu = (feld: string) =>
  ergebnis?.status === 'fehler' ? ergebnis.fehler.find((x) => x.feld === feld)?.meldung : undefined;
const csrf = csrfToken(Astro.cookies, { cookie: FORMULAR_COOKIE, pfad: PFAD });
const geladen = Date.now();
---

<Base
  title="Mitmachen: Kirmesgesellschaften und Redaktion – Kirmeskalender Thüringen"
  description="Eigener Zugang für eure Kirmesgesellschaft oder Mithilfe in der Redaktion: So bleiben die Kirmestermine in Thüringen vollständig und aktuell."
>
  <section class="einstieg">
    <h1>Mitmachen</h1>
    <p class="unterzeile">
      Ihr seid eine Kirmesgesellschaft, oder du kennst die Kirmes in deiner Gegend? Schreibt uns
      kurz – kostenlos und unverbindlich.
    </p>
  </section>

  <div class="kasten abstand">
    <h2>Für Kirmesgesellschaften</h2>
    <p>
      Ihr bekommt einen <strong>eigenen Zugang für euren Ort</strong>: Termine, Programm, Band,
      Muttizettel-Hinweis und euren Festplatz auf der Karte pflegt ihr selbst – jederzeit, ohne auf
      uns zu warten. Ihr seht und ändert nur euren eigenen Ort.
    </p>
    <p class="leise klein">
      Nur einzelne Termine? Das geht auch ohne Zugang über{' '}
      <a href="/termin-melden">Termin melden</a>.
    </p>
  </div>

  <div class="kasten abstand">
    <h2>Für die Redaktion</h2>
    <p>
      Du kennst die Kirmesgesellschaften in deiner Gegend und willst helfen, die Termine aktuell zu
      halten? Dann mach in der Redaktion mit.
    </p>
  </div>

  <div class="kasten abstand">
    <p>
      <strong>So geht's:</strong>
    </p>
    <ol>
      <li>Ihr schickt uns hier eine kurze Nachricht.</li>
      <li>Passt es, bekommt ihr von uns einen persönlichen Einladungslink.</li>
      <li>
        Über den Link legt ihr einen <strong>Passkey</strong> an (Face ID, Touch ID oder PIN des
        Geräts) – ohne Passwort. Gespeichert wird nur der Name, den ihr dort wählt.
      </li>
    </ol>
  </div>

  <div id="rueckmeldung" class="rueckmeldung">
    {ergebnis?.status === 'gesendet' && (
      <p class="meldung erfolg" role="status">
        <Icon name="haken" />
        Danke! Deine Nachricht ist angekommen. Wir melden uns per E-Mail.
      </p>
    )}
    {ergebnis?.status === 'fehler' && (
      <p class="meldung" role="alert">
        Bitte die markierten Angaben prüfen.
      </p>
    )}
    {ergebnis?.status === 'abgelaufen' && (
      <p class="meldung" role="alert">
        Das Formular war zu lange geöffnet. Bitte noch einmal auf „Senden“ klicken.
      </p>
    )}
    {(ergebnis?.status === 'zu-viele' || ergebnis?.status === 'nicht-moeglich') && (
      <p class="meldung" role="alert">
        Das Senden klappt gerade nicht. Bitte später noch einmal versuchen.
      </p>
    )}
  </div>

  <form class="melden" method="post" action={`${PFAD}#rueckmeldung`}>
    <input type="hidden" name={CSRF_FELD} value={csrf} />
    <input type="hidden" name="geladen" value={geladen} />
    <!-- Falle für Bots: für Menschen unsichtbar und nicht erreichbar -->
    <label class="falle" aria-hidden="true">
      Webseite <input name="webseite" tabindex="-1" autocomplete="off" />
    </label>
    <label>
      Dein Name *
      <input name="absender" required maxlength="120" autocomplete="name" value={werte.absender} />
      {fehlerZu('absender') && <span class="feldfehler">{fehlerZu('absender')}</span>}
    </label>
    <label>
      E-Mail für unsere Antwort *
      <input
        name="email"
        type="email"
        required
        maxlength="200"
        autocomplete="email"
        value={werte.email}
      />
      {fehlerZu('email') && <span class="feldfehler">{fehlerZu('email')}</span>}
    </label>
    <label>
      Euer Ort (Kirmesgesellschaft) oder deine Region
      <input
        name="ort"
        maxlength="120"
        placeholder="z. B. Holzhausen oder Ilm-Kreis"
        value={werte.ort}
      />
    </label>
    <label>
      Ein paar Worte zu euch (optional)
      <span class="leise klein">z. B. Name der Kirmesgesellschaft, wann eure Kirmes ist</span>
      <textarea name="info" rows="4" maxlength="2000" set:text={werte.info ?? ''} />
    </label>
    <p class="leise klein">
      Deine Nachricht geht per E-Mail an die Redaktion und wird nicht gespeichert. Mehr dazu im{' '}
      <a href="/datenschutz">Datenschutz</a>.
    </p>
    <div>
      <button class="knopf" type="submit">
        Senden
      </button>
    </div>
  </form>
</Base>
