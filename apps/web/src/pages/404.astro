---
Astro.response.status = 404;
import Base from '../layouts/Base.astro';
---

<Base
  title="Seite nicht gefunden – Kirmeskalender Thüringen"
  description="Diese Seite gibt es nicht."
  noindex
>
  <section class="einstieg">
    <h1>Seite nicht gefunden</h1>
    <p class="leise">Die Adresse stimmt nicht oder die Seite wurde entfernt.</p>
    <div class="knopfreihe">
      <a class="knopf" href="/termine">
        Termine suchen
      </a>
      <a class="knopf zweit" href="/orte">
        Orte A–Z
      </a>
    </div>
  </section>
</Base>
