---
/** Einladung in die Redaktion annehmen: Name wählen und Passkey anlegen (Issue #56). */
import Base from '../../layouts/Base.astro';
import PasskeyRegistrierung from '../../components/admin/PasskeyRegistrierung.astro';
import { istToken, pruefeZugang } from '../../lib/zugang';

const token = Astro.url.searchParams.get('t');
const p = istToken(token)
  ? await pruefeZugang('einladung', token)
  : { fehler: 'Dieser Einladungslink ist ungültig.', status: 404 };
if ('fehler' in p) Astro.response.status = p.status === 404 ? 404 : 400;
const rolle = 'rolle' in p && p.rolle === 'admin' ? 'Admin' : 'Redaktion';
---

<Base title="Einladung – Redaktion" description="Einladung in die Redaktion annehmen" noindex>
  <section class="einstieg">
    <h1>Willkommen in der Redaktion</h1>
    <p class="unterzeile">Du wurdest eingeladen, beim Kirmeskalender Thüringen mitzumachen.</p>
  </section>
  {
    'fehler' in p || !token ? (
      <p class="meldung" role="alert">
        {'fehler' in p ? p.fehler : ''} Bitte frag nach einem neuen Link.
      </p>
    ) : (
      <>
        <p>
          Rolle: <strong>{rolle}</strong>. Wähle einen Namen und lege einen <strong>Passkey</strong>{' '}
          an – dein Gerät fragt nach Face ID, Touch ID oder PIN. Ein Passwort gibt es nicht, und
          außer dem Namen speichern wir nichts über dich.
        </p>
        <PasskeyRegistrierung art="einladung" token={token} knopf="Einladung annehmen" />
      </>
    )
  }
</Base>
