---
/**
 * Mitglieder der Redaktion verwalten – nur für Admins (Middleware + API prüfen die Rolle).
 * Einladungslinks werden einmal angezeigt; gespeichert ist nur ein Hash.
 */
import AdminLayout from '../../components/admin/AdminLayout.astro';
import CsrfFeld from '../../components/admin/CsrfFeld.astro';
import { adminApi, feld } from '../../lib/admin';

interface Mitglied {
  id: string;
  name: string;
  rolle: 'admin' | 'redaktion';
  erstelltAm: string;
  letzterLogin: string | null;
  passkeys: number;
}
interface Einladung {
  id: string;
  rolle: 'admin' | 'redaktion';
  erstelltAm: string;
  laeuftAb: string;
}

const ROLLEN = { admin: 'Admin', redaktion: 'Redaktion' } as const;
const istRolle = (r: string): r is keyof typeof ROLLEN => r === 'admin' || r === 'redaktion';
const id = (f: FormData) => encodeURIComponent(feld(f, 'id'));

let meldung: string | null = null;
let fehler: string[] = [];
let neuerLink: string | null = null;
if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  const aktion = feld(f, 'aktion');
  const rolle = feld(f, 'rolle');
  if (aktion === 'einladen' && istRolle(rolle)) {
    const r = await adminApi<Einladung & { token: string }>(Astro.cookies, 'POST', 'einladungen', {
      rolle,
    });
    if (r.daten) {
      // Basis aus der Konfiguration, nie aus der Anfrage (Schutz vor manipulierten Host-Headern)
      const basis = process.env.WEBSITE_URL ?? Astro.site?.href ?? 'http://localhost:4321';
      neuerLink = new URL(`/admin/einladung?t=${r.daten.token}`, basis).href;
      meldung = `Einladung (${ROLLEN[rolle]}) erstellt – 7 Tage gültig, nur einmal nutzbar.`;
    } else fehler = r.fehler;
  } else if (aktion === 'widerrufen') {
    const r = await adminApi(Astro.cookies, 'DELETE', `einladungen/${id(f)}`);
    if (r.status < 300) meldung = 'Einladung widerrufen.';
    else fehler = r.fehler;
  } else if (aktion === 'rolle' && istRolle(rolle)) {
    const r = await adminApi(Astro.cookies, 'PUT', `mitglieder/${id(f)}/rolle`, { rolle });
    if (r.status < 300) meldung = `Rolle geändert: ${ROLLEN[rolle]}.`;
    else fehler = r.fehler;
  } else if (aktion === 'entfernen') {
    const r = await adminApi(Astro.cookies, 'DELETE', `mitglieder/${id(f)}`);
    if (r.status < 300) meldung = 'Mitglied entfernt – alle Sitzungen und Passkeys sind gelöscht.';
    else fehler = r.fehler;
  } else fehler = ['Unbekannte Aktion.'];
}
const [mitglieder, einladungen] = await Promise.all([
  adminApi<Mitglied[]>(Astro.cookies, 'GET', 'mitglieder'),
  adminApi<Einladung[]>(Astro.cookies, 'GET', 'einladungen'),
]);
const datum = (iso: string | null) =>
  iso
    ? new Date(iso).toLocaleString('de-DE', {
        dateStyle: 'medium',
        timeStyle: 'short',
        timeZone: 'Europe/Berlin',
      })
    : '–';
const ich = Astro.locals.adminId;
---

<AdminLayout titel="Mitglieder" meldung={meldung} fehler={[...fehler, ...mitglieder.fehler]}>
  {
    neuerLink && (
      <div class="kasten">
        <p>
          <strong>Diesen Link jetzt kopieren und der Person schicken.</strong> Er wird nur einmal
          angezeigt.
        </p>
        <p class="geheim">{neuerLink}</p>
        <p class="leise klein">
          Wer den Link öffnet, wählt einen Namen und legt einen Passkey an. Danach ist der Link
          verbraucht.
        </p>
      </div>
    )
  }

  <h2>Einladen</h2>
  <form class="melden" method="post">
    <CsrfFeld />
    <input type="hidden" name="aktion" value="einladen" />
    <label>
      Rolle
      <select name="rolle">
        <option value="redaktion">Redaktion – Termine, Orte, Mitteilungen, Links</option>
        <option value="admin">Admin – zusätzlich Mitglieder verwalten</option>
      </select>
    </label>
    <div><button class="knopf" type="submit">Einladungslink erstellen</button></div>
  </form>

  {
    (einladungen.daten?.length ?? 0) > 0 && (
      <>
        <h2>Offene Einladungen</h2>
        <table class="admin-tabelle">
          <thead>
            <tr>
              <th>Rolle</th>
              <th>Erstellt</th>
              <th>Gültig bis</th>
              <th />
            </tr>
          </thead>
          <tbody>
            {einladungen.daten?.map((e) => (
              <tr>
                <td>{ROLLEN[e.rolle]}</td>
                <td>{datum(e.erstelltAm)}</td>
                <td>{datum(e.laeuftAb)}</td>
                <td>
                  <form method="post">
                    <CsrfFeld />
                    <input type="hidden" name="aktion" value="widerrufen" />
                    <input type="hidden" name="id" value={e.id} />
                    <button class="knopf zweit" type="submit">
                      Widerrufen
                    </button>
                  </form>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </>
    )
  }

  <h2>Mitglieder</h2>
  <table class="admin-tabelle">
    <thead>
      <tr>
        <th>Name</th>
        <th>Rolle</th>
        <th>Passkeys</th>
        <th>Zuletzt angemeldet</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      {
        (mitglieder.daten ?? []).map((m) => (
          <tr>
            <td>
              {m.name}
              {m.id === ich && <span class="leise"> (du)</span>}
            </td>
            <td>
              <form method="post" class="inline">
                <CsrfFeld />
                <input type="hidden" name="aktion" value="rolle" />
                <input type="hidden" name="id" value={m.id} />
                <select name="rolle" aria-label={`Rolle von ${m.name}`}>
                  <option value="redaktion" selected={m.rolle === 'redaktion'}>
                    Redaktion
                  </option>
                  <option value="admin" selected={m.rolle === 'admin'}>
                    Admin
                  </option>
                </select>
                <button class="knopf zweit" type="submit">
                  Ändern
                </button>
              </form>
            </td>
            <td>{m.passkeys}</td>
            <td>{datum(m.letzterLogin)}</td>
            <td>
              <form method="post">
                <CsrfFeld />
                <input type="hidden" name="aktion" value="entfernen" />
                <input type="hidden" name="id" value={m.id} />
                <button class="knopf zweit" type="submit">
                  Entfernen
                </button>
              </form>
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
  <p class="leise klein">
    Gespeichert sind nur Name, Rolle, Passkeys (öffentliche Schlüssel) und Zeitpunkte – keine
    E-Mail-Adressen, keine Passwörter. Wer alle Passkeys verloren hat, bekommt einfach eine neue
    Einladung (vorher das alte Konto entfernen).
  </p>
</AdminLayout>
