---
/**
 * Mitglieder der Redaktion verwalten – nur für Admins (Middleware + API prüfen die Rolle).
 * Einladungslinks werden einmal angezeigt; gespeichert ist nur ein Hash.
 */
import AdminLayout from '../../components/admin/AdminLayout.astro';
import CsrfFeld from '../../components/admin/CsrfFeld.astro';
import EinladungsLink from '../../components/admin/EinladungsLink.astro';
import { adminApi, feld } from '../../lib/admin';
import { listeOrte } from '../../lib/api';
import { findeOrtEindeutig } from '../../lib/ortssuche';

interface Mitglied {
  id: string;
  name: string;
  rolle: 'admin' | 'redaktion' | 'kirmesgesellschaft';
  ortName?: string | null;
  ortSlug?: string | null;
  kgName?: string | null;
  erstelltAm: string;
  letzterLogin: string | null;
  passkeys: number;
}
interface Einladung {
  bezeichnung?: string;
  id: string;
  rolle: 'admin' | 'redaktion' | 'kirmesgesellschaft';
  ortName?: string;
  erstelltVon?: string | null;
  erstelltAm: string;
  laeuftAb: string;
}

const ROLLEN = {
  admin: 'Admin',
  redaktion: 'Redaktion',
  kirmesgesellschaft: 'Kirmesgesellschaft',
} as const;
const istRolle = (r: string): r is keyof typeof ROLLEN => r in ROLLEN;
const id = (f: FormData) => encodeURIComponent(feld(f, 'id'));

let meldung: string | null = null;
let fehler: string[] = [];
let neuerLink: string | null = null;
let neueRolle: keyof typeof ROLLEN = 'redaktion';
if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  const aktion = feld(f, 'aktion');
  const rolle = feld(f, 'rolle');
  if (aktion === 'einladen' && !istRolle(rolle)) {
    // Keine Vorauswahl mehr (Issue #227) – sonst bekäme man aus Versehen volle Redaktionsrechte
    fehler = ['Bitte eine Rolle wählen.'];
    Astro.response.status = 400;
  } else if (aktion === 'einladen' && istRolle(rolle)) {
    // Kirmesgesellschaft: Ort aus dem Verzeichnis (Issue #180)
    const ortSlug =
      rolle === 'kirmesgesellschaft'
        ? (findeOrtEindeutig(await listeOrte(), feld(f, 'ort'))?.slug ?? '')
        : undefined;
    const r = await adminApi<Einladung & { token: string }>(Astro.cookies, 'POST', 'einladungen', {
      rolle,
      bezeichnung: feld(f, 'bezeichnung'),
      ...(ortSlug !== undefined && { ortSlug }),
    });
    if (r.daten) {
      // Basis aus der Konfiguration, nie aus der Anfrage (Schutz vor manipulierten Host-Headern)
      const basis = process.env.WEBSITE_URL ?? Astro.site?.href ?? 'http://localhost:4321';
      neuerLink = new URL(`/admin/einladung?t=${r.daten.token}`, basis).href;
      neueRolle = r.daten.rolle;
      meldung = `Einladung (${ROLLEN[rolle]}) erstellt – 7 Tage gültig, nur einmal nutzbar.`;
    } else fehler = r.fehler;
  } else if (aktion === 'kgname') {
    // Name der Kirmesgesellschaft (Issue #246) – leer setzt zurück
    const r = await adminApi<{ name: string | null }>(
      Astro.cookies,
      'PUT',
      `orte/${encodeURIComponent(feld(f, 'ortSlug'))}/kirmesgesellschaft`,
      { name: feld(f, 'kgName') },
    );
    if (r.status < 300)
      meldung = r.daten?.name
        ? `Name der Kirmesgesellschaft: „${r.daten.name}“.`
        : 'Name der Kirmesgesellschaft zurückgesetzt.';
    else fehler = r.fehler;
  } else if (aktion === 'name') {
    // Namen korrigieren (Issue #244) – z. B. Vereinsname → Personenname
    const r = await adminApi<{ name: string }>(Astro.cookies, 'PUT', `mitglieder/${id(f)}/name`, {
      name: feld(f, 'name'),
    });
    if (r.daten) meldung = `Name geändert: „${r.daten.name}“.`;
    else fehler = r.fehler;
  } else if (aktion === 'widerrufen') {
    const r = await adminApi(Astro.cookies, 'DELETE', `einladungen/${id(f)}`);
    if (r.status < 300) meldung = 'Einladung widerrufen.';
    else fehler = r.fehler;
  } else if (aktion === 'rolle' && istRolle(rolle)) {
    const r = await adminApi(Astro.cookies, 'PUT', `mitglieder/${id(f)}/rolle`, { rolle });
    if (r.status < 300) meldung = `Rolle geändert: ${ROLLEN[rolle]}.`;
    else fehler = r.fehler;
  } else if (aktion === 'entfernen' && feld(f, 'rueckfrage') === 'ja') {
    const r = await adminApi(Astro.cookies, 'DELETE', `mitglieder/${id(f)}`);
    if (r.status < 300) meldung = 'Mitglied entfernt – alle Sitzungen und Passkeys sind gelöscht.';
    else fehler = r.fehler;
  } else {
    fehler = [
      aktion === 'entfernen'
        ? 'Bitte die Entfernung des Mitglieds ausdrücklich bestätigen.'
        : 'Unbekannte Aktion.',
    ];
    Astro.response.status = 400;
  }
}
const [mitglieder, einladungen] = await Promise.all([
  adminApi<Mitglied[]>(Astro.cookies, 'GET', 'mitglieder'),
  adminApi<Einladung[]>(Astro.cookies, 'GET', 'einladungen'),
]);
const datum = (iso: string | null) =>
  iso
    ? new Date(iso).toLocaleString('de-DE', {
        dateStyle: 'medium',
        timeStyle: 'short',
        timeZone: 'Europe/Berlin',
      })
    : '–';
const ich = Astro.locals.adminId;
// Gruppen (Issue #227): Admin, Redaktion, je Ort „Kirmesgesellschaft <Ort>“ – älteste zuerst
const gruppen = new Map<
  string,
  { titel: string; ort: string | null; offen: boolean; personen: Mitglied[] }
>();
for (const m of [...(mitglieder.daten ?? [])].sort((a, b) =>
  a.erstelltAm.localeCompare(b.erstelltAm),
)) {
  const kg = m.rolle === 'kirmesgesellschaft';
  const schluessel = kg
    ? `3 ${m.ortName ?? ''} ${m.ortSlug ?? ''}`
    : m.rolle === 'admin'
      ? '1'
      : '2';
  const g = gruppen.get(schluessel) ?? {
    // Eigener Vereinsname, sonst „Kirmesgesellschaft <Ort>“ (Issue #246)
    titel: kg
      ? (m.kgName ?? `Kirmesgesellschaft ${m.ortName ?? '(Ort unbekannt)'}`)
      : ROLLEN[m.rolle],
    ort: kg ? (m.ortSlug ?? null) : null,
    offen: !kg,
    personen: [],
  };
  g.personen.push(m);
  gruppen.set(schluessel, g);
}
const gruppenListe = [...gruppen.entries()]
  .sort(([a], [b]) => a.localeCompare(b, 'de'))
  .map(([, g]) => g);
const tag = (iso: string) =>
  new Date(iso).toLocaleDateString('de-DE', { dateStyle: 'medium', timeZone: 'Europe/Berlin' });
const einladungstext = `Mach beim Kirmeskalender Thüringen mit! Hier ist deine Einladung als ${ROLLEN[neueRolle]}. Öffne den Link, wähle deinen Anzeigenamen und richte einen Passkey ein. Der Link gilt 7 Tage und kann einmal verwendet werden.\n\n${neuerLink ?? ''}`;
---

<AdminLayout
  titel="Redaktion & Einladungen"
  meldung={meldung}
  fehler={[...fehler, ...mitglieder.fehler]}
>
  <p>Du kannst weitere Personen in die Redaktion einladen und bestehende Zugänge verwalten.</p>
  {neuerLink && <EinladungsLink link={neuerLink} rolle={ROLLEN[neueRolle]} text={einladungstext} />}

  <h2 id="einladen">Person oder Kirmesgesellschaft einladen</h2>
  <p>
    1. Rolle wählen und Link erstellen. 2. Link kopieren oder eine App öffnen. 3. Empfänger
    auswählen und selbst versenden.
  </p>
  <form class="melden" method="post">
    <CsrfFeld />
    <input type="hidden" name="aktion" value="einladen" />
    <label>
      Für wen? (freiwillig)
      <input name="bezeichnung" maxlength="120" placeholder="z. B. Lisa vom Kirmesverein" />
      <span class="klein leise">
        Interne Bezeichnung, damit du mehrere offene Einladungen unterscheiden kannst.
      </span>
    </label>
    <label>
      Rolle
      <select name="rolle" required>
        <option value="" selected disabled>
          Bitte wählen …
        </option>
        <option value="redaktion">
          Redaktion – alle Orte, Termine, Plätze, Vorschläge und Bearbeitungslinks
        </option>
        <option value="kirmesgesellschaft">
          Kirmesgesellschaft – nur Termine, Plätze und Vorschläge des eigenen Ortes
        </option>
        <option value="admin">Admin – zusätzlich Mitglieder verwalten</option>
      </select>
    </label>
    <label class="kg-ort">
      Ort der Kirmesgesellschaft
      <span class="ortssuche">
        <input
          name="ort"
          maxlength="200"
          placeholder="Ort suchen …"
          autocomplete="off"
          data-ortssuche
        />
      </span>
      <span class="klein leise">
        Nur bei Kirmesgesellschaft: sie sieht und bearbeitet nur diesen Ort.
      </span>
    </label>
    <div>
      <button class="knopf" type="submit">
        Einladungslink erstellen
      </button>
    </div>
  </form>

  {(einladungen.daten?.length ?? 0) > 0 && (
    <>
      <h2>Offene Einladungen</h2>
      <table class="admin-tabelle">
        <thead>
          <tr>
            <th>Für</th>
            <th>Rolle</th>
            <th>Erstellt</th>
            <th>Gültig bis</th>
            <th />
          </tr>
        </thead>
        <tbody>
          {einladungen.daten?.map((e) => (
            <tr>
              <td>
                <span class="tabellen-label">Für</span>
                {e.bezeichnung ?? 'Ohne Bezeichnung'}
              </td>
              <td>
                <span class="tabellen-label">Rolle</span>
                {ROLLEN[e.rolle]}
                {e.ortName && ` (${e.ortName})`}
              </td>
              <td>
                <span class="tabellen-label">Erstellt</span>
                {datum(e.erstelltAm)}
                {e.erstelltVon && <span class="leise klein"> von {e.erstelltVon}</span>}
              </td>
              <td>
                <span class="tabellen-label">Gültig bis</span>
                {datum(e.laeuftAb)}
              </td>
              <td>
                <form method="post">
                  <CsrfFeld />
                  <input type="hidden" name="aktion" value="widerrufen" />
                  <input type="hidden" name="id" value={e.id} />
                  <button class="knopf zweit" type="submit">
                    Widerrufen
                  </button>
                </form>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </>
  )}

  <h2>Mitglieder</h2>
  <p class="leise klein">
    Nach Rolle und Ort sortiert. Kirmesgesellschaften aufklappen, um zu sehen, wer den Ort pflegt.
  </p>
  {gruppenListe.map((g) => (
    <details class="mitgliedergruppe" open={g.offen}>
      <summary>
        <strong>{g.titel}</strong>{' '}
        <span class="leise klein">
          {g.ort && g.personen[0]?.kgName && `(${g.personen[0]?.ortName}) `}·{' '}
          {g.personen.length === 1 ? '1 Person' : `${g.personen.length} Personen`}
        </span>
      </summary>
      {g.ort && (
        <form method="post" class="melden kg-name">
          <CsrfFeld />
          <input type="hidden" name="aktion" value="kgname" />
          <input type="hidden" name="ortSlug" value={g.ort} />
          <label>
            Name der Kirmesgesellschaft
            <input
              name="kgName"
              maxlength="200"
              value={g.personen[0]?.kgName ?? ''}
              placeholder="z. B. Kirmesverein Musterdorf e.V."
            />
            <span class="klein leise">
              Leer lassen = „Kirmesgesellschaft {g.personen[0]?.ortName}“.
            </span>
          </label>
          <div>
            <button class="knopf zweit" type="submit">
              Name speichern
            </button>
          </div>
        </form>
      )}
      <table class="admin-tabelle">
        <thead>
          <tr>
            <th>Name</th>
            <th>Beigetreten</th>
            <th>Zuletzt angemeldet</th>
            <th>Passkeys</th>
            <th>Rolle</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          {g.personen.map((m) => (
            <tr>
              <td>
                <span class="tabellen-label">Name</span>
                {m.name}
                {m.id === ich && <span class="leise"> (du)</span>}
                <details class="name-aendern">
                  <summary class="klein">Name ändern</summary>
                  <form method="post" class="inline">
                    <CsrfFeld />
                    <input type="hidden" name="aktion" value="name" />
                    <input type="hidden" name="id" value={m.id} />
                    <input
                      name="name"
                      required
                      maxlength="60"
                      value={m.name}
                      aria-label={`Neuer Name für ${m.name}`}
                    />
                    <button class="knopf zweit" type="submit">
                      Speichern
                    </button>
                  </form>
                </details>
              </td>
              <td>
                <span class="tabellen-label">Beigetreten</span>
                {tag(m.erstelltAm)}
              </td>
              <td>
                <span class="tabellen-label">Zuletzt angemeldet</span>
                {datum(m.letzterLogin)}
              </td>
              <td>
                <span class="tabellen-label">Passkeys</span>
                {m.passkeys}
              </td>
              <td>
                <span class="tabellen-label">Rolle</span>
                {m.rolle === 'kirmesgesellschaft' ? (
                  <span class="leise">nur {m.ortName}</span>
                ) : (
                  <form method="post" class="inline">
                    <CsrfFeld />
                    <input type="hidden" name="aktion" value="rolle" />
                    <input type="hidden" name="id" value={m.id} />
                    <select name="rolle" aria-label={`Rolle von ${m.name}`}>
                      <option value="redaktion" selected={m.rolle === 'redaktion'}>
                        Redaktion
                      </option>
                      <option value="admin" selected={m.rolle === 'admin'}>
                        Admin
                      </option>
                    </select>
                    <button class="knopf zweit" type="submit">
                      Ändern
                    </button>
                  </form>
                )}
              </td>
              <td>
                <details class="sicherheitsfrage">
                  <summary>Mitglied entfernen …</summary>
                  <p>
                    <strong>{m.name}</strong> wirklich entfernen? Alle Passkeys und Sitzungen dieses
                    Mitglieds werden gelöscht. Das lässt sich hier nicht rückgängig machen.
                  </p>
                  <form method="post">
                    <CsrfFeld />
                    <label>
                      <input type="checkbox" name="rueckfrage" value="ja" required /> Ja, {m.name}{' '}
                      entfernen.
                    </label>
                    <input type="hidden" name="aktion" value="entfernen" />
                    <input type="hidden" name="id" value={m.id} />
                    <button class="knopf gefahr" type="submit">
                      Jetzt endgültig entfernen
                    </button>
                  </form>
                </details>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </details>
  ))}
  <p class="leise klein">
    Gespeichert sind nur Name, Rolle, Passkeys (öffentliche Schlüssel) und Zeitpunkte – keine
    E-Mail-Adressen, keine Passwörter. Wer alle Passkeys verloren hat, bekommt einfach eine neue
    Einladung (vorher das alte Konto entfernen).
  </p>
</AdminLayout>
<style>
  /* Ortsfeld nur bei Rolle Kirmesgesellschaft (Issue #180), auch ohne JavaScript */
  .mitgliedergruppe {
    border: 1px solid var(--linie);
    border-radius: var(--r);
    padding: 0.6rem 1rem;
    margin-bottom: 0.75rem;
    background: var(--flaeche);
  }
  .mitgliedergruppe > summary {
    cursor: pointer;
    padding: 0.3rem 0;
  }
  .mitgliedergruppe[open] > summary {
    margin-bottom: 0.5rem;
  }
  .kg-ort {
    display: none;
  }
  form:has(select[name='rolle'] option[value='kirmesgesellschaft']:checked) .kg-ort {
    display: grid;
  }
</style>
<script>
  import '../../scripts/ortssuche';
</script>
