---
/**
 * Bearbeitungslinks (Issue #229): Neue Links gibt es nicht mehr – Kirmesgesellschaften bekommen ein
 * Konto (Redaktion & Einladungen). Bestehende Links bleiben sichtbar und lassen sich sperren.
 */
import AdminLayout from '../../components/admin/AdminLayout.astro';
import CsrfFeld from '../../components/admin/CsrfFeld.astro';
import { adminApi, feld } from '../../lib/admin';

interface Link {
  id: string;
  ortSlug: string;
  ortName: string;
  bezeichnung: string;
  erstelltAm: string;
  zuletztGenutzt: string | null;
  gesperrtAm: string | null;
}

let meldung: string | null = null;
let fehler: string[] = [];
if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  const r = await adminApi(
    Astro.cookies,
    'POST',
    `links/${encodeURIComponent(feld(f, 'id'))}/sperren`,
  );
  if (r.status < 300) meldung = 'Link gesperrt – er funktioniert ab sofort nicht mehr.';
  else fehler = r.fehler;
}
const links = (await adminApi<Link[]>(Astro.cookies, 'GET', 'links')).daten ?? [];
const aktiv = links.filter((l) => !l.gesperrtAm).length;
---

<AdminLayout titel="Bearbeitungslinks" meldung={meldung} fehler={fehler}>
  <div class="kasten">
    <p>
      <strong>Bearbeitungslinks werden nicht mehr neu vergeben.</strong> Kirmesgesellschaften
      bekommen stattdessen ein eigenes Konto: unter{' '}
      <a href="/admin/mitglieder#einladen">Redaktion &amp; Einladungen</a> mit der Rolle
      „Kirmesgesellschaft“ und ihrem Ort einladen – dann sieht man auch, wer was geändert hat.
    </p>
    <p class="leise klein">
      Früher verschickte Links funktionieren weiter, bis du sie sperrst. Sperre einen Link, sobald
      die Gesellschaft ein Konto hat. {aktiv === 1 ? '1 Link ist' : `${aktiv} Links sind`} noch
      aktiv.
    </p>
  </div>

  <h2>Alle Links</h2>
  {links.length === 0 ? (
    <p class="leer">Noch keine Links erstellt.</p>
  ) : (
    <table class="admin-tabelle">
      <thead>
        <tr>
          <th>Ort</th>
          <th>Für</th>
          <th>Erstellt</th>
          <th>Zuletzt genutzt</th>
          <th />
        </tr>
      </thead>
      <tbody>
        {links.map((l) => (
          <tr>
            <td>
              <span class="tabellen-label">Ort</span>
              <a href={`/orte/${l.ortSlug}`}>{l.ortName}</a>
            </td>
            <td>
              <span class="tabellen-label">Für</span>
              {l.bezeichnung}
            </td>
            <td class="klein">
              <span class="tabellen-label">Erstellt</span>
              {l.erstelltAm}
            </td>
            <td class="klein">
              <span class="tabellen-label">Zuletzt genutzt</span>
              {l.zuletztGenutzt ?? 'noch nie'}
            </td>
            <td>
              {l.gesperrtAm ? (
                <span class="leise klein">gesperrt seit {l.gesperrtAm}</span>
              ) : (
                <form method="post">
                  <CsrfFeld />
                  <input type="hidden" name="aktion" value="sperren" />
                  <input type="hidden" name="id" value={l.id} />
                  <button class="knopf zweit">Sperren</button>
                </form>
              )}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  )}
</AdminLayout>
