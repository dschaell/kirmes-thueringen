---
/**
 * Ersten Redaktionszugang einrichten (Issue #48). Nur solange es noch keinen Admin gibt.
 * 1. Link anfordern → geht ans Redaktionspostfach  2. Link öffnen → Passwort + Authenticator-App
 */
import Base from '../../layouts/Base.astro';
import CsrfFeld from '../../components/admin/CsrfFeld.astro';
import { feld, setzeSitzung } from '../../lib/admin';
import {
  einrichtungsStatus,
  istLink,
  ladeEinrichtung,
  schliesseEinrichtungAb,
  sendeEinrichtungslink,
} from '../../lib/einrichtung';

const link = Astro.url.searchParams.get('link');
let fehler: string[] = [];
let verschickt = false;
let email = '';

if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  if (istLink(link)) {
    email = feld(f, 'email');
    const r = await schliesseEinrichtungAb(link, {
      email,
      passwort: feld(f, 'passwort'),
      passwortWiederholung: feld(f, 'passwort_wiederholung'),
      code: feld(f, 'code'),
    });
    if ('token' in r) {
      setzeSitzung(Astro.cookies, r.token, r.stunden);
      return Astro.redirect('/admin/passkeys?willkommen=1', 303);
    }
    fehler = r.fehler;
    Astro.response.status = r.status;
  } else {
    const r = await sendeEinrichtungslink();
    if ('ok' in r) verschickt = true;
    else fehler = [r.fehler];
  }
}

const status = await einrichtungsStatus();
const einrichtung = status.offen && istLink(link) ? await ladeEinrichtung(link) : null;
if (einrichtung && 'fehler' in einrichtung) fehler = [einrichtung.fehler];
const formular = einrichtung && 'geheimnis' in einrichtung ? einrichtung : null;
const gruppiert = formular?.geheimnis.match(/.{1,4}/g)?.join(' ') ?? '';
---

<Base title="Zugang einrichten – Redaktion" description="Redaktionszugang einrichten" noindex>
  <section class="einstieg">
    <h1>Redaktionszugang einrichten</h1>
    <p class="unterzeile">Einmalig: legt den ersten Zugang für die Redaktion an.</p>
  </section>

  {
    fehler.length > 0 && (
      <div class="meldung" role="alert">
        {fehler.map((f) => (
          <p>{f}</p>
        ))}
      </div>
    )
  }

  {
    !status.offen ? (
      <p class="kasten">
        Der Redaktionszugang ist bereits eingerichtet. <a href="/admin/anmelden">Zur Anmeldung</a>
      </p>
    ) : !status.moeglich ? (
      <p class="kasten">
        Für die Einrichtung muss der E-Mail-Versand eingerichtet sein (SMTP, siehe
        Betriebshandbuch).
      </p>
    ) : formular ? (
      <form class="melden einrichtung" method="post">
        <CsrfFeld />
        <h2>1. Authenticator-App verbinden</h2>
        <p>
          In der Authenticator-App (Google Authenticator, Authy, 1Password …) „Konto hinzufügen“
          wählen und den Code scannen – oder den Schlüssel von Hand eingeben.
        </p>
        <figure class="qr" aria-label="QR-Code für die Authenticator-App">
          <Fragment set:html={formular.qrSvg} />
        </figure>
        <p>
          Schlüssel: <code class="schluessel">{gruppiert}</code>
        </p>
        <h2>2. Zugang festlegen</h2>
        <label>
          E-Mail für die Anmeldung
          <input name="email" type="email" required autocomplete="username" value={email} />
        </label>
        <label>
          Passwort (mind. 12 Zeichen)
          <input
            name="passwort"
            type="password"
            required
            minlength="12"
            autocomplete="new-password"
          />
        </label>
        <label>
          Passwort wiederholen
          <input
            name="passwort_wiederholung"
            type="password"
            required
            minlength="12"
            autocomplete="new-password"
          />
        </label>
        <label>
          Aktueller Code aus der Authenticator-App
          <input
            name="code"
            inputmode="numeric"
            pattern="[0-9]{6}"
            maxlength="6"
            required
            autocomplete="one-time-code"
          />
        </label>
        <div>
          <button class="knopf" type="submit">
            Zugang anlegen
          </button>
        </div>
        <p class="leise klein">
          Danach bist du angemeldet und kannst direkt einen Passkey (Face ID / Touch ID) einrichten.
        </p>
      </form>
    ) : verschickt ? (
      <p class="kasten" role="status">
        Der Einrichtungslink ist an das Redaktionspostfach unterwegs. Er ist 30 Minuten gültig.
      </p>
    ) : (
      <form class="melden" method="post">
        <CsrfFeld />
        <p>
          Wir schicken einen Einrichtungslink an das <strong>Redaktionspostfach</strong> des
          Kalenders. Nur wer dieses Postfach liest, kann den Zugang anlegen.
        </p>
        <div>
          <button class="knopf" type="submit">
            Einrichtungslink senden
          </button>
        </div>
      </form>
    )
  }
</Base>
