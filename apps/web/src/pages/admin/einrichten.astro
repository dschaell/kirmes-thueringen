---
/**
 * Ersten Admin einrichten (Issues #48, #56). Nur solange es noch keinen Admin gibt.
 * 1. Link anfordern → geht ans Redaktionspostfach  2. Link öffnen → Name + Passkey
 */
import Base from '../../layouts/Base.astro';
import CsrfFeld from '../../components/admin/CsrfFeld.astro';
import PasskeyRegistrierung from '../../components/admin/PasskeyRegistrierung.astro';
import {
  einrichtungsStatus,
  istToken,
  pruefeZugang,
  sendeEinrichtungslink,
} from '../../lib/zugang';

const link = Astro.url.searchParams.get('link');
let fehler: string | null = null;
let verschickt = false;
if (Astro.request.method === 'POST') {
  const r = await sendeEinrichtungslink();
  if ('ok' in r) verschickt = true;
  else fehler = r.fehler;
}
const status = await einrichtungsStatus();
let linkGueltig = false;
if (status.offen && istToken(link)) {
  const p = await pruefeZugang('einrichtung', link);
  if ('fehler' in p) fehler = p.fehler;
  else linkGueltig = true;
}
---

<Base title="Admin einrichten – Redaktion" description="Ersten Admin-Zugang einrichten" noindex>
  <section class="einstieg">
    <h1>Admin-Zugang einrichten</h1>
    <p class="unterzeile">Einmalig: legt den ersten Zugang für die Redaktion an – mit Passkey.</p>
  </section>
  {
    fehler && (
      <p class="meldung" role="alert">
        {fehler}
      </p>
    )
  }
  {
    !status.offen ? (
      <p class="kasten">
        Der Admin-Zugang ist bereits eingerichtet. <a href="/admin/anmelden">Zur Anmeldung</a>
      </p>
    ) : !status.moeglich ? (
      <p class="kasten">
        Für die Einrichtung müssen E-Mail-Versand und Website-Adresse eingerichtet sein (siehe
        Betriebshandbuch).
      </p>
    ) : linkGueltig && link ? (
      <>
        <p>
          Wähle einen Namen und lege einen <strong>Passkey</strong> an – dein Gerät fragt nach Face
          ID, Touch ID oder PIN. Ein Passwort gibt es nicht.
        </p>
        <PasskeyRegistrierung art="einrichtung" token={link} knopf="Passkey anlegen" />
      </>
    ) : verschickt ? (
      <p class="kasten" role="status">
        Der Einrichtungslink ist an das Redaktionspostfach unterwegs. Er ist 30 Minuten gültig.
      </p>
    ) : (
      <form class="melden" method="post">
        <CsrfFeld />
        <p>
          Wir schicken einen Einrichtungslink an das <strong>Redaktionspostfach</strong> des
          Kalenders. Nur wer dieses Postfach liest, kann den Zugang anlegen.
        </p>
        <div>
          <button class="knopf" type="submit">
            Einrichtungslink senden
          </button>
        </div>
      </form>
    )
  }
</Base>
