---
import { nameAusKartenlink } from '@kirmes/core';
import AdminLayout from '../../../components/admin/AdminLayout.astro';
import CsrfFeld from '../../../components/admin/CsrfFeld.astro';
import { adminApi, adminPlakat, feld } from '../../../lib/admin';
import type { TerminDto } from '../../../lib/api';
import {
  datumLangJahr,
  eintrittText,
  uhrzeitText,
  plakatPfad,
  speiseZeile,
  artName,
  musikFeld,
} from '../../../lib/anzeige';
import type { TerminHerkunft } from '@kirmes/core';
import Herkunft from '../../../components/admin/TerminHerkunft.astro';
import { listenFilter, nachAktion } from '../../../lib/terminliste';
const id = Astro.params.id ?? '';
// Rücksprung in dieselbe gefilterte Liste (Issue #90)
const zurueck = Astro.url.searchParams.get('zurueck');
const filter = listenFilter(zurueck);
const listenLink = filter.size ? `/admin?${filter}` : '/admin';
const geladen = await adminApi<TerminDto>(
  Astro.cookies,
  'GET',
  `termine/${encodeURIComponent(id)}`,
);
const t = geladen.daten;
let version = t?.version ?? '';
const herkunft = t
  ? await adminApi<Record<string, TerminHerkunft>>(Astro.cookies, 'POST', 'termine/herkunft', {
      ids: [t.id],
    })
  : null;
if (!t) {
  Astro.response.status = 404;
}
let fehler: string[] = geladen.fehler;
let werte = {
  datum: t?.datum ?? '',
  beginn: t?.beginn ?? '',
  ende: t?.ende ?? '',
  titel: t?.titel ?? '',
  band: t?.band ?? '',
  pfarrer: t?.pfarrer ?? '',
  veranstaltungsort: t?.veranstaltungsort ?? '',
  info: t?.info ?? '',
  veranstalter: t?.veranstalter ?? '',
  eintritt: t?.eintrittCent == null ? '' : eintrittText(t.eintrittCent),
  kategorie: t?.kategorie ?? '',
  bestaetigt: t?.bestaetigt ?? false,
  muttizettel: t?.muttizettel ?? false,
};
let speisen = (t?.speisen ?? []).map((s) => ({
  name: s.name,
  preis: s.preisCent === null ? '' : (s.preisCent / 100).toFixed(2).replace('.', ','),
}));
let gerichte = Math.min(20, Math.max(3, speisen.length + 1));
// Felder erst nach Haken (Issue #155); vorab gesetzt, wenn es schon Einträge gibt
let essen = speisen.length > 0;
// Kartenlink direkt bei „Wo genau?“ (Issue #163) – wird als Platz des Ortes gespeichert
let standort = '';
const BILDTYPEN = ['image/jpeg', 'image/png', 'image/webp'];
// Plakat (Issue #297) wird mit „Alle Änderungen speichern“ hochgeladen oder entfernt (Issue #332)
let meldung: string | null =
  Astro.url.searchParams.get('plakat') === 'fehler'
    ? null
    : Astro.url.searchParams.get('plakat') === 'gespeichert'
      ? 'Plakat / Flyer gespeichert.'
      : null;
if (Astro.url.searchParams.get('plakat') === 'fehler')
  fehler = ['Termin gespeichert, das Bild aber nicht – bitte ein JPEG, PNG oder WebP wählen.'];
if (Astro.request.method === 'POST' && t) {
  const f = await Astro.request.formData();
  version = feld(f, 'version');
  werte = {
    datum: feld(f, 'datum'),
    beginn: feld(f, 'beginn'),
    // ohne Haken keine Endzeit (Issue #286)
    ende: f.get('mitende') === 'ja' ? feld(f, 'ende') : '',
    titel: feld(f, 'titel'),
    band: feld(f, 'band'),
    pfarrer: feld(f, 'pfarrer'),
    veranstaltungsort: feld(f, 'veranstaltungsort'),
    info: feld(f, 'info'),
    veranstalter: feld(f, 'veranstalter'),
    eintritt: feld(f, 'eintritt'),
    kategorie: feld(f, 'kategorie'),
    bestaetigt: f.has('bestaetigt'),
    muttizettel: f.has('muttizettel'),
  };
  const namen = f
    .getAll('speise')
    .slice(0, 20)
    .map((v) => (typeof v === 'string' ? v : ''));
  const preise = f
    .getAll('preis')
    .slice(0, 20)
    .map((v) => (typeof v === 'string' ? v : ''));
  speisen = namen.map((name, i) => ({ name, preis: preise[i] ?? '' }));
  essen = f.has('essen');
  standort = feld(f, 'standort');
  // „Wo genau?“ leer? Namen aus dem Google-Maps-Link übernehmen (Issue #165)
  if (standort && !werte.veranstaltungsort.trim())
    werte.veranstaltungsort = nameAusKartenlink(standort) ?? '';
  const plakat = f.get('plakat');
  const neuesPlakat = plakat instanceof File && plakat.size > 0 ? plakat : null;
  if (neuesPlakat && !BILDTYPEN.includes(neuesPlakat.type)) {
    fehler = ['Bitte als Plakat / Flyer ein Foto als JPEG, PNG oder WebP wählen.'];
    Astro.response.status = 400;
  } else if (feld(f, 'aktion') === 'gericht') {
    gerichte = Math.min(20, namen.length + 1);
    essen = true;
  } else {
    const platz = standort
      ? await adminApi<{ name: string }>(
          Astro.cookies,
          'POST',
          `orte/${encodeURIComponent(t.ort.slug)}/festplaetze`,
          // leerer Name: der Server nimmt ihn aus dem (Kurz-)Link oder meldet, dass einer fehlt
          { name: werte.veranstaltungsort.trim(), standort, nameNoetig: true },
        )
      : null;
    if (platz?.daten?.name) werte.veranstaltungsort = platz.daten.name;
    if (platz && platz.status >= 300) {
      fehler = platz.fehler;
      Astro.response.status = platz.status;
    } else {
      const r = await adminApi(Astro.cookies, 'PUT', `termine/${encodeURIComponent(id)}`, {
        ...werte,
        version,
        beginn: werte.beginn || null,
        ende: werte.ende || null,
        ortSlug: t.ort.slug,
        // ohne Haken keine Einträge übernehmen (Issue #155)
        speisen: essen ? speisen : [],
      });
      if (r.status < 300) {
        const bild = neuesPlakat
          ? await adminPlakat(Astro.cookies, t.id, neuesPlakat)
          : f.has('plakat-weg')
            ? await adminPlakat(Astro.cookies, t.id)
            : null;
        if (bild && bild.status >= 300)
          return Astro.redirect(`/admin/termine/${encodeURIComponent(id)}?plakat=fehler`, 303);
        return Astro.redirect(nachAktion(zurueck, 'gespeichert', [id]), 303);
      }
      fehler = r.fehler;
      Astro.response.status = r.status;
    }
  }
  gerichte = Math.max(gerichte, speisen.length);
}
const v = await adminApi<{ bands: string[]; titel: string[] }>(Astro.cookies, 'GET', 'vorschlaege');
const plaetze = t
  ? await adminApi<{ festplaetze: { name: string }[]; veranstaltungsorte: string[] }>(
      Astro.cookies,
      'GET',
      `orte/${encodeURIComponent(t.ort.slug)}/festplaetze`,
    )
  : null;
const hinterlegt =
  !!werte.veranstaltungsort.trim() &&
  (plaetze?.daten?.festplaetze ?? []).some((p) => p.name === werte.veranstaltungsort.trim());
import TerminFelder from '../../../components/admin/TerminFelder.astro';
---

<AdminLayout
  titel={t ? 'Termin bearbeiten' : 'Termin nicht gefunden'}
  fehler={fehler}
  meldung={meldung}
>
  {t && (
    <>
      <p>
        <strong>{t.ort.name}</strong> ·{' '}
        <a href={`/admin/termine?ort=${t.ort.slug}`}>Alle Termine und Plätze dieses Ortes</a> ·{' '}
        {/* Öffentliche Seite (Issue #333) */}
        <a href={`/termin/${t.id}`} target="_blank" rel="noopener">
          Auf der Website ansehen
        </a>
      </p>
      <Herkunft herkunft={herkunft?.daten?.[id]} />
      {fehler.length > 0 && (
        <div class="kasten">
          <p>
            Deine Eingaben stehen weiter im Formular. Bei einem Konflikt bitte zuerst vergleichen:
          </p>
          <details>
            <summary>Aktuell gespeicherten Stand anzeigen</summary>
            <dl>
              <dt>Veranstaltung</dt>
              <dd>{t.titel}</dd>
              <dt>Datum / Uhrzeit</dt>
              <dd>
                {datumLangJahr(t.datum)} {uhrzeitText(t) && `· ${uhrzeitText(t)} Uhr`}
              </dd>
              <dt>{musikFeld(t.kategorie)}</dt>
              <dd>{t.band ?? '–'}</dd>
              {t.pfarrer && (
                <>
                  <dt>Pfarrer/in</dt>
                  <dd>{t.pfarrer}</dd>
                </>
              )}
              <dt>Veranstalter</dt>
              <dd>{t.veranstalter ?? '–'}</dd>
              <dt>Eintritt</dt>
              <dd>{t.eintrittCent == null ? '–' : eintrittText(t.eintrittCent)}</dd>
              <dt>Hinweise</dt>
              <dd>{t.info ?? '–'}</dd>
              <dt>Wo genau?</dt>
              <dd>{t.veranstaltungsort ?? '–'}</dd>
              <dt>Art</dt>
              <dd>{artName(t.kategorie)}</dd>
              <dt>Vom Veranstalter bestätigt</dt>
              <dd>{t.bestaetigt ? 'Ja' : 'Nein'}</dd>
              <dt>Muttizettel erforderlich</dt>
              <dd>{t.muttizettel ? 'Ja' : 'Nein'}</dd>
              <dt>Essen & Getränke</dt>
              <dd>{t.speisen?.length ? t.speisen.map(speiseZeile).join('; ') : 'Keine Angaben'}</dd>
            </dl>
          </details>
          <p>
            <a href={Astro.url.pathname}>Aktuellen Stand neu öffnen</a> ·{' '}
            <a href={`/admin/termine?ort=${encodeURIComponent(t.ort.slug)}`}>
              Alle Termine des Ortes
            </a>
          </p>
        </div>
      )}

      <form
        class="melden"
        method="post"
        enctype="multipart/form-data"
        data-ungespeichert
        data-terminentwurf
      >
        <CsrfFeld />
        <input type="hidden" name="version" value={version} />
        <TerminFelder
          w={{ ...werte, standort, essen, speisen, gerichte }}
          veranstalterPlatzhalter={t.ort.kgName ?? `Kirmesgesellschaft ${t.ort.name}`}
          kartenHinweis={`Gilt für alle Termine in ${t.ort.name} mit gleichem „Wo genau?“.`}
          listen={{
            titel: 'titel-bearbeiten',
            bands: 'bands-bearbeiten',
            plaetze: 'plaetze-bearbeiten',
          }}
        >
          <Fragment slot="wo">
            {hinterlegt && (
              <p class="klein leise">
                „{werte.veranstaltungsort}“ ist auf der Karte hinterlegt – die Route führt genau
                dorthin. Ein neuer Link ersetzt die Position.
              </p>
            )}
            <p class="klein leise">
              Alle Plätze umbenennen oder ändern:{' '}
              <a href={`/admin/orte/${t.ort.slug}`}>Ort & Plätze in {t.ort.name}</a>
            </p>
          </Fragment>
          <fieldset class="kasten plakat-hochladen">
            <legend>Plakat / Flyer</legend>
            {t.plakat && (
              <img
                class="plakat-vorschau"
                src={plakatPfad(t.id, t.plakat, 'klein')}
                alt="Aktuelles Plakat / Flyer"
                loading="lazy"
              />
            )}
            <label>
              {t.plakat ? 'Anderes Bild hochladen' : 'Plakat, Flyer oder Foto hochladen'}
              <input type="file" name="plakat" accept="image/jpeg,image/png,image/webp" />
              <span class="klein leise">
                JPEG, PNG oder WebP, höchstens 8 MB. Nur Bilder hochladen, an denen ihr die Rechte
                habt (z. B. euer eigenes Plakat oder euren Flyer). Wir speichern eine verkleinerte
                Kopie ohne Metadaten. Gespeichert wird mit „Alle Änderungen speichern“.
              </span>
            </label>
            {t.plakat && (
              <label>
                <input type="checkbox" name="plakat-weg" value="ja" /> Plakat / Flyer entfernen
              </label>
            )}
          </fieldset>
        </TerminFelder>
        <div class="knopfreihe">
          <>
            <button class="knopf" name="aktion" value="speichern">
              Alle Änderungen speichern
            </button>
            <a href={listenLink}>Abbrechen</a>
          </>
        </div>
      </form>
      <datalist id="bands-bearbeiten">
        {(v.daten?.bands ?? []).map((b) => (
          <option value={b} />
        ))}
      </datalist>
      <datalist id="titel-bearbeiten">
        {(v.daten?.titel ?? []).map((t) => (
          <option value={t} />
        ))}
      </datalist>
      <datalist id="plaetze-bearbeiten">
        {[
          ...new Set([
            ...(plaetze?.daten?.festplaetze ?? []).map((p) => p.name),
            ...(plaetze?.daten?.veranstaltungsorte ?? []),
          ]),
        ].map((p) => (
          <option value={p} />
        ))}
      </datalist>
    </>
  )}
</AdminLayout>
<style>
  .knopfreihe {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
  }
</style>
