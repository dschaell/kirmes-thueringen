---
import { nameAusKartenlink } from '@kirmes/core';
import AdminLayout from '../../../components/admin/AdminLayout.astro';
import CsrfFeld from '../../../components/admin/CsrfFeld.astro';
import { adminApi, feld } from '../../../lib/admin';
import type { TerminDto } from '../../../lib/api';
import { KATEGORIEN, datumLangJahr, speiseZeile, artName, musikFeld } from '../../../lib/anzeige';
import type { TerminHerkunft } from '@kirmes/core';
import Herkunft from '../../../components/admin/TerminHerkunft.astro';
import { listenFilter, nachAktion } from '../../../lib/terminliste';
const id = Astro.params.id ?? '';
// Rücksprung in dieselbe gefilterte Liste (Issue #90)
const zurueck = Astro.url.searchParams.get('zurueck');
const filter = listenFilter(zurueck);
const listenLink = filter.size ? `/admin?${filter}` : '/admin';
const geladen = await adminApi<TerminDto>(
  Astro.cookies,
  'GET',
  `termine/${encodeURIComponent(id)}`,
);
const t = geladen.daten;
let version = t?.version ?? '';
const herkunft = t
  ? await adminApi<Record<string, TerminHerkunft>>(Astro.cookies, 'POST', 'termine/herkunft', {
      ids: [t.id],
    })
  : null;
if (!t) {
  Astro.response.status = 404;
}
let fehler: string[] = geladen.fehler;
let werte = {
  datum: t?.datum ?? '',
  beginn: t?.beginn ?? '',
  titel: t?.titel ?? '',
  band: t?.band ?? '',
  pfarrer: t?.pfarrer ?? '',
  veranstaltungsort: t?.veranstaltungsort ?? '',
  info: t?.info ?? '',
  kategorie: t?.kategorie ?? '',
  bestaetigt: t?.bestaetigt ?? false,
  muttizettel: t?.muttizettel ?? false,
};
let speisen = (t?.speisen ?? []).map((s) => ({
  name: s.name,
  preis: s.preisCent === null ? '' : (s.preisCent / 100).toFixed(2).replace('.', ','),
}));
let gerichte = Math.min(20, Math.max(3, speisen.length + 1));
// Felder erst nach Haken (Issue #155); vorab gesetzt, wenn es schon Einträge gibt
let essen = speisen.length > 0;
// Kartenlink direkt bei „Wo genau?“ (Issue #163) – wird als Platz des Ortes gespeichert
let standort = '';
if (Astro.request.method === 'POST' && t) {
  const f = await Astro.request.formData();
  version = feld(f, 'version');
  werte = {
    datum: feld(f, 'datum'),
    beginn: feld(f, 'beginn'),
    titel: feld(f, 'titel'),
    band: feld(f, 'band'),
    pfarrer: feld(f, 'pfarrer'),
    veranstaltungsort: feld(f, 'veranstaltungsort'),
    info: feld(f, 'info'),
    kategorie: feld(f, 'kategorie'),
    bestaetigt: f.has('bestaetigt'),
    muttizettel: f.has('muttizettel'),
  };
  const namen = f
    .getAll('speise')
    .slice(0, 20)
    .map((v) => (typeof v === 'string' ? v : ''));
  const preise = f
    .getAll('preis')
    .slice(0, 20)
    .map((v) => (typeof v === 'string' ? v : ''));
  speisen = namen.map((name, i) => ({ name, preis: preise[i] ?? '' }));
  essen = f.has('essen');
  standort = feld(f, 'standort');
  // „Wo genau?“ leer? Namen aus dem Google-Maps-Link übernehmen (Issue #165)
  if (standort && !werte.veranstaltungsort.trim())
    werte.veranstaltungsort = nameAusKartenlink(standort) ?? '';
  if (feld(f, 'aktion') === 'gericht') {
    gerichte = Math.min(20, namen.length + 1);
    essen = true;
  } else {
    const platz = standort
      ? await adminApi<{ name: string }>(
          Astro.cookies,
          'POST',
          `orte/${encodeURIComponent(t.ort.slug)}/festplaetze`,
          // leerer Name: der Server nimmt ihn aus dem (Kurz-)Link oder meldet, dass einer fehlt
          { name: werte.veranstaltungsort.trim(), standort, nameNoetig: true },
        )
      : null;
    if (platz?.daten?.name) werte.veranstaltungsort = platz.daten.name;
    if (platz && platz.status >= 300) {
      fehler = platz.fehler;
      Astro.response.status = platz.status;
    } else {
      const r = await adminApi(Astro.cookies, 'PUT', `termine/${encodeURIComponent(id)}`, {
        ...werte,
        version,
        beginn: werte.beginn || null,
        ortSlug: t.ort.slug,
        // ohne Haken keine Einträge übernehmen (Issue #155)
        speisen: essen ? speisen : [],
      });
      if (r.status < 300) return Astro.redirect(nachAktion(zurueck, 'gespeichert', [id]), 303);
      fehler = r.fehler;
      Astro.response.status = r.status;
    }
  }
  gerichte = Math.max(gerichte, speisen.length);
}
const v = await adminApi<{ bands: string[]; titel: string[] }>(Astro.cookies, 'GET', 'vorschlaege');
const plaetze = t
  ? await adminApi<{ festplaetze: { name: string }[]; veranstaltungsorte: string[] }>(
      Astro.cookies,
      'GET',
      `orte/${encodeURIComponent(t.ort.slug)}/festplaetze`,
    )
  : null;
const hinterlegt =
  !!werte.veranstaltungsort.trim() &&
  (plaetze?.daten?.festplaetze ?? []).some((p) => p.name === werte.veranstaltungsort.trim());
---

<AdminLayout titel={t ? 'Termin bearbeiten' : 'Termin nicht gefunden'} fehler={fehler}>
  {
    t && (
      <>
        <p>
          <strong>{t.ort.name}</strong> ·{' '}
          <a href={`/admin/termine?ort=${t.ort.slug}`}>Alle Termine und Plätze dieses Ortes</a>
        </p>
        <Herkunft herkunft={herkunft?.daten?.[id]} />
        {fehler.length > 0 && (
          <div class="kasten">
            <p>
              Deine Eingaben stehen weiter im Formular. Bei einem Konflikt bitte zuerst vergleichen:
            </p>
            <details>
              <summary>Aktuell gespeicherten Stand anzeigen</summary>
              <dl>
                <dt>Veranstaltung</dt>
                <dd>{t.titel}</dd>
                <dt>Datum / Uhrzeit</dt>
                <dd>
                  {datumLangJahr(t.datum)} {t.beginn && `· ${t.beginn} Uhr`}
                </dd>
                <dt>{musikFeld(t.kategorie)}</dt>
                <dd>{t.band ?? '–'}</dd>
                {t.pfarrer && (
                  <>
                    <dt>Pfarrer/in</dt>
                    <dd>{t.pfarrer}</dd>
                  </>
                )}
                <dt>Hinweise</dt>
                <dd>{t.info ?? '–'}</dd>
                <dt>Wo genau?</dt>
                <dd>{t.veranstaltungsort ?? '–'}</dd>
                <dt>Art</dt>
                <dd>{artName(t.kategorie)}</dd>
                <dt>Vom Veranstalter bestätigt</dt>
                <dd>{t.bestaetigt ? 'Ja' : 'Nein'}</dd>
                <dt>Muttizettel erforderlich</dt>
                <dd>{t.muttizettel ? 'Ja' : 'Nein'}</dd>
                <dt>Essen & Getränke</dt>
                <dd>
                  {t.speisen?.length ? t.speisen.map(speiseZeile).join('; ') : 'Keine Angaben'}
                </dd>
              </dl>
            </details>
            <p>
              <a href={Astro.url.pathname}>Aktuellen Stand neu öffnen</a> ·{' '}
              <a href={`/admin/termine?ort=${encodeURIComponent(t.ort.slug)}`}>
                Alle Termine des Ortes
              </a>
            </p>
          </div>
        )}

        <form class="melden" method="post" data-ungespeichert data-terminentwurf>
          <CsrfFeld />
          <input type="hidden" name="version" value={version} />
          <div class="zwei">
            <>
              <label>
                Datum
                <input type="date" name="datum" required value={werte.datum} />
              </label>
              <label>
                Uhrzeit
                <input type="time" name="beginn" value={werte.beginn} />
              </label>
            </>
          </div>
          <label>
            Veranstaltung
            <input
              name="titel"
              required
              maxlength="200"
              list="titel-bearbeiten"
              value={werte.titel}
            />
          </label>
          <div class="zwei">
            <>
              <label>
                {musikFeld(werte.kategorie)}
                <input name="band" maxlength="120" list="bands-bearbeiten" value={werte.band} />
              </label>
              {(werte.kategorie === 'tradition' || werte.pfarrer) && (
                <label>
                  Pfarrer/in (optional)
                  <input name="pfarrer" maxlength="120" value={werte.pfarrer} />
                </label>
              )}
              <label>
                Wo genau?
                <input
                  name="veranstaltungsort"
                  maxlength="120"
                  list="plaetze-bearbeiten"
                  value={werte.veranstaltungsort}
                />
              </label>
            </>
          </div>
          <label>
            Google-Maps-Link zu „Wo genau?“ (optional)
            <input
              name="standort"
              data-kartenlink-name="veranstaltungsort"
              maxlength="2000"
              inputmode="url"
              placeholder="Link aus Google Maps „Teilen“ oder „50.87, 10.82“"
              value={standort}
            />
          </label>
          {hinterlegt && (
            <p class="klein leise">
              „{werte.veranstaltungsort}“ ist auf der Karte hinterlegt – die Route führt genau
              dorthin. Ein neuer Link ersetzt die Position.
            </p>
          )}
          <p class="klein leise">
            Der Link gilt für alle Termine in {t.ort.name} mit gleichem „Wo genau?“. Alle Plätze
            verwalten:{' '}
            <a href={`/admin/termine?ort=${t.ort.slug}&plaetze=1#plaetze`}>
              Plätze in {t.ort.name}
            </a>
          </p>
          <label>
            Art
            <select name="kategorie">
              {Object.entries(KATEGORIEN).map(([k, info]) => (
                <option value={k} selected={werte.kategorie === k}>
                  {info.label}
                </option>
              ))}
            </select>
          </label>
          <label>
            Hinweise (öffentlich)
            <textarea name="info" maxlength="500" rows="3" set:text={werte.info} />
          </label>
          <label>
            <input type="checkbox" name="muttizettel" checked={werte.muttizettel} /> Unter 18 nur
            mit Muttizettel
          </label>
          <label>
            <input type="checkbox" name="bestaetigt" checked={werte.bestaetigt} /> Vom Veranstalter
            bestätigt
          </label>
          <fieldset class="mittagstisch">
            <>
              <legend>Essen & Getränke (freiwillig)</legend>
              <label>
                <input type="checkbox" name="essen" checked={essen} /> Essen & Getränke anbieten
              </label>
            </>
            <div class="speisen-felder">
              <p class="klein leise">
                Leere Zeilen werden ignoriert. Zum Entfernen Name und Preis leeren oder den Haken
                entfernen.
              </p>
              {Array.from({ length: gerichte }, (_, i) => (
                <div class="zwei">
                  <label>
                    Essen/Getränk {i + 1}
                    <input name="speise" maxlength="120" value={speisen[i]?.name ?? ''} />
                  </label>
                  <label>
                    Preis (€)
                    <input
                      name="preis"
                      inputmode="decimal"
                      maxlength="20"
                      value={speisen[i]?.preis ?? ''}
                    />
                  </label>
                </div>
              ))}
              {gerichte < 20 && (
                <button class="knopf zweit" name="aktion" value="gericht" formnovalidate>
                  + Weiterer Eintrag
                </button>
              )}
            </div>
          </fieldset>
          <div class="knopfreihe">
            <>
              <button class="knopf" name="aktion" value="speichern">
                Alle Änderungen speichern
              </button>
              <a href={listenLink}>Abbrechen</a>
            </>
          </div>
        </form>
        <datalist id="bands-bearbeiten">
          {(v.daten?.bands ?? []).map((b) => (
            <option value={b} />
          ))}
        </datalist>
        <datalist id="titel-bearbeiten">
          {(v.daten?.titel ?? []).map((t) => (
            <option value={t} />
          ))}
        </datalist>
        <datalist id="plaetze-bearbeiten">
          {[
            ...new Set([
              ...(plaetze?.daten?.festplaetze ?? []).map((p) => p.name),
              ...(plaetze?.daten?.veranstaltungsorte ?? []),
            ]),
          ].map((p) => (
            <option value={p} />
          ))}
        </datalist>
      </>
    )
  }
</AdminLayout>
<style>
  .mittagstisch {
    min-width: 0;
    border: 1px solid var(--linie);
    border-radius: var(--r);
    padding: 16px;
    display: grid;
    gap: 12px;
  }
  .speisen-felder {
    display: grid;
    gap: 12px;
  }
  /* ohne Haken keine Felder – auch ohne JavaScript (Issue #155) */
  .mittagstisch:not(:has(input[name='essen']:checked)) .speisen-felder {
    display: none;
  }
  .knopfreihe {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
  }
</style>
