---
import AdminLayout from '../../../../components/admin/AdminLayout.astro';
import CsrfFeld from '../../../../components/admin/CsrfFeld.astro';
import { adminApi, feld } from '../../../../lib/admin';
import type { TerminDto } from '../../../../lib/api';
import { datumLangJahr } from '../../../../lib/anzeige';
const t = (
  await adminApi<TerminDto>(
    Astro.cookies,
    'GET',
    `termine/${encodeURIComponent(Astro.params.id ?? '')}`,
  )
).daten;
let version = t?.version ?? '';
const aktion = Astro.url.searchParams.get('aktion');
const loeschen = aktion === 'loeschen';
const gueltig = t && (loeschen || aktion === 'bestaetigen');
let fehler: string[] = [];
if (!gueltig) Astro.response.status = 404;
if (Astro.request.method === 'POST' && gueltig) {
  const f = await Astro.request.formData();
  version = feld(f, 'version');
  if (feld(f, 'rueckfrage') !== 'ja') {
    fehler = ['Bitte die Rückfrage bestätigen.'];
    Astro.response.status = 400;
  } else {
    const r = loeschen
      ? await adminApi(
          Astro.cookies,
          'DELETE',
          `termine/${t.id}?ort=${encodeURIComponent(t.ort.slug)}&version=${encodeURIComponent(version)}`,
        )
      : await adminApi(Astro.cookies, 'POST', `termine/${t.id}/bestaetigen`, {
          ortSlug: t.ort.slug,
          version,
        });
    if (r.status < 300)
      return Astro.redirect(`/admin?${loeschen ? 'geloescht' : 'bestaetigt'}=1`, 303);
    fehler = r.fehler;
    Astro.response.status = r.status;
  }
}
---

<AdminLayout
  titel={!gueltig
    ? 'Termin nicht gefunden'
    : loeschen
      ? 'Termin wirklich löschen?'
      : 'Termin bestätigen?'}
  fehler={fehler}
>
  {
    gueltig && (
      <form class="melden" method="post">
        <CsrfFeld />
        <input type="hidden" name="version" value={version} />
        <p>
          <strong>{t.titel}</strong>
        </p>
        <p>
          <br />
          {t.ort.name} · {datumLangJahr(t.datum)}
          {t.beginn && ` · ${t.beginn} Uhr`}
        </p>
        <p>
          {loeschen
            ? 'Der Termin und sein Mittagstisch werden aus dem Kalender entfernt.'
            : 'Bitte nur bestätigen, wenn die Angaben vom Veranstalter bestätigt wurden.'}
        </p>
        <label>
          <input type="checkbox" required name="rueckfrage" value="ja" />
          {loeschen ? 'Ja, diesen Termin löschen.' : 'Ja, vom Veranstalter bestätigt.'}
        </label>
        <div class="knopfreihe">
          <>
            <button class:list={['knopf', { gefahr: loeschen }]}>
              {loeschen ? 'Jetzt löschen' : 'Jetzt bestätigen'}
            </button>
            <a href="/admin">Abbrechen</a>
          </>
        </div>
      </form>
    )
  }
</AdminLayout>
<style>
  .knopfreihe {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
  }
</style>
