---
/**
 * Termine aller Orte verwalten. Ohne ?ort= wird ein Ort gesucht; mit ?ort=<slug> werden dessen Termine
 * gezeigt und können angelegt, geändert, bestätigt und gelöscht werden. ?bearbeiten=<id> füllt das Formular.
 */
if (Astro.url.searchParams.get('modus') === 'wochenende')
  return Astro.redirect(
    `/admin/kirmes-eintragen?ort=${encodeURIComponent(Astro.url.searchParams.get('ort') ?? '')}`,
    303,
  );
if (Astro.request.method === 'GET' && Astro.url.searchParams.get('bearbeiten'))
  return Astro.redirect(
    `/admin/termine/${encodeURIComponent(Astro.url.searchParams.get('bearbeiten') ?? '')}`,
    303,
  );
import AdminLayout from '../../components/admin/AdminLayout.astro';
import CsrfFeld from '../../components/admin/CsrfFeld.astro';
import Icon from '../../components/Icon.astro';
import { adminApi, feld } from '../../lib/admin';
import { alleTermine, findeOrt, findeTermin, listeOrte, type TerminDto } from '../../lib/api';
import {
  KATEGORIEN,
  datumLangJahr,
  heute,
  kreisKurz,
  plusTage,
  tagMonat,
  wochentag,
} from '../../lib/anzeige';
import { wochenendVorlage, type WochenendZeile } from '../../lib/wochenende';
import type { Kategorie } from '@kirmes/core';

const istKategorie = (k: string): k is Kategorie => k in KATEGORIEN;

const p = Astro.url.searchParams;
const ortSlug = p.get('ort') ?? '';
const ort = ortSlug ? await findeOrt(ortSlug) : null;
const wochenendModus = p.get('modus') === 'wochenende';
/** Alle Termine des Ortes auf einmal bearbeiten (Issue #65) */
const alleModus = p.get('modus') === 'alle';
const ab = /^\d{4}-\d{2}-\d{2}$/.test(p.get('ab') ?? '') ? p.get('ab')! : null;

let meldung: string | null = null;
let fehler: string[] = [];
/** Eingaben des Wochenend-Formulars – bleiben bei Fehlern stehen, nichts muss neu getippt werden. */
let zeilen: WochenendZeile[] = ab ? wochenendVorlage(ab) : [];
let wochenendBestaetigt = false;
if (Astro.request.method === 'POST' && ort) {
  const f = await Astro.request.formData();
  const aktion = feld(f, 'aktion');
  const id = feld(f, 'id');
  if (aktion === 'loeschen' || aktion === 'bestaetigen')
    return Astro.redirect(`/admin/termine/${encodeURIComponent(id)}/aktion?aktion=${aktion}`, 303);
  const formular = {
    ortSlug: ort.slug,
    datum: feld(f, 'datum'),
    beginn: feld(f, 'beginn') || null,
    titel: feld(f, 'titel'),
    veranstaltungsort: feld(f, 'veranstaltungsort') || null,
    kategorie: feld(f, 'kategorie') || null,
    bestaetigt: f.get('bestaetigt') === 'ja',
    band: feld(f, 'band') || null,
    info: feld(f, 'info') || null,
    muttizettel: f.get('muttizettel') === 'ja',
  };
  if (aktion === 'speisen') {
    const namen = f.getAll('sp-name').map((v) => (typeof v === 'string' ? v : ''));
    const preise = f.getAll('sp-preis').map((v) => (typeof v === 'string' ? v : ''));
    const rsp = await adminApi(Astro.cookies, 'PUT', `termine/${encodeURIComponent(id)}/speisen`, {
      ortSlug: ort.slug,
      speisen: namen.map((name, i) => ({ name, preis: preise[i] ?? '' })),
    });
    if (rsp.status < 300) meldung = 'Mittagstisch gespeichert.';
    else fehler = rsp.fehler;
  }
  if (aktion === 'sammel') {
    const werte = (n: string) => f.getAll(n).map((v) => (typeof v === 'string' ? v.trim() : ''));
    // Checkboxen senden nur angehakte Werte – jede trägt ihre Zeilennummer
    const angehakt = (n: string) => new Set(werte(n));
    const [ids, datum, beginn, titel, kat, band, vo, info] = [
      's-id',
      's-datum',
      's-beginn',
      's-titel',
      's-kat',
      's-band',
      's-vo',
      's-info',
    ].map(werte);
    const [mutti, best, weg] = ['s-mutti', 's-best', 's-loeschen'].map(angehakt);
    const zeilenSammel = ids!.map((id, i) => ({
      id,
      datum: datum![i] ?? '',
      beginn: beginn![i] || null,
      titel: titel![i] ?? '',
      kategorie: istKategorie(kat![i] ?? '') ? kat![i] : null,
      band: band![i] || null,
      veranstaltungsort: vo![i] || null,
      info: info![i] || null,
      muttizettel: mutti!.has(String(i)),
      bestaetigt: best!.has(String(i)),
      loeschen: weg!.has(String(i)),
    }));
    const rs = await adminApi<{ hinweise: { meldung: string }[] }>(
      Astro.cookies,
      'POST',
      'termine/sammel',
      { ortSlug: ort.slug, zeilen: zeilenSammel },
    );
    if (rs.status < 300) {
      const geloescht = zeilenSammel.filter((z) => z.loeschen).length;
      meldung = [
        `Alle Änderungen gespeichert${geloescht ? ` (${geloescht} gelöscht)` : ''}.`,
        ...(rs.daten?.hinweise ?? []).map((h) => h.meldung),
      ].join(' ');
    } else fehler = rs.fehler;
  }
  if (aktion === 'platz' || aktion === 'platz-loeschen') {
    const r =
      aktion === 'platz'
        ? await adminApi(Astro.cookies, 'POST', `orte/${ort.slug}/festplaetze`, {
            name: feld(f, 'platzname'),
            standort: feld(f, 'standort'),
          })
        : await adminApi(
            Astro.cookies,
            'DELETE',
            `orte/${ort.slug}/festplaetze?name=${encodeURIComponent(feld(f, 'platzname'))}`,
          );
    if (r.status < 300) {
      meldung =
        aktion === 'platz'
          ? `Platz „${feld(f, 'platzname') || 'Hauptfestplatz'}“ gespeichert – Termine mit diesem Veranstaltungsort führen jetzt genau dorthin.`
          : 'Platz gelöscht.';
    } else fehler = r.fehler;
  }
  const spalte = (name: string) =>
    f.getAll(name).map((v) => (typeof v === 'string' ? v.trim() : ''));
  if (aktion === 'wochenende') {
    const titel = spalte('z-titel');
    // Checkboxen senden nur angehakte Werte – daher trägt jede ihre Zeilennummer
    const mutti = new Set(spalte('z-mutti'));
    const [datum, beginn, band, vo, info, kat] = [
      'z-datum',
      'z-beginn',
      'z-band',
      'z-vo',
      'z-info',
      'z-kat',
    ].map(spalte);
    zeilen = titel.map((t, i) => ({
      datum: datum![i] ?? '',
      beginn: beginn![i] ?? '',
      titel: t,
      kategorie: istKategorie(kat![i] ?? '') ? (kat![i] as Kategorie) : '',
      band: band![i] ?? '',
      veranstaltungsort: vo![i] ?? '',
      info: info![i] ?? '',
      muttizettel: mutti.has(String(i)),
    }));
    wochenendBestaetigt = f.get('bestaetigt') === 'ja';
  }
  // Zeilen ohne Veranstaltung bleiben leer und werden nicht gespeichert
  const gefuellt = zeilen.filter((z) => z.titel);
  const r =
    aktion === 'platz' || aktion === 'platz-loeschen' || aktion === 'sammel' || aktion === 'speisen'
      ? { status: 299, daten: null, fehler: fehler }
      : aktion === 'wochenende'
        ? gefuellt.length === 0
          ? { status: 400, daten: null, fehler: ['Bitte mindestens eine Veranstaltung eintragen.'] }
          : await adminApi<{ hinweise: { meldung: string }[] }>(
              Astro.cookies,
              'POST',
              'termine/wochenende',
              {
                ortSlug: ort.slug,
                zeilen: gefuellt.map((z) => ({
                  datum: z.datum,
                  beginn: z.beginn || null,
                  titel: z.titel,
                  kategorie: z.kategorie || null,
                  veranstaltungsort: z.veranstaltungsort || null,
                  band: z.band || null,
                  info: z.info || null,
                  muttizettel: z.muttizettel,
                  bestaetigt: wochenendBestaetigt,
                })),
              },
            )
        : aktion === 'speichern' && id
          ? await adminApi<{ hinweise: { meldung: string }[] }>(
              Astro.cookies,
              'PUT',
              `termine/${encodeURIComponent(id)}`,
              formular,
            )
          : aktion === 'speichern'
            ? await adminApi<{ hinweise: { meldung: string }[] }>(
                Astro.cookies,
                'POST',
                'termine',
                formular,
              )
            : aktion === 'bestaetigen'
              ? await adminApi(
                  Astro.cookies,
                  'POST',
                  `termine/${encodeURIComponent(id)}/bestaetigen`,
                  {
                    ortSlug: ort.slug,
                  },
                )
              : aktion === 'loeschen'
                ? await adminApi(
                    Astro.cookies,
                    'DELETE',
                    `termine/${encodeURIComponent(id)}?ort=${encodeURIComponent(ort.slug)}`,
                  )
                : { status: 400, daten: null, fehler: ['Unbekannte Aktion.'] };
  if (r.status === 299) {
    // Platz-Aktion: Meldung/Fehler oben schon gesetzt
  } else if (r.status < 300) {
    const hinweise = (r.daten as { hinweise?: { meldung: string }[] } | null)?.hinweise ?? [];
    meldung = [
      {
        wochenende: `${gefuellt.length} Veranstaltungen gespeichert.`,
        speichern: 'Termin gespeichert.',
        bestaetigen: 'Termin bestätigt.',
        loeschen: 'Termin gelöscht.',
      }[aktion],
      ...hinweise.map((h) => h.meldung),
    ].join(' ');
    if (aktion === 'wochenende') zeilen = [];
  } else fehler = r.fehler;
}
// Fehler nennen die Zeile („Zeile 3: …“) – bezogen auf die gefüllten Zeilen
const gefuellteNr = zeilen.map((z, i) => (z.titel ? i : -1)).filter((i) => i >= 0);
const fehlerhaft = new Set(
  fehler
    .map((m) => /^Zeile (\d+):/.exec(m)?.[1])
    .filter(Boolean)
    .map((n) => gefuellteNr[Number(n) - 1]),
);
const leereZeilen = zeilen.length ? Math.max(2, 8 - zeilen.length) : 0;

const h = heute();
const termine: TerminDto[] = ort
  ? // Zwei Abfragen (max. 366 Tage je Abfrage): auch die Kirmes im nächsten Jahr ist bearbeitbar
    [
      ...(await alleTermine({ ort: ort.slug, von: plusTage(h, -30), bis: plusTage(h, 335) })),
      ...(await alleTermine({ ort: ort.slug, von: plusTage(h, 336), bis: plusTage(h, 700) })),
    ]
  : [];
const bearbeiten = p.get('bearbeiten') && ort ? await findeTermin(p.get('bearbeiten')!) : null;
const zuBearbeiten = bearbeiten && bearbeiten.ort.slug === ort?.slug ? bearbeiten : null;

const suche = p.get('suche')?.trim().toLowerCase() ?? '';
const treffer =
  !ort && suche
    ? (await listeOrte()).filter((o) => o.name.toLowerCase().includes(suche)).slice(0, 30)
    : [];
// Plätze des Ortes (Kirche, Festzelt …) mit Standort – Issue #62
interface Platz {
  name: string;
  koordinate: { lat: number; lon: number };
}
const plaetze = ort
  ? ((
      await adminApi<{ festplaetze: Platz[] }>(Astro.cookies, 'GET', `orte/${ort.slug}/festplaetze`)
    ).daten?.festplaetze ?? [])
  : [];
const googleSuche = ort
  ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${ort.name}, Thüringen`)}`
  : '';
const veranstaltungsorte = [
  ...new Set([
    ...plaetze.map((p) => p.name).filter(Boolean),
    ...termine.map((t) => t.veranstaltungsort).filter(Boolean),
  ]),
];
// Vorschläge aus ALLEN bisherigen Terminen (Bands/DJs spielen oft mehrfach) – nichts doppelt tippen
const vorschlaege = (
  await adminApi<{ bands: string[]; titel: string[] }>(Astro.cookies, 'GET', 'vorschlaege')
).daten ?? { bands: [], titel: [] };
const bands = [...new Set([...termine.map((t) => t.band).filter(Boolean), ...vorschlaege.bands])];
const titelVorschlaege = [
  ...new Set([...zeilen.map((z) => z.titel).filter(Boolean), ...vorschlaege.titel]),
];
---

<AdminLayout titel={ort ? `Termine in ${ort.name}` : 'Termine'} meldung={meldung} fehler={fehler}>
  {
    !ort && (
      <>
        <h2>Für welchen Ort?</h2>
        <form class="suchzeile" method="get">
          <input
            type="search"
            name="suche"
            value={suche}
            placeholder="Ortsname, z. B. Mühlberg"
            aria-label="Ortsname"
            autofocus
          />
          <button class="knopf" type="submit">
            <Icon name="suche" />
            Suchen
          </button>
        </form>
        {suche && (
          <table class="admin-tabelle">
            <tbody>
              {treffer.length === 0 && (
                <tr>
                  <td>
                    Kein Ort gefunden. <a href="/admin/orte">Ort anlegen</a>
                  </td>
                </tr>
              )}
              {treffer.map((o) => (
                <tr>
                  <td>
                    <a href={`/admin/termine?ort=${o.slug}`}>{o.name}</a>{' '}
                    <span class="leise klein">({kreisKurz(o.landkreis)})</span>
                  </td>
                  <td class="klein">{o.anzahlKommend} kommende Termine</td>
                </tr>
              ))}
            </tbody>
          </table>
        )}
      </>
    )
  }

  {
    ortSlug && !ort && (
      <p class="meldung">
        Ort „{ortSlug}“ nicht gefunden. <a href="/admin/termine">Neu suchen</a>
      </p>
    )
  }

  {
    ort && (
      <>
        <p class="brotkrumen">
          <a href="/admin/termine">Anderen Ort wählen</a> ·{' '}
          <a href={`/orte/${ort.slug}`}>Öffentliche Ortsseite</a> ·{' '}
          <a href={`/admin/links?ort=${ort.slug}`}>Link für die Kirmesgesellschaft</a>
        </p>

        <details class="filter plaetze" open={plaetze.length === 0}>
          <summary>
            <Icon name="route" />
            Plätze in {ort.name} ({plaetze.length}) – für die genaue Route
          </summary>
          <p class="leise klein">
            Einmal pro Ort anlegen, z. B. „Kirche“, „Festzelt“, „Kulturhaus“. Termine, deren „Wo
            genau?“ gleich heißt, führen dann per „Route“ genau dorthin. Ein Platz ohne Namen gilt
            für alle übrigen Termine des Ortes.
          </p>
          {plaetze.length > 0 && (
            <table class="admin-tabelle">
              <tbody>
                {plaetze.map((pl) => (
                  <tr>
                    <td>
                      <strong>{pl.name || 'Hauptfestplatz'}</strong>
                    </td>
                    <td class="klein">
                      <a
                        href={`https://www.google.com/maps/search/?api=1&query=${pl.koordinate.lat},${pl.koordinate.lon}`}
                        target="_blank"
                        rel="noopener"
                      >
                        In Google Maps prüfen
                      </a>
                    </td>
                    <td>
                      <form method="post">
                        <CsrfFeld />
                        <input type="hidden" name="aktion" value="platz-loeschen" />
                        <input type="hidden" name="platzname" value={pl.name} />
                        <button class="knopf zweit" type="submit">
                          Löschen
                        </button>
                      </form>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          )}
          <form class="melden" method="post">
            <CsrfFeld />
            <input type="hidden" name="aktion" value="platz" />
            <div class="zwei">
              <label>
                Name des Platzes
                <input
                  name="platzname"
                  maxlength="120"
                  list="vo-liste"
                  placeholder="z. B. Kirche – leer = Hauptfestplatz"
                />
              </label>
              <label>
                Standort aus Google Maps *
                <input
                  name="standort"
                  required
                  maxlength="2000"
                  placeholder="https://maps.app.goo.gl/… oder 50.8475, 11.0412"
                />
              </label>
            </div>
            <p class="leise klein">
              So geht's:{' '}
              <a href={googleSuche} target="_blank" rel="noopener">
                {ort.name} in Google Maps öffnen
              </a>
              , lange auf die Stelle tippen (Pin setzen), „Teilen“ → „Link kopieren“, hier einfügen.
            </p>
            <div>
              <button class="knopf zweit" type="submit">
                Platz speichern
              </button>
            </div>
          </form>
        </details>

        {!zuBearbeiten && (
          <nav class="umschalter" aria-label="Art der Eingabe">
            <a
              href={`/admin/termine?ort=${ort.slug}`}
              aria-current={!wochenendModus && !alleModus && 'page'}
            >
              Einzelner Termin
            </a>
            <a
              href={`/admin/termine?ort=${ort.slug}&modus=wochenende`}
              aria-current={wochenendModus && 'page'}
            >
              Ganzes Kirmeswochenende
            </a>
            {termine.length > 0 && (
              <a
                href={`/admin/termine?ort=${ort.slug}&modus=alle`}
                aria-current={alleModus && 'page'}
              >
                Alle Termine bearbeiten
              </a>
            )}
          </nav>
        )}

        {alleModus && !zuBearbeiten && (
          <section aria-labelledby="alle-kopf">
            <h2 id="alle-kopf">Alle Termine in {ort.name} bearbeiten</h2>
            {termine.length === 0 ? (
              <p class="leer">Noch keine Termine.</p>
            ) : (
              <form class="melden wochenende" method="post" id="alle">
                <CsrfFeld />
                <input type="hidden" name="aktion" value="sammel" />
                <p class="leise klein">
                  Jedes Feld lässt sich direkt ändern. „Löschen“ anhaken, um einen Termin zu
                  entfernen. Gespeichert wird alles zusammen – oder bei einem Fehler gar nichts.
                </p>
                <ol class="we-zeilen">
                  {termine.map((t, i) => (
                    <li class="we-zeile">
                      <input type="hidden" name="s-id" value={t.id} />
                      <div class="we-zeit">
                        <label>
                          Datum
                          <input name="s-datum" type="date" required value={t.datum} />
                        </label>
                        <label>
                          Beginn
                          <input name="s-beginn" type="time" value={t.beginn ?? ''} />
                        </label>
                        <span class="we-tag leise klein" aria-hidden="true">
                          {wochentag(t.datum)}, {tagMonat(t.datum)}
                        </span>
                      </div>
                      <div class="zwei">
                        <label>
                          Veranstaltung
                          <input
                            name="s-titel"
                            required
                            maxlength="200"
                            list="titel-liste"
                            value={t.titel}
                          />
                        </label>
                        <label>
                          Art
                          <select name="s-kat">
                            {Object.entries(KATEGORIEN).map(([k, v]) => (
                              <option value={k} selected={t.kategorie === k}>
                                {v.label}
                              </option>
                            ))}
                          </select>
                        </label>
                      </div>
                      <div class="zwei">
                        <label>
                          Band / DJ
                          <input
                            name="s-band"
                            maxlength="120"
                            list="band-liste"
                            value={t.band ?? ''}
                          />
                        </label>
                        <label>
                          Wo genau?
                          <input
                            name="s-vo"
                            maxlength="120"
                            list="vo-liste"
                            value={t.veranstaltungsort ?? ''}
                          />
                        </label>
                      </div>
                      <label>
                        Hinweise (öffentlich)
                        <textarea name="s-info" maxlength="500" rows="2" set:text={t.info ?? ''} />
                      </label>
                      <div class="haekchen">
                        <label class="klein">
                          <input
                            type="checkbox"
                            name="s-mutti"
                            value={String(i)}
                            checked={t.muttizettel}
                          />{' '}
                          Muttizettel
                        </label>
                        <label class="klein">
                          <input
                            type="checkbox"
                            name="s-best"
                            value={String(i)}
                            checked={t.bestaetigt}
                          />{' '}
                          Vom Veranstalter bestätigt
                        </label>
                        <a
                          class="klein"
                          href={`/admin/termine?ort=${ort.slug}&bearbeiten=${t.id}#mittagstisch`}
                        >
                          Mittagstisch
                        </a>
                        <label class="klein loeschen">
                          <input type="checkbox" name="s-loeschen" value={String(i)} /> Löschen
                        </label>
                      </div>
                    </li>
                  ))}
                </ol>
                <div class="knopfreihe">
                  <button class="knopf" type="submit">
                    Alle Änderungen speichern
                  </button>
                  <a class="knopf zweit" href={`/admin/termine?ort=${ort.slug}`}>
                    Abbrechen
                  </a>
                </div>
              </form>
            )}
          </section>
        )}

        {wochenendModus && !zuBearbeiten && (
          <section aria-labelledby="we-kopf">
            <h2 id="we-kopf">Kirmeswochenende anlegen</h2>
            <form class="suchzeile" method="get">
              <input type="hidden" name="ort" value={ort.slug} />
              <input type="hidden" name="modus" value="wochenende" />
              <label class="klein">
                Erster Kirmestag (meist Freitag)
                <input type="date" name="ab" required value={ab ?? ''} />
              </label>
              <button class="knopf zweit" type="submit">
                {zeilen.length ? 'Vorlage neu laden' : 'Vorlage laden'}
              </button>
            </form>
            {zeilen.length > 0 && (
              <form class="melden wochenende" method="post" id="wochenende">
                <CsrfFeld />
                <input type="hidden" name="aktion" value="wochenende" />
                <p class="leise klein">
                  Jede Zeile ist eine Veranstaltung – mehrere pro Tag sind möglich. Zeilen ohne
                  Veranstaltung werden ignoriert. Gespeichert wird alles zusammen oder gar nichts.
                </p>
                <ol class="we-zeilen">
                  {[...zeilen, ...Array.from({ length: leereZeilen }, () => null)].map((z, i) => (
                    <li class:list={['we-zeile', { fehlerhaft: fehlerhaft.has(i) }]}>
                      <div class="we-zeit">
                        <label>
                          Datum
                          <input name="z-datum" type="date" value={z?.datum ?? ''} />
                        </label>
                        <label>
                          Beginn
                          <input name="z-beginn" type="time" value={z?.beginn ?? ''} />
                        </label>
                        {z?.datum && (
                          <span class="we-tag leise klein" aria-hidden="true">
                            {wochentag(z.datum)}, {tagMonat(z.datum)}
                          </span>
                        )}
                      </div>
                      <div class="zwei">
                        <label>
                          Veranstaltung
                          <input
                            name="z-titel"
                            list="titel-liste"
                            maxlength="200"
                            value={z?.titel ?? ''}
                            placeholder="z. B. Kirmestanz"
                          />
                        </label>
                        <label>
                          Art
                          <select name="z-kat">
                            <option value="">automatisch erkennen</option>
                            {Object.entries(KATEGORIEN).map(([k, v]) => (
                              <option value={k} selected={z?.kategorie === k}>
                                {v.label}
                              </option>
                            ))}
                          </select>
                        </label>
                      </div>
                      <div class="zwei">
                        <label>
                          Band / DJ
                          <input
                            name="z-band"
                            maxlength="120"
                            list="band-liste"
                            value={z?.band ?? ''}
                          />
                        </label>
                        <label>
                          Wo genau?
                          <input
                            name="z-vo"
                            maxlength="120"
                            list="vo-liste"
                            value={z?.veranstaltungsort ?? ''}
                          />
                        </label>
                      </div>
                      <label>
                        Hinweise (öffentlich)
                        <textarea name="z-info" maxlength="500" rows="2" set:text={z?.info ?? ''} />
                      </label>
                      <label class="klein">
                        <input
                          type="checkbox"
                          name="z-mutti"
                          value={String(i)}
                          checked={z?.muttizettel ?? false}
                        />{' '}
                        Unter 18 nur mit Muttizettel
                      </label>
                    </li>
                  ))}
                </ol>
                <label class="klein">
                  <input
                    type="checkbox"
                    name="bestaetigt"
                    value="ja"
                    checked={wochenendBestaetigt}
                  />{' '}
                  Vom Veranstalter bestätigt (gilt für alle Veranstaltungen)
                </label>
                <div class="knopfreihe">
                  <button class="knopf" type="submit">
                    Ganzes Wochenende speichern
                  </button>
                </div>
              </form>
            )}
          </section>
        )}

        {!wochenendModus && !alleModus && (
          <h2>{zuBearbeiten ? 'Termin ändern' : 'Neuer Termin'}</h2>
        )}
        {!wochenendModus && !alleModus && (
          <details class="filter" open={!zuBearbeiten}>
            <summary>
              <Icon name="suche" />
              Recherche-Assistent: Text aus Instagram, Facebook oder Amtsblatt einfügen
            </summary>
            <div class="filterfelder">
              <textarea
                id="assistent"
                rows="5"
                placeholder="Text der Ankündigung hier einfügen – Datum, Uhrzeit, Titel und Ort werden vorgeschlagen."
              />
              <p class="leise klein" id="assistent-info">
                Die Vorschläge landen im Formular – bitte prüfen. Quelle (Link zum Post) in der
                Recherche notieren.
              </p>
            </div>
          </details>
        )}

        {!wochenendModus && !alleModus && (
          <form class="melden" method="post" id="terminformular">
            <CsrfFeld />
            <input type="hidden" name="aktion" value="speichern" />
            {zuBearbeiten && <input type="hidden" name="id" value={zuBearbeiten.id} />}
            <div class="zwei">
              <label>
                Datum *<input name="datum" type="date" required value={zuBearbeiten?.datum ?? ''} />
              </label>
              <label>
                Beginn
                <input name="beginn" type="time" value={zuBearbeiten?.beginn ?? ''} />
              </label>
            </div>
            <label>
              Veranstaltung *
              <input
                name="titel"
                required
                maxlength="200"
                list="titel-liste"
                value={zuBearbeiten?.titel ?? ''}
              />
            </label>
            <div class="zwei">
              <label>
                Wo genau?
                <input
                  name="veranstaltungsort"
                  maxlength="120"
                  list="vo-liste"
                  value={zuBearbeiten?.veranstaltungsort ?? ''}
                />
              </label>
              <label>
                Art
                <select name="kategorie">
                  <option value="">automatisch erkennen</option>
                  {Object.entries(KATEGORIEN).map(([k, v]) => (
                    <option value={k} selected={zuBearbeiten?.kategorie === k}>
                      {v.label}
                    </option>
                  ))}
                </select>
              </label>
            </div>
            <div class="zwei">
              <label>
                Band / DJ
                <input
                  name="band"
                  maxlength="120"
                  list="band-liste"
                  value={zuBearbeiten?.band ?? ''}
                />
              </label>
              <label>
                Hinweise (öffentlich)
                <textarea
                  name="info"
                  maxlength="500"
                  rows="2"
                  placeholder="z. B. Eintritt 8 €, Einlass ab 18"
                  set:text={zuBearbeiten?.info ?? ''}
                />
              </label>
            </div>
            <datalist id="vo-liste">
              {veranstaltungsorte.map((v) => (
                <option value={v!} />
              ))}
            </datalist>
            <label class="klein">
              <input
                type="checkbox"
                name="bestaetigt"
                value="ja"
                checked={zuBearbeiten?.bestaetigt ?? false}
              />{' '}
              Vom Veranstalter bestätigt (z. B. eigener Post der Kirmesgesellschaft)
            </label>
            <label class="klein">
              <input
                type="checkbox"
                name="muttizettel"
                value="ja"
                checked={zuBearbeiten?.muttizettel ?? false}
              />{' '}
              Unter 18 nur mit Muttizettel (Vorlage wird am Termin angeboten)
            </label>
            <div class="knopfreihe">
              <button class="knopf" type="submit">
                Speichern
              </button>
              {zuBearbeiten && (
                <a class="knopf zweit" href={`/admin/termine?ort=${ort.slug}`}>
                  Abbrechen
                </a>
              )}
            </div>
          </form>
        )}
        {zuBearbeiten && !wochenendModus && !alleModus && (
          <section id="mittagstisch" aria-labelledby="mt-kopf">
            <h2 id="mt-kopf">Mittagstisch</h2>
            <p class="leise klein">
              Z. B. beim Frühschoppen: Gericht und Preis. Leere Zeilen werden ignoriert; ohne
              Gerichte erscheint nichts auf der Terminseite.
            </p>
            <form class="melden" method="post">
              <CsrfFeld />
              <input type="hidden" name="aktion" value="speisen" />
              <input type="hidden" name="id" value={zuBearbeiten.id} />
              <ol class="speisen-zeilen">
                {[
                  ...(zuBearbeiten.speisen ?? []),
                  ...Array.from(
                    { length: Math.max(3, 6 - (zuBearbeiten.speisen?.length ?? 0)) },
                    () => null,
                  ),
                ].map((sp, i) => (
                  <li class="zwei">
                    <label>
                      Gericht {i + 1}
                      <input
                        name="sp-name"
                        maxlength="120"
                        list="speisen-liste"
                        value={sp?.name ?? ''}
                        placeholder={i === 0 ? 'z. B. Rostbrätel mit Brot' : ''}
                      />
                    </label>
                    <label>
                      Preis (€)
                      <input
                        name="sp-preis"
                        inputmode="decimal"
                        maxlength="10"
                        value={
                          sp?.preisCent != null
                            ? (sp.preisCent / 100).toFixed(2).replace('.', ',')
                            : ''
                        }
                        placeholder="7,50"
                      />
                    </label>
                  </li>
                ))}
              </ol>
              <datalist id="speisen-liste">
                {[
                  'Rostbrätel mit Brot',
                  'Thüringer Rostbratwurst',
                  'Klöße mit Rouladen und Rotkraut',
                  'Schnitzel mit Kartoffelsalat',
                  'Erbsensuppe',
                  'Kaffee und Kuchen',
                ].map((v) => (
                  <option value={v} />
                ))}
              </datalist>
              <div>
                <button class="knopf" type="submit">
                  Mittagstisch speichern
                </button>
              </div>
            </form>
          </section>
        )}
        {(wochenendModus || alleModus) && (
          <datalist id="vo-liste">
            {veranstaltungsorte.map((v) => (
              <option value={v!} />
            ))}
          </datalist>
        )}

        <datalist id="band-liste">
          {bands.map((b) => (
            <option value={b!} />
          ))}
        </datalist>
        <datalist id="titel-liste">
          {titelVorschlaege.map((t) => (
            <option value={t} />
          ))}
        </datalist>

        <h2>Termine in {ort.name}</h2>
        {termine.length === 0 ? (
          <p class="leer">Noch keine Termine.</p>
        ) : (
          <table class="admin-tabelle">
            <tbody>
              {termine.map((t) => (
                <tr>
                  <td class="klein">
                    {datumLangJahr(t.datum)}
                    {t.beginn && <>, {t.beginn}</>}
                  </td>
                  <td>
                    <strong>{t.titel}</strong>
                    {(t.veranstaltungsort || t.band) && (
                      <div class="leise klein">
                        {[t.veranstaltungsort, t.band && `Musik: ${t.band}`]
                          .filter(Boolean)
                          .join(' · ')}
                      </div>
                    )}
                  </td>
                  <td class="klein">
                    {t.bestaetigt ? <span class="bestaetigt">bestätigt</span> : 'recherchiert'}
                  </td>
                  <td>
                    <div class="klein-knoepfe">
                      <a class="knopf zweit" href={`/admin/termine/${t.id}`}>
                        Ändern
                      </a>
                      <form method="post">
                        <CsrfFeld />
                        <input type="hidden" name="id" value={t.id} />
                        {!t.bestaetigt && (
                          <button class="knopf zweit" name="aktion" value="bestaetigen">
                            Bestätigen
                          </button>
                        )}
                        <button class="knopf zweit" name="aktion" value="loeschen">
                          Löschen
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        )}
      </>
    )
  }
</AdminLayout>

<script>
  import { erkenneTerminAusText } from '@kirmes/core';

  const feld = document.getElementById('assistent') as HTMLTextAreaElement | null;
  const formular = document.getElementById('terminformular') as HTMLFormElement | null;
  const info = document.getElementById('assistent-info');
  if (feld && formular && info) {
    const setze = (name: string, wert: string | null) => {
      const el = formular.elements.namedItem(name) as HTMLInputElement | null;
      if (el && wert) el.value = wert;
    };
    feld.addEventListener('input', () => {
      const heute = new Intl.DateTimeFormat('en-CA', { timeZone: 'Europe/Berlin' }).format(
        new Date(),
      );
      const v = erkenneTerminAusText(feld.value, heute);
      setze('datum', v.datum);
      setze('beginn', v.beginn);
      setze('titel', v.titel);
      setze('veranstaltungsort', v.veranstaltungsort);
      const gefunden = [
        v.datum && 'Datum',
        v.beginn && 'Uhrzeit',
        v.titel && 'Titel',
        v.veranstaltungsort && 'Ort',
      ].filter(Boolean);
      info.textContent = gefunden.length
        ? `Erkannt: ${gefunden.join(', ')} – bitte im Formular prüfen.`
        : 'Nichts erkannt – bitte Felder von Hand ausfüllen.';
    });
  }
</script>
