---
import { darf } from '@kirmes/core';
/**
 * Termine aller Orte verwalten. Ohne ?ort= wird ein Ort gesucht; mit ?ort=<slug> werden dessen Termine
 * gezeigt und können angelegt, gesammelt geändert, bestätigt und gelöscht werden. Einzelne Termine
 * bearbeitet /admin/termine/<id>, ganze Kirmes trägt /admin/kirmes-eintragen ein (Issue #94).
 */
if (Astro.url.searchParams.get('modus') === 'wochenende')
  return Astro.redirect(
    `/admin/kirmes-eintragen?ort=${encodeURIComponent(Astro.url.searchParams.get('ort') ?? '')}`,
    303,
  );
if (Astro.request.method === 'GET' && Astro.url.searchParams.get('bearbeiten'))
  return Astro.redirect(
    `/admin/termine/${encodeURIComponent(Astro.url.searchParams.get('bearbeiten') ?? '')}`,
    303,
  );
import AdminLayout from '../../components/admin/AdminLayout.astro';
import Herkunft from '../../components/admin/TerminHerkunft.astro';
import CsrfFeld from '../../components/admin/CsrfFeld.astro';
import Icon from '../../components/Icon.astro';
import KirmesSammel from '../../components/admin/KirmesSammel.astro';
import NeuerTermin from '../../components/admin/NeuerTermin.astro';
import OrtTerminliste from '../../components/admin/OrtTerminliste.astro';
import { adminApi, feld } from '../../lib/admin';
import { findeOrt, listeOrte, type TerminDto } from '../../lib/api';
import { KATEGORIEN, datumLangJahr, kreisKurz, tagMonat, wochentag } from '../../lib/anzeige';
import type { Kategorie, TerminHerkunft } from '@kirmes/core';

const istKategorie = (k: string): k is Kategorie => k in KATEGORIEN;

const p = Astro.url.searchParams;
const ortSlug = p.get('ort') ?? '';
const ort = ortSlug ? await findeOrt(ortSlug) : null;
/** Alle Termine des Ortes auf einmal bearbeiten (Issue #65) */
const alleModus = p.get('modus') === 'alle';

let meldung: string | null = null;
let einzelEingabe: Partial<TerminDto> | null = null;
let fehler: string[] = [];
const sammelEingaben = new Map<string, Partial<TerminDto> & { loeschen?: boolean }>();
if (Astro.request.method === 'POST' && ort) {
  const f = await Astro.request.formData();
  const aktion = feld(f, 'aktion');
  const id = feld(f, 'id');
  if (aktion === 'loeschen' || aktion === 'bestaetigen')
    return Astro.redirect(`/admin/termine/${encodeURIComponent(id)}/aktion?aktion=${aktion}`, 303);
  const formular = {
    ortSlug: ort.slug,
    version: feld(f, 'version'),
    datum: feld(f, 'datum'),
    beginn: feld(f, 'beginn') || null,
    titel: feld(f, 'titel'),
    veranstaltungsort: feld(f, 'veranstaltungsort') || null,
    kategorie: feld(f, 'kategorie') || null,
    bestaetigt: f.get('bestaetigt') === 'ja',
    band: feld(f, 'band') || null,
    info: feld(f, 'info') || null,
    muttizettel: f.get('muttizettel') === 'ja',
  };
  if (aktion === 'speichern')
    einzelEingabe = {
      ...formular,
      kategorie:
        formular.kategorie && istKategorie(formular.kategorie) ? formular.kategorie : undefined,
    };
  if (aktion === 'sammel') {
    const werte = (n: string) => f.getAll(n).map((v) => (typeof v === 'string' ? v.trim() : ''));
    // Checkboxen senden nur angehakte Werte – jede trägt ihre Zeilennummer
    const angehakt = (n: string) => new Set(werte(n));
    const [ids, datum, beginn, titel, kat, band, vo, info] = [
      's-id',
      's-datum',
      's-beginn',
      's-titel',
      's-kat',
      's-band',
      's-vo',
      's-info',
    ].map(werte);
    const [mutti, best, weg] = ['s-mutti', 's-best', 's-loeschen'].map(angehakt);
    const zeilenSammel = ids!.map((id, i) => ({
      id,
      version: werte('s-version')[i] ?? '',
      datum: datum![i] ?? '',
      beginn: beginn![i] || null,
      titel: titel![i] ?? '',
      kategorie: istKategorie(kat![i] ?? '') ? kat![i] : null,
      band: band![i] || null,
      veranstaltungsort: vo![i] || null,
      info: info![i] || null,
      muttizettel: mutti!.has(String(i)),
      bestaetigt: best!.has(String(i)),
      loeschen: weg!.has(String(i)),
    }));
    zeilenSammel.forEach((z) =>
      sammelEingaben.set(z.id, {
        ...z,
        kategorie: z.kategorie && istKategorie(z.kategorie) ? z.kategorie : undefined,
      }),
    );
    const rs = await adminApi<{ hinweise: { meldung: string }[] }>(
      Astro.cookies,
      'POST',
      'termine/sammel',
      { ortSlug: ort.slug, zeilen: zeilenSammel },
    );
    if (rs.status < 300) {
      sammelEingaben.clear();
      const geloescht = zeilenSammel.filter((z) => z.loeschen).length;
      meldung = [
        `Alle Änderungen gespeichert${geloescht ? ` (${geloescht} gelöscht)` : ''}.`,
        ...(rs.daten?.hinweise ?? []).map((h) => h.meldung),
      ].join(' ');
    } else fehler = rs.fehler;
  }
  const r =
    aktion === 'sammel'
      ? { status: 299, daten: null, fehler: fehler }
      : aktion === 'speichern'
        ? await adminApi<{ hinweise: { meldung: string }[] }>(
            Astro.cookies,
            'POST',
            'termine',
            formular,
          )
        : { status: 400, daten: null, fehler: ['Unbekannte Aktion.'] };
  if (r.status === 299) {
    // Platz-Aktion: Meldung/Fehler oben schon gesetzt
  } else if (r.status < 300) {
    const hinweise = (r.daten as { hinweise?: { meldung: string }[] } | null)?.hinweise ?? [];
    meldung = ['Termin gespeichert.', ...hinweise.map((h) => h.meldung)].join(' ');
  } else fehler = r.fehler;
}
const einzelWerte = einzelEingabe;
const termine: TerminDto[] = [];
if (ort) {
  for (let offset = 0; ; offset += 100) {
    const r = await adminApi<{ termine: TerminDto[]; gesamt: number }>(
      Astro.cookies,
      'GET',
      `termine?ort=${encodeURIComponent(ort.slug)}&zeitraum=alle&limit=100&offset=${offset}`,
    );
    if (!r.daten) {
      fehler.push(...r.fehler);
      break;
    }
    termine.push(...r.daten.termine);
    if (termine.length >= r.daten.gesamt || !r.daten.termine.length) break;
  }
}
for (let i = 0; i < termine.length; i++) {
  const t = termine[i];
  if (t) Object.assign(t, sammelEingaben.get(t.id));
}
const herkunft: Record<string, TerminHerkunft> = {};
for (let i = 0; i < termine.length; i += 100) {
  const r = await adminApi<Record<string, TerminHerkunft>>(
    Astro.cookies,
    'POST',
    'termine/herkunft',
    {
      ids: termine.slice(i, i + 100).map((t) => t.id),
    },
  );
  if (r.daten) Object.assign(herkunft, r.daten);
}
const suche = p.get('suche')?.trim().toLowerCase() ?? '';
const treffer =
  !ort && suche
    ? (await listeOrte()).filter((o) => o.name.toLowerCase().includes(suche)).slice(0, 30)
    : [];
// Plätze des Ortes – bearbeitet werden sie auf /admin/orte/<ort> (Issue #216)
const plaetze = ort
  ? ((
      await adminApi<{ plaetze: { name: string; termine: number; koordinate: unknown }[] }>(
        Astro.cookies,
        'GET',
        `orte/${ort.slug}/festplaetze`,
      )
    ).daten?.plaetze ?? [])
  : [];
const ohnePunkt = plaetze.filter((p) => !p.koordinate && p.termine > 0).length;
const veranstaltungsorte = [
  ...new Set([
    ...plaetze.map((p) => p.name).filter(Boolean),
    ...termine.map((t) => t.veranstaltungsort).filter(Boolean),
  ]),
];
// Vorschläge aus ALLEN bisherigen Terminen (Bands/DJs spielen oft mehrfach) – nichts doppelt tippen
const vorschlaege = (
  await adminApi<{ bands: string[]; titel: string[] }>(Astro.cookies, 'GET', 'vorschlaege')
).daten ?? { bands: [], titel: [] };
const bands = [...new Set([...termine.map((t) => t.band).filter(Boolean), ...vorschlaege.bands])];
const titelVorschlaege = [...new Set([...vorschlaege.titel])];
---

<AdminLayout titel={ort ? `Termine in ${ort.name}` : 'Termine'} meldung={meldung} fehler={fehler}>
  {!ort && (
    <>
      <h2>Für welchen Ort?</h2>
      <form class="suchzeile" method="get">
        <input
          type="search"
          name="suche"
          value={suche}
          placeholder="Ortsname, z. B. Mühlberg"
          aria-label="Ortsname"
          autofocus
        />
        <button class="knopf" type="submit">
          <Icon name="suche" />
          Suchen
        </button>
      </form>
      {suche && (
        <table class="admin-tabelle">
          <tbody>
            {treffer.length === 0 && (
              <tr>
                <td>
                  Kein Ort gefunden. <a href="/admin/orte">Ort anlegen</a>
                </td>
              </tr>
            )}
            {treffer.map((o) => (
              <tr>
                <td>
                  <a href={`/admin/termine?ort=${o.slug}`}>{o.name}</a>{' '}
                  <span class="leise klein">({kreisKurz(o.landkreis)})</span>
                </td>
                <td class="klein">{o.anzahlKommend} kommende Termine</td>
              </tr>
            ))}
          </tbody>
        </table>
      )}
    </>
  )}

  {ortSlug && !ort && (
    <p class="meldung">
      Ort „{ortSlug}“ nicht gefunden. <a href="/admin/termine">Neu suchen</a>
    </p>
  )}

  {ort && (
    <>
      {!darf(Astro.locals, 'links') ? (
        <p class="brotkrumen">
          <a href={`/orte/${ort.slug}`}>Öffentliche Ortsseite</a>
        </p>
      ) : (
        <p class="brotkrumen">
          <a href="/admin/termine">Anderen Ort wählen</a> ·{' '}
          <a href={`/orte/${ort.slug}`}>Öffentliche Ortsseite</a> ·{' '}
          <a href={`/admin/links?ort=${ort.slug}`}>Link für die Kirmesgesellschaft</a>
        </p>
      )}

      <p class="platzhinweis">
        <a class="knopf zweit" href={`/admin/orte/${ort.slug}`}>
          <Icon name="stift" groesse={14} />{' '}
          {darf(Astro.locals, 'orte.bearbeiten') ? 'Ort & Plätze bearbeiten' : 'Plätze bearbeiten'}
        </a>{' '}
        <span class="leise klein">
          {plaetze.length === 1 ? '1 Platz' : `${plaetze.length} Plätze`}
          {ohnePunkt > 0 && ` · ${ohnePunkt} ohne Kartenpunkt (keine Route)`}
        </span>
      </p>

      {
        <nav class="umschalter" aria-label="Art der Eingabe">
          <a href={`/admin/termine?ort=${ort.slug}`} aria-current={!alleModus && 'page'}>
            Einzelner Termin
          </a>
          <a href={`/admin/kirmes-eintragen?ort=${ort.slug}`}>Ganzes Kirmeswochenende</a>
          {termine.length > 0 && (
            <a
              href={`/admin/termine?ort=${ort.slug}&modus=alle`}
              aria-current={alleModus && 'page'}
            >
              Alle Termine bearbeiten
            </a>
          )}
        </nav>
      }

      {alleModus && (
        <KirmesSammel
          ort={ort}
          termine={termine}
          herkunft={herkunft}
          sammelEingaben={sammelEingaben}
        />
      )}

      {!alleModus && (
        <NeuerTermin
          einzelWerte={einzelWerte}
          veranstaltungsorte={veranstaltungsorte as string[]}
        />
      )}
      {alleModus && (
        <datalist id="vo-liste">
          {veranstaltungsorte.map((v) => (
            <option value={v!} />
          ))}
        </datalist>
      )}

      <datalist id="band-liste">
        {bands.map((b) => (
          <option value={b!} />
        ))}
      </datalist>
      <datalist id="titel-liste">
        {titelVorschlaege.map((t) => (
          <option value={t} />
        ))}
      </datalist>

      <OrtTerminliste ort={ort} termine={termine} herkunft={herkunft} />
    </>
  )}
</AdminLayout>
