---
import AdminLayout from '../../components/admin/AdminLayout.astro';
import CsrfFeld from '../../components/admin/CsrfFeld.astro';
import Icon from '../../components/Icon.astro';
import { koordinateAusText } from '@kirmes/core';
import { adminApi, feld } from '../../lib/admin';
import { listeOrte } from '../../lib/api';
import { LANDKREISE, kreisKurz } from '../../lib/anzeige';
import type { LandkreisKuerzel } from '@kirmes/core';

let meldung: string | null = null;
let fehler: string[] = [];
let neuerSlug: string | null = null;
if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  if (feld(f, 'aktion') === 'loeschen') {
    // Versehentlich angelegten Ort entfernen (Issue #159) – die API prüft Herkunft, Termine, Rolle
    const name = feld(f, 'name');
    if (!f.has('sicher')) fehler = [`Bitte bestätigen, dass „${name}“ gelöscht werden soll.`];
    else {
      const r = await adminApi(
        Astro.cookies,
        'DELETE',
        `orte/${encodeURIComponent(feld(f, 'slug'))}`,
      );
      if (r.status === 204) meldung = `Ort „${name}“ gelöscht.`;
      else fehler = r.fehler;
    }
  } else {
    const k = feld(f, 'koordinate') ? koordinateAusText(feld(f, 'koordinate')) : null;
    if (feld(f, 'koordinate') && !k) {
      fehler = [
        'Koordinate nicht erkannt – bitte „50.87, 10.82“ oder einen Google-Maps-Link einfügen.',
      ];
    } else {
      const r = await adminApi<{ slug: string; name: string }>(Astro.cookies, 'POST', 'orte', {
        name: feld(f, 'name'),
        landkreis: feld(f, 'landkreis'),
        lat: k?.lat ?? null,
        lon: k?.lon ?? null,
      });
      if (r.daten) {
        neuerSlug = r.daten.slug;
        meldung = `Ort „${r.daten.name}“ angelegt.`;
      } else fehler = r.fehler;
    }
  }
}
const eigene =
  (
    await adminApi<
      {
        slug: string;
        name: string;
        landkreis: LandkreisKuerzel;
        termine: number;
        vorschlaege: number;
      }[]
    >(Astro.cookies, 'GET', 'orte/eigene')
  ).daten ?? [];

const suche = Astro.url.searchParams.get('suche')?.trim().toLowerCase() ?? '';
const alleOrte = await listeOrte();
const treffer = suche
  ? alleOrte.filter((o) => o.name.toLowerCase().includes(suche)).slice(0, 30)
  : [];

/** Orte mit kommenden Terminen samt ihren Plätzen – ohne Umweg über „Bearbeiten“ (Issue #326) */
type Platz = { name: string; termine: number; koordinate: { lat: number; lon: number } | null };
const aktive = (
  await Promise.all(
    alleOrte
      .filter((o) => o.anzahlKommend > 0)
      .sort((a, b) => a.name.localeCompare(b.name, 'de'))
      .map(async (o) => ({
        ...o,
        plaetze:
          (
            await adminApi<{ plaetze: Platz[] }>(
              Astro.cookies,
              'GET',
              `orte/${encodeURIComponent(o.slug)}/festplaetze`,
            )
          ).daten?.plaetze ?? null,
      })),
  )
).filter((o) => o.plaetze !== null);
const kreise = (Object.keys(LANDKREISE) as LandkreisKuerzel[]).sort((a, b) =>
  kreisKurz(a).localeCompare(kreisKurz(b), 'de'),
);
---

<AdminLayout titel="Orte & Plätze" meldung={meldung} fehler={fehler}>
  {neuerSlug && (
    <p class="kasten">
      Ortsseite: <a href={`/orte/${neuerSlug}`}>/orte/{neuerSlug}</a> ·{' '}
      <a href={`/admin/termine?ort=${neuerSlug}`}>Termin für diesen Ort eintragen</a>
    </p>
  )}
  <p class="lesetext leise">
    Das Ortsverzeichnis enthält bereits über 3.000 Thüringer Orte und Ortsteile aus OpenStreetMap.
    Bitte zuerst suchen – nur fehlende Orte neu anlegen.
  </p>

  <h2>Ort suchen</h2>
  <form class="suchzeile" method="get">
    <input type="search" name="suche" value={suche} placeholder="Ortsname" aria-label="Ortsname" />
    <button class="knopf zweit" type="submit">
      Suchen
    </button>
  </form>
  {suche && (
    <table class="admin-tabelle">
      <tbody>
        {treffer.length === 0 && (
          <tr>
            <td>Kein Ort gefunden – unten neu anlegen.</td>
          </tr>
        )}
        {treffer.map((o) => (
          <tr>
            <td>
              <a href={`/orte/${o.slug}`}>{o.name}</a>{' '}
              <span class="leise klein">({kreisKurz(o.landkreis)})</span>
            </td>
            <td class="klein">{o.anzahlKommend} Termine</td>
            <td>
              <a class="knopf zweit" href={`/admin/orte/${o.slug}`}>
                <Icon name="stift" groesse={14} /> Plätze & Ort
              </a>{' '}
              <a class="knopf zweit" href={`/admin/termine?ort=${o.slug}`}>
                Termine
              </a>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  )}

  <h2>Orte mit kommenden Terminen</h2>
  {aktive.length === 0 ? (
    <p class="leise">Gerade hat kein Ort kommende Termine.</p>
  ) : (
    <ul class="ort-plaetze">
      {aktive.map((o) => (
        <li>
          <div class="kopfzeile">
            <a href={`/orte/${o.slug}`} class="ortname">
              {o.name}
            </a>{' '}
            <span class="leise klein">
              ({kreisKurz(o.landkreis)}) · {o.anzahlKommend} kommende Termine
            </span>
          </div>
          {o.plaetze?.length ? (
            <ul class="plaetze">
              {o.plaetze.map((p) => (
                <li>
                  <Icon name="standort" groesse={14} /> {p.name || 'Hauptfestplatz'}{' '}
                  <span class="leise klein">
                    · {p.termine} {p.termine === 1 ? 'Termin' : 'Termine'} ·{' '}
                    {p.koordinate ? (
                      'Kartenpunkt gesetzt'
                    ) : (
                      <strong class="fehlt">kein Kartenpunkt</strong>
                    )}
                  </span>
                </li>
              ))}
            </ul>
          ) : (
            <p class="leise klein">Noch keine Plätze.</p>
          )}
          <a class="knopf zweit" href={`/admin/orte/${o.slug}`}>
            <Icon name="stift" groesse={14} /> Plätze bearbeiten
          </a>
        </li>
      ))}
    </ul>
  )}

  {eigene.length > 0 && (
    <>
      <h2>Selbst angelegte Orte</h2>
      <p class="leise klein">
        Aus Versehen angelegt? Löschen geht, solange keine Termine oder Vorschläge daran hängen.
        Orte aus dem Ortsverzeichnis bleiben immer erhalten.
      </p>
      <table class="admin-tabelle">
        <tbody>
          {eigene.map((o) => (
            <tr>
              <td>
                <a href={`/admin/orte/${o.slug}`}>{o.name}</a>{' '}
                <span class="leise klein">({kreisKurz(o.landkreis)})</span>
              </td>
              <td class="klein">
                {o.termine} Termine{o.vorschlaege > 0 && ` · ${o.vorschlaege} Vorschläge`}
              </td>
              <td>
                {o.termine + o.vorschlaege === 0 ? (
                  <form method="post" class="loeschen-form">
                    <CsrfFeld />
                    <input type="hidden" name="aktion" value="loeschen" />
                    <input type="hidden" name="slug" value={o.slug} />
                    <input type="hidden" name="name" value={o.name} />
                    <label class="klein">
                      <input type="checkbox" name="sicher" required /> sicher
                    </label>
                    <button class="knopf zweit" type="submit">
                      Löschen
                    </button>
                  </form>
                ) : (
                  <span class="leise klein">erst Termine löschen</span>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </>
  )}

  <h2>Neuen Ort anlegen</h2>
  <p class="kasten klein">
    <strong>Kirche, Festzelt oder Sportplatz?</strong> Das ist kein neuer Ort, sondern ein{' '}
    <strong>Platz</strong> im Ort: beim Ort „Plätze bearbeiten“ (oder den Ort suchen und „Plätze &
    Ort“) wählen und dort den Platz mit Google-Maps-Link anlegen. Termine mit gleichem „Wo genau?“
    führen dann dorthin.
  </p>
  <form class="melden" method="post">
    <CsrfFeld />
    <div class="zwei">
      <label>
        Name
        <input name="name" required maxlength="120" />
      </label>
      <label>
        Landkreis
        <select name="landkreis" required>
          <option value="">bitte wählen</option>
          {kreise.map((k) => (
            <option value={k}>{kreisKurz(k)}</option>
          ))}
        </select>
      </label>
    </div>
    <label>
      Lage (optional)
      <input name="koordinate" placeholder="Google-Maps-Link oder „50.87, 10.82“" />
    </label>
    <div>
      <button class="knopf" type="submit">
        Ort anlegen
      </button>
    </div>
  </form>
</AdminLayout>
<style>
  .ort-plaetze {
    list-style: none;
    padding: 0;
    margin: 0 0 24px;
    display: grid;
    gap: 12px;
  }
  .ort-plaetze > li {
    border: 1px solid var(--linie);
    border-radius: 10px;
    padding: 12px 14px;
    background: var(--flaeche);
  }
  .ort-plaetze .ortname {
    font-weight: 700;
  }
  .plaetze {
    list-style: none;
    padding: 0;
    margin: 8px 0 10px;
    display: grid;
    gap: 4px;
  }
  .plaetze li {
    overflow-wrap: anywhere;
  }
  .plaetze .fehlt {
    color: var(--rot);
  }
  .loeschen-form {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }
</style>
