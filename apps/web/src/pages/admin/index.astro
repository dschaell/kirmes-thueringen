---
import { darf } from '@kirmes/core';
import AdminLayout from '../../components/admin/AdminLayout.astro';
import Icon from '../../components/Icon.astro';
import { adminApi } from '../../lib/admin';
import type { TerminSeite } from '../../lib/api';
import type { TerminHerkunft } from '@kirmes/core';
import Herkunft from '../../components/admin/TerminHerkunft.astro';
import { anzahl, datumKurz, datumLangJahr, artName } from '../../lib/anzeige';
import { listenMeldung, markierte, nachKirmes, zurueckLink } from '../../lib/terminliste';
import type { TerminDto } from '../../lib/api';
import { sicherungsZeile, type SicherungsStand } from '../../lib/sicherungen';
const p = Astro.url.searchParams;
const q = (p.get('q') ?? '').slice(0, 100);
const datum = p.get('datum') ?? '';
const zeitraum = p.get('zeitraum') ?? 'kommend';
const ort = (p.get('ort') ?? '').slice(0, 120);
const von = (p.get('von') ?? '').slice(0, 10);
const offsetText = p.get('offset') ?? '0';
const offset = /^\d{1,7}$/.test(offsetText) ? Number(offsetText) : 0;
const parameter = new URLSearchParams({ q, datum, zeitraum, limit: '25', offset: String(offset) });
if (ort) parameter.set('ort', ort);
if (von) parameter.set('von', von);
// Aktuelle Liste als Rücksprungziel für Bearbeiten/Bestätigen/Löschen (Issue #90)
// Bestätigen nur die Kirmesgesellschaft selbst (Issue #240)
const kg = darf(Astro.locals, 'termine.bestaetigen');
const zurueck = encodeURIComponent(zurueckLink(parameter));
const markiert = new Set(markierte(p));
const [seite, sicherung] = await Promise.all([
  adminApi<TerminSeite>(Astro.cookies, 'GET', `termine?${parameter}`),
  // Nur Admins und nur mit eingebundenem Sicherungsverzeichnis – sonst 403/404 und keine Zeile (#45)
  adminApi<SicherungsStand>(Astro.cookies, 'GET', 'sicherungen'),
]);
const sicherungsStand = sicherung.daten ? sicherungsZeile(sicherung.daten) : null;
if (seite.status >= 400) Astro.response.status = seite.status;
const daten = seite.daten ?? { termine: [], gesamt: 0 };
const herkunft = daten.termine.length
  ? await adminApi<Record<string, TerminHerkunft>>(Astro.cookies, 'POST', 'termine/herkunft', {
      ids: daten.termine.map((t) => t.id),
    })
  : null;
// Gespeicherter Termin passt nicht (mehr) zum Filter? Dann wenigstens einen Weg dorthin zeigen.
const fehlt =
  markiert.size === 1 && !daten.termine.some((t) => markiert.has(t.id))
    ? (await adminApi<TerminDto>(Astro.cookies, 'GET', `termine/${[...markiert][0]}`)).daten
    : null;
const ortName = ort ? daten.termine[0]?.ort.name : undefined;
const gruppen = nachKirmes(daten.termine);
const seitenLink = (neu: number) => {
  const x = new URLSearchParams(parameter);
  x.set('offset', String(neu));
  return `/admin?${x}#terminliste`;
};
const meldung = listenMeldung(p, ortName);
---

<AdminLayout titel="Termine" fehler={seite.fehler} meldung={meldung}>
  <div class="hauptaktionen">
    <a class="knopf" href="/admin/kirmes-eintragen">
      <Icon name="kalender" />
      Kirmes eintragen
    </a>
  </div>
  {sicherungsStand && (
    <p
      class:list={['sicherungsstand', { meldung: sicherungsStand.warnung }]}
      role={sicherungsStand.warnung ? 'alert' : undefined}
    >
      {sicherungsStand.text}
    </p>
  )}
  <section aria-labelledby="terminliste" class="terminliste">
    <h2 id="terminliste">Alle angelegten Termine</h2>
    <form class="melden listensuche" id="terminsuche" method="get" action="/admin#terminliste">
      <label>
        Ort, Veranstaltung oder Band
        <input
          name="q"
          type="search"
          maxlength="100"
          value={q}
          placeholder="z. B. Alkersleben oder Kirmestanz"
        />
      </label>
      <div class="zwei">
        <label>
          Zeitraum
          <select name="zeitraum">
            {[
              ['kommend', 'Kommende Termine'],
              ['vergangen', 'Vergangene Termine'],
              ['alle', 'Alle Termine'],
            ].map(([wert, text]) => (
              <option value={wert} selected={zeitraum === wert}>
                {text}
              </option>
            ))}
          </select>
        </label>
        <label>
          Genaues Datum (freiwillig)
          <input type="date" name="datum" value={datum} />
          <span class="klein leise">
            Mit Datum: nur Termine an diesem Tag – egal, was bei Zeitraum steht.
          </span>
        </label>
      </div>
      {ort && <input type="hidden" name="ort" value={ort} />}
      {von && <input type="hidden" name="von" value={von} />}
      <div class="knopfreihe">
        <button class="knopf zweit">Suchen</button>
        <a href="/admin">Suche zurücksetzen</a>
      </div>
    </form>
    {fehlt && (
      <p class="kasten">
        „{fehlt.titel}“ ({datumLangJahr(fehlt.datum)}) passt nicht zum aktuellen Filter.{' '}
        <a
          href={`/admin?zeitraum=alle&datum=${fehlt.datum}&markiert=${fehlt.id}#termin-${fehlt.id}`}
        >
          Termin anzeigen
        </a>
      </p>
    )}
    {(ort || von) && (
      <p class="klein">
        {ortName ?? 'Ein Ort'}
        {von && ` ab ${datumLangJahr(von)}`} ·{' '}
        <a href={`/admin?zeitraum=${zeitraum}`}>Filter entfernen</a>
      </p>
    )}
    <p class="klein leise">
      „Bestätigt“ setzt nur die Kirmesgesellschaft selbst: automatisch, wenn sie Termine einträgt
      oder ändert, oder per „Bestätigen“. Besucher sehen dann „bestätigt“; alle anderen Termine
      gelten als recherchiert.
    </p>
    <p class="klein leise">
      {anzahl(daten.gesamt, 'Termin', 'Termine', '0 Termine')}
      {daten.termine.length > 0 && ` · ${offset + 1}–${offset + daten.termine.length}`}
    </p>
    {daten.termine.length === 0 && !seite.fehler.length && (
      <p class="leer">
        Hier wurden keine Termine gefunden. <a href="/admin?zeitraum=alle">Alle Termine anzeigen</a>
        .
      </p>
    )}
    {gruppen.map((g) => {
      const offen = g.termine.filter((t) => !t.bestaetigt);
      const name = g.termine[0]?.ort.name ?? g.ort;
      return (
        <details class="kirmesgruppe" open>
          <summary>
            <span class="gruppenname">{name}</span>
            <span class="klein leise">
              {g.von === g.bis
                ? datumLangJahr(g.von)
                : `${datumKurz(g.von)} – ${datumLangJahr(g.bis)}`}{' '}
              · {anzahl(g.termine.length, 'Termin', 'Termine')}
              {offen.length > 0 && ` · ${offen.length} unbestätigt`}
            </span>
          </summary>
          {/* Was man mit einer Kirmes oft braucht, direkt am Kopf (Issue #330) */}
          <p class="gruppenaktion klein">
            <a href={`/admin/termine?ort=${g.ort}`}>Termin hinzufügen</a>
            <a href={`/admin/orte/${g.ort}`}>Plätze</a>
            <a href={`/admin/kirmes-eintragen?vorjahr=${g.ort}&von=${g.von}&bis=${g.bis}`}>
              Für {Number(g.von.slice(0, 4)) + 1} übernehmen
            </a>
          </p>
          {kg && offen.length > 1 && (
            <p class="gruppenaktion">
              <a
                class="knopf zweit"
                href={`/admin/bestaetigen?${offen.map((t) => `id=${t.id}`).join('&')}&zurueck=${zurueck}`}
              >
                Alle {offen.length} bestätigen
              </a>
            </p>
          )}
          <ul class="terminkarten">
            {g.termine.map((t) => (
              <li id={`termin-${t.id}`} class:list={{ markiert: markiert.has(t.id) }}>
                <div>
                  <p class="klein leise">
                    {datumLangJahr(t.datum)}
                    {t.beginn && ` · ${t.beginn} Uhr`}
                  </p>
                  <h3>{t.titel}</h3>
                  <p>
                    {artName(t.kategorie)}
                    {t.band && ` · ${t.band}`}
                    {t.muttizettel && ' · Muttizettel'}
                    <span class="klein leise">
                      {' '}
                      · {t.bestaetigt ? 'bestätigt' : 'noch nicht bestätigt'}
                    </span>
                  </p>
                  <Herkunft herkunft={herkunft?.daten?.[t.id]} kompakt />
                </div>
                <div class="terminaktionen">
                  <a
                    class="knopf zweit"
                    href={`/admin/termine/${t.id}?zurueck=${zurueck}`}
                    aria-label={`Termin bearbeiten: ${t.titel} in ${t.ort.name}`}
                  >
                    <Icon name="stift" />
                    Bearbeiten
                  </a>
                  {kg && !t.bestaetigt && (
                    <a
                      class="klein"
                      href={`/admin/termine/${t.id}/aktion?aktion=bestaetigen&zurueck=${zurueck}`}
                    >
                      Bestätigen
                    </a>
                  )}
                  {/* Öffentliche Seite (Issue #333) */}
                  <a class="klein" href={`/termin/${t.id}`} target="_blank" rel="noopener">
                    Ansehen
                  </a>
                  <a
                    class="klein"
                    href={`/admin/termine/${t.id}/aktion?aktion=loeschen&zurueck=${zurueck}`}
                  >
                    Löschen
                  </a>
                </div>
              </li>
            ))}
          </ul>
        </details>
      );
    })}
    <nav class="seiten" aria-label="Ergebnisseiten">
      {offset > 0 && (
        <a class="knopf zweit" href={seitenLink(Math.max(0, offset - 25))}>
          Zurück
        </a>
      )}
      {offset + 25 < daten.gesamt && (
        <a class="knopf zweit" href={seitenLink(offset + 25)}>
          Weitere Termine
        </a>
      )}
    </nav>
  </section>
</AdminLayout>
<style>
  .sicherungsstand {
    font-size: 0.875rem;
    color: var(--grau);
  }
  .sicherungsstand.meldung {
    color: inherit;
  }
  .hauptaktionen {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 20px;
    margin: 20px 0 24px;
  }
  .hauptaktionen a {
    min-height: 48px;
  }
  .listensuche {
    max-width: 720px;
  }
  .terminkarten {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .kirmesgruppe {
    border: 1px solid var(--linie);
    border-radius: var(--r);
    padding: 0 16px;
    margin: 16px 0;
  }
  .kirmesgruppe summary {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 12px;
    min-height: 52px;
    padding: 12px 0;
    cursor: pointer;
  }
  .gruppenname {
    font-weight: 700;
    font-size: 1.15rem;
  }
  .gruppenaktion {
    margin: 0 0 8px;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 18px;
  }
  .gruppenaktion.klein a {
    min-height: 36px;
    display: inline-flex;
    align-items: center;
  }
  .terminkarten li:last-child {
    border-bottom: 0;
  }
  .terminkarten li {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 12px 0;
    border-bottom: 1px solid var(--linie);
  }
  .terminkarten li.markiert {
    background: var(--flaeche);
    box-shadow: inset 4px 0 0 var(--fokus);
    padding-left: 16px;
    padding-right: 12px;
    scroll-margin-top: 24px;
  }
  .terminkarten h3,
  .terminkarten p {
    margin: 0 0 3px;
  }
  .terminkarten h3 {
    font-size: 1.1rem;
  }
  .terminaktionen {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
  }
  .terminaktionen a {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
  .seiten,
  .knopfreihe {
    display: flex;
    gap: 16px;
    align-items: center;
    flex-wrap: wrap;
    margin-top: 16px;
  }
  @media (max-width: 600px) {
    .hauptaktionen {
      display: grid;
      justify-items: start;
    }
    .terminkarten li {
      display: block;
    }
    .terminaktionen {
      margin-top: 6px;
      gap: 4px 16px;
    }
  }
</style>
