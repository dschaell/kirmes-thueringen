---
import AdminLayout from '../../components/admin/AdminLayout.astro';
import Icon from '../../components/Icon.astro';
import { adminApi } from '../../lib/admin';
import type { TerminSeite } from '../../lib/api';
import type { TerminHerkunft } from '@kirmes/core';
import Herkunft from '../../components/admin/TerminHerkunft.astro';
import { anzahl, datumLangJahr } from '../../lib/anzeige';
import { listenMeldung, markierte, zurueckLink } from '../../lib/terminliste';
import type { TerminDto } from '../../lib/api';
const p = Astro.url.searchParams;
const q = (p.get('q') ?? '').slice(0, 100);
const datum = p.get('datum') ?? '';
const zeitraum = p.get('zeitraum') ?? 'kommend';
const ort = (p.get('ort') ?? '').slice(0, 120);
const von = (p.get('von') ?? '').slice(0, 10);
const offsetText = p.get('offset') ?? '0';
const offset = /^\d{1,7}$/.test(offsetText) ? Number(offsetText) : 0;
const parameter = new URLSearchParams({ q, datum, zeitraum, limit: '25', offset: String(offset) });
if (ort) parameter.set('ort', ort);
if (von) parameter.set('von', von);
// Aktuelle Liste als Rücksprungziel für Bearbeiten/Bestätigen/Löschen (Issue #90)
const zurueck = encodeURIComponent(zurueckLink(parameter));
const markiert = new Set(markierte(p));
const [seite, v] = await Promise.all([
  adminApi<TerminSeite>(Astro.cookies, 'GET', `termine?${parameter}`),
  adminApi<{ anzahl: number }>(Astro.cookies, 'GET', 'termine-vorschlaege/anzahl'),
]);
if (seite.status >= 400) Astro.response.status = seite.status;
const daten = seite.daten ?? { termine: [], gesamt: 0 };
const herkunft = daten.termine.length
  ? await adminApi<Record<string, TerminHerkunft>>(Astro.cookies, 'POST', 'termine/herkunft', {
      ids: daten.termine.map((t) => t.id),
    })
  : null;
// Gespeicherter Termin passt nicht (mehr) zum Filter? Dann wenigstens einen Weg dorthin zeigen.
const fehlt =
  markiert.size === 1 && !daten.termine.some((t) => markiert.has(t.id))
    ? (await adminApi<TerminDto>(Astro.cookies, 'GET', `termine/${[...markiert][0]}`)).daten
    : null;
const ortName = ort ? daten.termine[0]?.ort.name : undefined;
const seitenLink = (neu: number) => {
  const x = new URLSearchParams(parameter);
  x.set('offset', String(neu));
  return `/admin?${x}#terminliste`;
};
const meldung = listenMeldung(p, ortName);
---

<AdminLayout titel="Termine" fehler={seite.fehler} meldung={meldung}>
  <div class="hauptaktionen">
    <a class="knopf" href="/admin/kirmes-eintragen"><Icon name="kalender" />Kirmes eintragen</a>
    <a class="knopf zweit" href="/admin/vorschlaege">Vorschläge prüfen ({v.daten?.anzahl ?? '–'})</a
    >
    <a class="knopf zweit" href="#terminsuche"><Icon name="suche" />Termin suchen</a>
    {
      Astro.locals.rolle === 'admin' && (
        <a class="knopf zweit" href="/admin/mitglieder#einladen">
          Redaktion einladen
        </a>
      )
    }
  </div>
  <section aria-labelledby="terminliste" class="terminliste">
    <h2 id="terminliste">Alle angelegten Termine</h2>
    <form class="melden listensuche" id="terminsuche" method="get" action="/admin#terminliste">
      <label
        >Ort, Veranstaltung oder Band<input
          name="q"
          type="search"
          maxlength="100"
          value={q}
          placeholder="z. B. Alkersleben oder Kirmestanz"
        /></label
      >
      <div class="zwei">
        <label
          >Zeitraum<select name="zeitraum"
            >{
              [
                ['kommend', 'Kommende Termine'],
                ['vergangen', 'Vergangene Termine'],
                ['alle', 'Alle Termine'],
              ].map(([wert, text]) => (
                <option value={wert} selected={zeitraum === wert}>
                  {text}
                </option>
              ))
            }</select
          ></label
        >
        <label
          >Genaues Datum (freiwillig)<input type="date" name="datum" value={datum} /><span
            class="klein leise">Ein Datum durchsucht den gesamten Bestand.</span
          ></label
        >
      </div>
      {ort && <input type="hidden" name="ort" value={ort} />}
      {von && <input type="hidden" name="von" value={von} />}
      <div class="knopfreihe">
        <button class="knopf zweit">Suchen</button><a href="/admin">Suche zurücksetzen</a>
      </div>
    </form>
    {
      fehlt && (
        <p class="kasten">
          „{fehlt.titel}“ ({datumLangJahr(fehlt.datum)}) passt nicht zum aktuellen Filter.{' '}
          <a
            href={`/admin?zeitraum=alle&datum=${fehlt.datum}&markiert=${fehlt.id}#termin-${fehlt.id}`}
          >
            Termin anzeigen
          </a>
        </p>
      )
    }
    {
      (ort || von) && (
        <p class="klein">
          {ortName ?? 'Ein Ort'}
          {von && ` ab ${datumLangJahr(von)}`} ·{' '}
          <a href={`/admin?zeitraum=${zeitraum}`}>Filter entfernen</a>
        </p>
      )
    }
    <p class="klein leise">
      {anzahl(daten.gesamt, 'Termin', 'Termine', '0 Termine')}{
        daten.termine.length > 0 && ` · ${offset + 1}–${offset + daten.termine.length}`
      }
    </p>
    {
      daten.termine.length === 0 && !seite.fehler.length && (
        <p class="leer">
          Hier wurden keine Termine gefunden.{' '}
          <a href="/admin?zeitraum=alle">Alle Termine anzeigen</a>.
        </p>
      )
    }
    <ul class="terminkarten">
      {
        daten.termine.map((t) => (
          <li id={`termin-${t.id}`} class:list={{ markiert: markiert.has(t.id) }}>
            <div>
              <>
                <p class="klein leise">
                  {datumLangJahr(t.datum)}
                  {t.beginn && ` · ${t.beginn} Uhr`}
                </p>
                <h3>{t.titel}</h3>
                <p>
                  {t.ort.name}
                  {t.band && ` · ${t.band}`}
                </p>
                <p class="klein leise">
                  {t.bestaetigt ? 'Vom Veranstalter bestätigt' : 'Noch nicht bestätigt'}
                </p>
                <Herkunft herkunft={herkunft?.daten?.[t.id]} />
              </>
            </div>
            <div class="terminaktionen">
              <a
                class="knopf zweit"
                href={`/admin/termine/${t.id}?zurueck=${zurueck}`}
                aria-label={`Termin bearbeiten: ${t.titel} in ${t.ort.name}`}
              >
                <Icon name="stift" />
                Bearbeiten
              </a>
              {!t.bestaetigt && (
                <a
                  class="klein"
                  href={`/admin/termine/${t.id}/aktion?aktion=bestaetigen&zurueck=${zurueck}`}
                >
                  Bestätigen
                </a>
              )}
              <a
                class="klein"
                href={`/admin/termine/${t.id}/aktion?aktion=loeschen&zurueck=${zurueck}`}
              >
                Löschen
              </a>
            </div>
          </li>
        ))
      }
    </ul>
    <nav class="seiten" aria-label="Ergebnisseiten">
      {
        offset > 0 && (
          <a class="knopf zweit" href={seitenLink(Math.max(0, offset - 25))}>
            Zurück
          </a>
        )
      }
      {
        offset + 25 < daten.gesamt && (
          <a class="knopf zweit" href={seitenLink(offset + 25)}>
            Weitere Termine
          </a>
        )
      }
    </nav>
  </section>
</AdminLayout>
<style>
  .hauptaktionen {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 24px 0 36px;
  }
  .hauptaktionen a {
    min-height: 48px;
  }
  .listensuche {
    max-width: 720px;
  }
  .terminkarten {
    list-style: none;
    padding: 0;
  }
  .terminkarten li {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    padding: 20px 0;
    border-bottom: 1px solid var(--linie);
  }
  .terminkarten li.markiert {
    background: var(--flaeche);
    box-shadow: inset 4px 0 0 var(--fokus);
    padding-left: 16px;
    padding-right: 12px;
    scroll-margin-top: 24px;
  }
  .terminkarten h3,
  .terminkarten p {
    margin: 0 0 6px;
  }
  .terminkarten h3 {
    font-size: 1.2rem;
  }
  .terminaktionen {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
  }
  .terminaktionen a {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
  .seiten,
  .knopfreihe {
    display: flex;
    gap: 16px;
    align-items: center;
    flex-wrap: wrap;
    margin-top: 16px;
  }
  @media (max-width: 600px) {
    .hauptaktionen {
      display: grid;
    }
    .terminkarten li {
      display: block;
    }
    .terminaktionen {
      margin-top: 12px;
    }
  }
</style>
