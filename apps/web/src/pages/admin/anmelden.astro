---
/** Anmeldung der Redaktion – nur mit Passkey (Issue #56). */
import { redaktionsRueckkehr } from '../../lib/admin';
import Base from '../../layouts/Base.astro';
import CsrfFeld from '../../components/admin/CsrfFeld.astro';
import InAppHinweis from '../../components/admin/InAppHinweis.astro';
import { einrichtungsStatus } from '../../lib/zugang';

// Noch kein Admin? Dann auf die Ersteinrichtung hinweisen.
const weiter = redaktionsRueckkehr(Astro.url.searchParams.get('weiter'));
const ersteinrichtung = (await einrichtungsStatus()).offen;
---

<Base title="Anmelden – Redaktion" description="Anmeldung für die Redaktion" noindex>
  <section class="einstieg">
    <h1>Redaktion</h1>
    <p class="unterzeile">Nur für die Redaktion des Kirmeskalenders.</p>
  </section>
  <InAppHinweis />
  {ersteinrichtung && (
    <p class="kasten">
      Es gibt noch keinen Admin. <a href="/admin/einrichten">Jetzt einrichten</a>
    </p>
  )}
  <CsrfFeld />
  <input type="hidden" id="nach-anmeldung" value={weiter} />
  <section class="passkey-anmeldung" id="passkey-bereich">
    <button class="knopf" type="button" id="passkey-anmelden">
      Mit Passkey anmelden
    </button>
    <p class="leise klein" id="passkey-status" role="status" aria-live="polite"></p>
  </section>
  <p class="leise">
    Noch nicht dabei?{' '}
    <a href="/redaktion-mitmachen">Mitmachen (Kirmesgesellschaften &amp; Redaktion)</a>
  </p>
</Base>

<script>
  import { browserSupportsWebAuthn, startAuthentication } from '@simplewebauthn/browser';
  import { passkeyFehler, postJson } from '../../lib/passkey-client';

  const knopf = document.getElementById('passkey-anmelden') as HTMLButtonElement | null;
  const status = document.getElementById('passkey-status');

  if (knopf && status) {
    if (!browserSupportsWebAuthn()) {
      knopf.disabled = true;
      status.textContent =
        'Dieser Browser kann keine Passkeys. Bitte ein aktuelles Handy oder einen aktuellen Browser nutzen.';
    }
    knopf.addEventListener('click', async () => {
      knopf.disabled = true;
      status.textContent = 'Bitte am Gerät bestätigen …';
      try {
        // Challenge holen, Gerät signieren lassen (Face ID/Touch ID/PIN), anmelden
        const opt = await postJson('/admin/anmelden/passkey-optionen');
        if (!opt.ok) {
          status.textContent = String(opt.daten.fehler ?? 'Das hat nicht geklappt.');
          return;
        }
        const antwort = await startAuthentication({ optionsJSON: opt.daten.optionen as never });
        status.textContent = 'Prüfe …';
        const r = await postJson('/admin/anmelden/passkey', {
          vorgang: opt.daten.vorgang,
          antwort,
        });
        if (r.ok)
          location.assign(
            document.querySelector<HTMLInputElement>('#nach-anmeldung')?.value ?? '/admin',
          );
        else status.textContent = String(r.daten.fehler ?? 'Anmeldung fehlgeschlagen.');
      } catch (e) {
        status.textContent = passkeyFehler(e);
      } finally {
        knopf.disabled = false;
      }
    });
  }
</script>
