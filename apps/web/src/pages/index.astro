---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import KeineTreffer from '../components/KeineTreffer.astro';
import TerminListe from '../components/TerminListe.astro';
import { holeBeitraege, listeOrte, sucheTermine } from '../lib/api';
import BeitragListe from '../components/BeitragListe.astro';
import {
  LANDKREISE,
  eventJsonLd,
  heute,
  kreisKurz,
  kreisSlug,
  plusTage,
  wochenende,
} from '../lib/anzeige';
import type { LandkreisKuerzel } from '@kirmes/core';

const h = heute();
const we = wochenende(h);
// Startseite = „Was ist jetzt los?“ (Issue #263): ab heute bis Sonntag – auch Mo–Do der heutige
// Tag. Alles Weitere steht nur unter „Termine“, nicht doppelt.
const tag = new Date(h).getUTCDay(); // 0 = So
const wochenendeSchon = tag === 0 || tag >= 5;
const [jetzt, orte, beitraege] = await Promise.all([
  sucheTermine({ von: h, bis: we.bis, limit: 200 }),
  listeOrte(),
  // Neueste Beiträge mit Fotos (Issue #352)
  holeBeitraege({ limit: 3 }),
]);
// Nichts bis Sonntag? Dann die nächsten Termine überhaupt (#104)
const spaeter =
  jetzt.termine.length === 0
    ? (await sucheTermine({ von: plusTage(we.bis, 1), limit: 5 })).termine
    : [];
const kreise = (Object.keys(LANDKREISE) as LandkreisKuerzel[])
  .map((k) => ({
    k,
    n: orte.filter((o) => o.landkreis === k).reduce((s, o) => s + o.anzahlKommend, 0),
  }))
  .sort((a, b) => kreisKurz(a.k).localeCompare(kreisKurz(b.k), 'de'));
const jahr = h.slice(0, 4);
Astro.response.headers.set('Cache-Control', 'public, max-age=300');
import Ornament from '../components/Ornament.astro';
---

<Base
  title={`Kirmes in Thüringen ${jahr} – Termine für Kirmestanz, Kindertanz & mehr`}
  description={`Wann ist wo Kirmes? Termine der Kirmesgesellschaften aus ganz Thüringen – nach Ort und Landkreis, mit Anfahrt und Kalender-Abo.`}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'Kirmeskalender Thüringen',
      // Seitenname in der Google-Suche statt der Domain (Issue #305)
      alternateName: ['Kirmeskalender', 'Kirmes Thüringen'],
      url: Astro.site,
      potentialAction: {
        '@type': 'SearchAction',
        target: new URL('/termine?q={suche}', Astro.site).href,
        'query-input': 'required name=suche',
      },
    },
    ...jetzt.termine.slice(0, 30).map((t) => eventJsonLd(t, Astro.site!)),
  ]}
>
  <section class="einstieg">
    <h1 class="mit-ornament">
      Kirmes in{' '}
      <span class="mit-baum">
        Thüringen
        <Ornament />
      </span>
    </h1>
    <p class="unterzeile">
      Wann ist wo Kirmes? Die Termine der Kirmesgesellschaften aus ganz Thüringen – vom Kirmestanz
      bis zur Kirmesbeerdigung.
    </p>
    <form class="suchzeile" action="/termine" method="get" role="search">
      <input
        name="q"
        type="search"
        aria-label="Ort, Band oder Veranstaltung"
        placeholder="Ort oder Band"
      />
      <button class="knopf" type="submit">
        <Icon name="suche" />
        Suchen
      </button>
    </form>
    {/* App-Kacheln (Issue #356) */}
    <ul class="app-kacheln">
      <li>
        <a href="/termine#nahe-knopf">
          <Icon name="standort" />
          In meiner Nähe
        </a>
      </li>
      <li>
        <a href="/gemerkt">
          <Icon name="stern" />
          Gemerkt
        </a>
      </li>
      <li>
        <a href="/karte">
          <Icon name="karte" />
          Karte
        </a>
      </li>
      <li>
        <a href="/termin-melden">
          <Icon name="stift" />
          Termin melden
        </a>
      </li>
    </ul>
  </section>

  <div class="zweispaltig">
    <div>
      <h2>{wochenendeSchon ? 'Dieses Wochenende' : 'Diese Woche & am Wochenende'}</h2>
      <TerminListe termine={jetzt.termine} monate={false} leer={false} />
      {jetzt.termine.length === 0 && (
        <KeineTreffer
          text={
            wochenendeSchon
              ? 'An diesem Wochenende ist keine Kirmes eingetragen.'
              : 'Bis Sonntag ist keine Kirmes eingetragen.'
          }
          naechste={spaeter}
        />
      )}
      <a class="knopf alle-termine" href="/termine">
        Alle Termine <Icon name="pfeil" />
      </a>
      {beitraege.length > 0 && (
        <section class="start-neuigkeiten" aria-labelledby="neu-titel">
          <h2 id="neu-titel">Neu von den Kirmesgesellschaften</h2>
          <BeitragListe beitraege={beitraege} ebene="h3" />
          <a class="mehr" href="/neuigkeiten">
            Alle Neuigkeiten <Icon name="pfeil" />
          </a>
        </section>
      )}
    </div>

    <aside class="seitenleiste">
      <h2>Nach Landkreis</h2>
      <ul class="kreisliste">
        {kreise.map((x) => (
          <li class:list={[{ 'ohne-termine': x.n === 0 }]}>
            <a href={`/kreise/${kreisSlug(x.k)}`}>{kreisKurz(x.k)}</a>
            {x.n > 0 && <span class="n">{x.n}</span>}
          </li>
        ))}
      </ul>
      {/* Am Handy nur Kreise mit Terminen – alle 23 unter „Landkreise“ (Issue #265) */}
      <a class="mehr alle-kreise" href="/kreise">
        Alle {kreise.length} Landkreise <Icon name="pfeil" />
      </a>

      <h2>Immer aktuell im eigenen Kalender</h2>
      <p>
        Alle kommenden Termine als Kalender-Abo für Handy, Outlook oder Google Kalender – neue
        Termine erscheinen automatisch.
      </p>
      <a class="knopf zweit" href="/kalender-abonnieren">
        <Icon name="abo" />
        Kalender abonnieren
      </a>

      <div class="kasten abstand">
        <h2>Ihr seid Kirmesgesellschaft?</h2>
        <p>Schickt uns eure Termine – oder bestätigt, dass sie stimmen.</p>
        <a class="mehr" href="/termin-melden">
          Termin melden <Icon name="pfeil" />
        </a>
        <p>
          Lieber selbst pflegen? Mit einem eigenen Zugang für euren Ort haltet ihr Termine, Programm
          und Festplatz auf der Karte jederzeit aktuell.
        </p>
        <a class="mehr" href="/redaktion-mitmachen">
          Eigenen Zugang anfragen <Icon name="pfeil" />
        </a>
      </div>
    </aside>
  </div>
</Base>

<style>
  .alle-termine {
    margin-top: 24px;
  }
  .seitenleiste .alle-kreise {
    display: none;
  }
  @media (max-width: 900px) {
    .kreisliste .ohne-termine {
      display: none;
    }
    .seitenleiste .alle-kreise {
      display: inline-flex;
      margin: 4px 0 16px;
    }
  }
</style>
