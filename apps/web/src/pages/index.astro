---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import TerminListe from '../components/TerminListe.astro';
import { listeOrte, sucheTermine } from '../lib/api';
import {
  LANDKREISE,
  eventJsonLd,
  heute,
  kreisKurz,
  kreisSlug,
  plusTage,
  wochenende,
} from '../lib/anzeige';
import type { LandkreisKuerzel } from '@kirmes/core';

const h = heute();
const we = wochenende(h);
const [amWochenende, danach, orte] = await Promise.all([
  sucheTermine({ ...we, limit: 200 }),
  sucheTermine({ von: plusTage(we.bis, 1), bis: plusTage(we.bis, 14), limit: 40 }),
  listeOrte(),
]);
const kreise = (Object.keys(LANDKREISE) as LandkreisKuerzel[])
  .map((k) => ({
    k,
    n: orte.filter((o) => o.landkreis === k).reduce((s, o) => s + o.anzahlKommend, 0),
  }))
  .sort((a, b) => kreisKurz(a.k).localeCompare(kreisKurz(b.k), 'de'));
const jahr = h.slice(0, 4);
Astro.response.headers.set('Cache-Control', 'public, max-age=300');
---

<Base
  title={`Kirmes in Thüringen ${jahr} – Termine für Kirmestanz, Kindertanz & mehr`}
  description={`Wann ist wo Kirmes? Termine der Kirmesgesellschaften aus ganz Thüringen – nach Ort und Landkreis, mit Anfahrt und Kalender-Abo.`}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'Kirmeskalender Thüringen',
      url: Astro.site,
      potentialAction: {
        '@type': 'SearchAction',
        target: new URL('/termine?q={suche}', Astro.site).href,
        'query-input': 'required name=suche',
      },
    },
    ...amWochenende.termine.slice(0, 30).map((t) => eventJsonLd(t, Astro.site!)),
  ]}
>
  <section class="einstieg">
    <h1>Kirmes in Thüringen</h1>
    <p class="unterzeile">
      Wann ist wo Kirmes? Die Termine der Kirmesgesellschaften aus ganz Thüringen – vom Kirmestanz
      bis zur Kirmesbeerdigung.
    </p>
    <form class="suchzeile" action="/termine" method="get" role="search">
      <input
        name="q"
        type="search"
        aria-label="Ort, Band oder Veranstaltung"
        placeholder="Ort oder Band"
      />
      <button class="knopf" type="submit"><Icon name="suche" />Suchen</button>
    </form>
  </section>

  <div class="zweispaltig">
    <div>
      <h2>Dieses Wochenende</h2>
      <TerminListe termine={amWochenende.termine} monate={false} />
      {
        danach.termine.length > 0 && (
          <>
            <h2>Die zwei Wochen danach</h2>
            <TerminListe termine={danach.termine} monate={false} hinweis={false} />
            <a class="mehr" href={`/termine?von=${plusTage(we.bis, 1)}`}>
              Alle weiteren Termine <Icon name="pfeil" />
            </a>
          </>
        )
      }
    </div>

    <aside class="seitenleiste">
      <h2>Nach Landkreis</h2>
      <ul class="kreisliste">
        {
          kreise.map((x) => (
            <li>
              <a href={`/kreise/${kreisSlug(x.k)}`}>{kreisKurz(x.k)}</a>
              {x.n > 0 && <span class="n">{x.n}</span>}
            </li>
          ))
        }
      </ul>

      <h2>Immer aktuell im eigenen Kalender</h2>
      <p>
        Alle kommenden Termine als Kalender-Abo für Handy, Outlook oder Google Kalender – neue
        Termine erscheinen automatisch.
      </p>
      <a class="knopf zweit" href="/kalender-abonnieren"><Icon name="abo" />Kalender abonnieren</a>

      <div class="kasten abstand">
        <h2>Ihr seid Kirmesgesellschaft?</h2>
        <p>
          Schickt uns eure Termine – oder bestätigt, dass sie stimmen. Auf Wunsch tragt ihr euren
          Festplatz selbst auf der Karte ein, damit Gäste direkt hinfinden.
        </p>
        <a class="mehr" href="/termin-melden">Termin melden <Icon name="pfeil" /></a>
      </div>
    </aside>
  </div>
</Base>
