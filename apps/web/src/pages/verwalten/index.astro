---
/**
 * Bearbeitungsseite für Kirmesgesellschaften. Zugang nur über den persönlichen Link
 * (…/verwalten#k=TOKEN). Das Token steht im URL-Fragment, wird also nie an Server oder Logs
 * übertragen, sondern nur per JavaScript im Authorization-Header mitgeschickt.
 */
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Endzeit from '../../components/admin/Endzeit.astro';
import { KATEGORIEN } from '../../lib/anzeige';
---

<Base
  title="Eure Kirmes verwalten – Kirmeskalender Thüringen"
  description="Bearbeitung für Kirmesgesellschaften."
  noindex
>
  <section class="einstieg">
    <h1 id="titel">Eure Kirmes verwalten</h1>
    <p class="unterzeile" id="untertitel">
      Einen Moment, der Link wird geprüft …
    </p>
  </section>

  <p class="meldung" id="meldung" role="status" hidden></p>

  <div id="bereich" hidden>
    <!-- ── Termine ─────────────────────────────────────────────────────────── -->
    <section aria-labelledby="h-termine">
      <h2 id="h-termine">Eure Termine</h2>
      <p class="leise">
        Was ihr hier eintragt, erscheint sofort im Kalender und gilt als vom Veranstalter bestätigt.
        Termine, die wir aus Ankündigungen übernommen haben, könnt ihr mit einem Klick bestätigen.
      </p>
      <ul class="eintraege" id="terminliste"></ul>
      <p class="leer" id="keine-termine" hidden>
        Noch keine Termine eingetragen.
      </p>

      <h3 id="formular-titel">Termin hinzufügen</h3>
      <form class="melden" id="terminformular" method="post" data-ungespeichert>
        <div class="zwei">
          <label>
            Datum *<input name="datum" type="date" required />
          </label>
          <label>
            Beginn
            <input name="beginn" type="time" />
          </label>
        </div>
        <Endzeit ende="" />
        <label>
          Veranstaltung *
          <input name="titel" required maxlength="200" placeholder="z. B. Kirmestanz" />
        </label>
        <div class="zwei">
          <label>
            Wo genau?
            <input
              name="veranstaltungsort"
              maxlength="120"
              list="orte-liste"
              placeholder="z. B. Festzelt, Kulturhaus"
            />
          </label>
          <label>
            Art
            <select name="kategorie">
              <option value="">automatisch erkennen</option>
              {Object.entries(KATEGORIEN).map(([k, v]) => (
                <option value={k}>{v.label}</option>
              ))}
            </select>
          </label>
        </div>
        <div class="zwei">
          <label>
            Band / DJ
            <input name="band" maxlength="120" placeholder="z. B. Band, DJ – mehrere mit Komma" />
          </label>
          <label>
            Hinweise
            <textarea
              name="info"
              maxlength="500"
              rows="2"
              placeholder="z. B. Eintritt 8 €, Einlass ab 16"
            ></textarea>
          </label>
        </div>
        <label class="klein">
          <input type="checkbox" name="muttizettel" value="ja" /> Unter 18 nur mit Muttizettel – wir
          bieten am Termin eine Vorlage zum Drucken an
        </label>
        <datalist id="orte-liste"></datalist>
        <div class="knopfreihe">
          <button class="knopf" type="submit" id="termin-speichern">
            Termin speichern
          </button>
          <button class="knopf zweit" type="button" id="termin-abbrechen" hidden>
            Abbrechen
          </button>
        </div>
      </form>
    </section>

    <!-- ── Festplätze ──────────────────────────────────────────────────────── -->
    <section aria-labelledby="h-plaetze">
      <h2 id="h-plaetze">Festplätze auf der Karte</h2>
      <p class="leise">
        Damit „Route“ eure Gäste direkt zum Festzelt, Saal oder Sportplatz führt. Der{' '}
        <strong>Standard-Festplatz</strong> gilt für alle Termine ohne eigenen Platz.
      </p>
      <ul class="eintraege" id="plaetze"></ul>

      <div id="editor" hidden>
        <h3>
          Pin setzen für: <span id="aktuell"></span>
        </h3>
        <form class="suchzeile" id="adresssuche">
          <input
            type="search"
            id="adresse"
            placeholder="Adresse suchen, z. B. Hauptstraße 1"
            aria-label="Adresse suchen"
          />
          <button class="knopf zweit" type="submit">
            <Icon name="suche" />
            Suchen
          </button>
        </form>
        <div
          class="karte"
          id="karte"
          role="application"
          aria-label="Karte – klicken, um den Pin zu setzen"
        ></div>
        <div class="knopfreihe">
          <button class="knopf zweit" type="button" id="standort">
            <Icon name="standort" />
            Meinen Standort verwenden
          </button>
          <input
            id="einfuegen"
            placeholder="Google-Maps-Link oder „50.87, 10.82“ einfügen"
            aria-label="Koordinaten oder Kartenlink einfügen"
          />
        </div>
        <p class="leise klein" id="koordinate">
          Noch kein Pin gesetzt.
        </p>
        <div class="knopfreihe">
          <button class="knopf" type="button" id="speichern" disabled>
            Festplatz speichern
          </button>
          <button class="knopf zweit" type="button" id="entfernen" hidden>
            Eintrag entfernen
          </button>
        </div>
      </div>
    </section>

    <p class="klein leise abstand-oben">
      Jede Änderung wird mit Datum gespeichert. Gebt den Link bitte nicht weiter – bei Bedarf
      sperren wir ihn und schicken euch einen neuen. Änderungen sind nach wenigen Minuten auf allen
      Seiten sichtbar.
    </p>
  </div>
</Base>

<script>
  import '../../scripts/verwalten';
</script>

<style is:global>
  .pin span {
    display: block;
    width: 28px;
    height: 28px;
    background: var(--rot);
    border: 3px solid #fff;
    border-radius: 50% 50% 50% 0;
    transform: rotate(-45deg);
    box-shadow: 0 2px 6px rgb(0 0 0 / 0.35);
  }
  #plaetze .eintrag,
  #terminliste .eintrag {
    align-items: center;
  }
  #terminliste .knopf {
    padding: 8px 12px;
    font-size: 0.9rem;
  }
  #einfuegen {
    flex: 1;
    min-width: 220px;
  }
  .abstand-oben {
    margin-top: 40px;
  }
  @media (max-width: 600px) {
    #terminliste .knopfreihe {
      grid-column: 1 / -1;
    }
  }
</style>
