---
/**
 * Kartenansicht: alle Orte mit kommenden Kirmes-Terminen auf einer OpenStreetMap-Karte.
 * Die Karte ist eine Ergänzung – darunter steht immer die Liste, falls Kacheln oder JavaScript fehlen.
 */
import Base from '../layouts/Base.astro';
import { alleTermine, listeOrte } from '../lib/api';
import { heute, kreisKurz, plusTage, wochenende } from '../lib/anzeige';

// Zeitfilter (Issue #109) – als Links, funktioniert auch ohne JavaScript
const ZEITEN = [
  ['wochenende', 'Dieses Wochenende', 'dieses Wochenende'],
  ['4wochen', 'Nächste 4 Wochen', 'in den nächsten 4 Wochen'],
  ['alle', 'Alle kommenden', 'mit kommenden Terminen'],
] as const;
type Zeit = (typeof ZEITEN)[number][0];
const zeitRoh = Astro.url.searchParams.get('zeit');
const zeit: Zeit = ZEITEN.some(([k]) => k === zeitRoh) ? (zeitRoh as Zeit) : 'alle';
const h = heute();
const bereich =
  zeit === 'wochenende'
    ? wochenende(h)
    : zeit === '4wochen'
      ? { von: h, bis: plusTage(h, 28) }
      : null;

const alleOrte = await listeOrte();
const anzahl = new Map<string, number>();
if (bereich)
  for (const t of await alleTermine(bereich))
    anzahl.set(t.ort.slug, (anzahl.get(t.ort.slug) ?? 0) + 1);
const orte = alleOrte
  .map((o) => ({ ...o, n: bereich ? (anzahl.get(o.slug) ?? 0) : o.anzahlKommend }))
  .filter((o) => o.n > 0 && o.koordinate)
  .sort((a, b) => a.name.localeCompare(b.name, 'de'));
const punkte = orte.map((o) => ({
  s: o.slug,
  n: o.name,
  a: o.n,
  lat: o.koordinate!.lat,
  lon: o.koordinate!.lon,
}));
const [, zeitText, zeitSatz] = ZEITEN.find(([k]) => k === zeit) ?? ZEITEN[2];
Astro.response.headers.set('Cache-Control', 'public, max-age=300');
---

<Base
  title="Kirmes-Karte Thüringen – Kirmes in deiner Nähe"
  description="Karte aller Thüringer Orte mit kommenden Kirmes-Terminen – finde die Kirmes in deiner Nähe."
>
  <section class="einstieg">
    <h1>Kirmes in deiner Nähe</h1>
    <p class="unterzeile">
      {
        orte.length === 0
          ? `${zeitText}: keine Termine eingetragen.`
          : `${orte.length} ${orte.length === 1 ? 'Ort' : 'Orte'} – ${zeitSatz}. Punkt antippen für die Termine.`
      }
    </p>
  </section>

  <div class="kartenleiste">
    <nav class="zeitwahl" aria-label="Zeitraum">
      {
        ZEITEN.map(([k, text]) => (
          <a
            href={k === 'alle' ? '/karte' : `/karte?zeit=${k}`}
            aria-current={zeit === k ? 'page' : undefined}
          >
            {text}
          </a>
        ))
      }
    </nav>
    <button class="knopf zweit" type="button" id="standort">In meiner Nähe</button>
  </div>
  <p class="klein leise" id="standort-hinweis" role="status"></p>

  <div id="karte" class="karte gross" data-punkte={JSON.stringify(punkte)}></div>
  <p class="leise klein" id="karte-hinweis" hidden>
    Die Karte konnte nicht geladen werden – hier die Liste.
  </p>

  <section aria-labelledby="h-liste">
    <h2 id="h-liste">Orte {zeitSatz}</h2>
    {
      orte.length === 0 ? (
        <p class="leer">
          {zeit !== 'alle' && (
            <>
              <a href="/karte">Alle kommenden Termine zeigen</a> ·{' '}
            </>
          )}
          <a href="/termin-melden">Kirmes melden</a>
        </p>
      ) : (
        <ul class="ortliste" id="ortliste">
          {orte.map((o) => (
            <li data-lat={o.koordinate!.lat} data-lon={o.koordinate!.lon}>
              <a href={`/orte/${o.slug}`}>{o.name}</a>
              <span class="kz">{kreisKurz(o.landkreis)}</span>
              <span class="leise klein">
                {' · '}
                {o.n} {o.n === 1 ? 'Termin' : 'Termine'}
              </span>
              <span class="entfernung klein" />
            </li>
          ))}
        </ul>
      )
    }
  </section>
</Base>

<script>
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';

  interface Punkt {
    s: string;
    n: string;
    a: number;
    lat: number;
    lon: number;
  }
  const el = document.getElementById('karte');
  const punkte = JSON.parse(el?.dataset.punkte ?? '[]') as Punkt[];
  // Karte immer zeigen – auch ohne Termine sieht man Thüringen (Issue #53).
  // Der Platz ist von Anfang an reserviert (Issue #123), daher kein hidden mehr.
  if (el) {
    const karte = L.map(el, { scrollWheelZoom: false }).setView([50.9, 11.0], 8);
    const kacheln = L.tileLayer('/kacheln/{z}/{x}/{y}.png', {
      maxZoom: 18,
      attribution:
        '© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>-Mitwirkende',
    }).addTo(karte);
    let fehler = 0;
    kacheln.on('tileerror', () => {
      if (++fehler === 3) {
        el.hidden = true;
        document.getElementById('karte-hinweis')!.hidden = false;
      }
    });
    const farbe =
      getComputedStyle(document.documentElement).getPropertyValue('--rot').trim() || '#a5161c';
    const grenzen: L.LatLngTuple[] = [];
    for (const p of punkte) {
      // Inhalt per DOM, nie als HTML-Text – Ortsnamen kommen aus der Datenbank
      const inhalt = document.createElement('div');
      const link = document.createElement('a');
      link.href = `/orte/${encodeURIComponent(p.s)}`;
      link.textContent = p.n;
      const anzahl = document.createElement('div');
      anzahl.textContent = `${p.a} ${p.a === 1 ? 'Termin' : 'Termine'}`;
      inhalt.append(link, anzahl);
      L.circleMarker([p.lat, p.lon], {
        radius: 7 + Math.min(p.a, 6),
        color: '#fff',
        weight: 2,
        fillColor: farbe,
        fillOpacity: 0.9,
      })
        .bindPopup(inhalt)
        .bindTooltip(p.n)
        .addTo(karte);
      grenzen.push([p.lat, p.lon]);
    }
    // Immer Thüringen im Blick behalten – nie ins einzelne Dorf zoomen (Issue #109)
    if (grenzen.length > 1) karte.fitBounds(grenzen, { padding: [30, 30], maxZoom: 9 });

    // „In meiner Nähe“: Standort erst nach Klick; bleibt im Browser
    const knopf = document.getElementById('standort') as HTMLButtonElement | null;
    const hinweis = document.getElementById('standort-hinweis');
    if (knopf && !('geolocation' in navigator)) knopf.hidden = true;
    if (knopf && 'geolocation' in navigator) {
      let ich: L.CircleMarker | null = null;
      knopf.addEventListener('click', () => {
        knopf.disabled = true;
        if (hinweis) hinweis.textContent = 'Standort wird ermittelt …';
        navigator.geolocation.getCurrentPosition(
          ({ coords }) => {
            knopf.disabled = false;
            const hier: L.LatLngTuple = [coords.latitude, coords.longitude];
            ich?.remove();
            ich = L.circleMarker(hier, {
              radius: 8,
              color: '#fff',
              weight: 3,
              fillColor: '#1f6a8a',
              fillOpacity: 1,
            })
              .bindTooltip('Du bist hier')
              .addTo(karte);
            karte.setView(hier, 10);
            const liste = document.getElementById('ortliste');
            if (!liste) {
              if (hinweis) hinweis.textContent = '';
              return;
            }
            const eintraege = [...liste.querySelectorAll<HTMLLIElement>('li')].map((li) => ({
              li,
              km: karte.distance(hier, [Number(li.dataset.lat), Number(li.dataset.lon)]) / 1000,
            }));
            eintraege.sort((a, b) => a.km - b.km);
            for (const { li, km } of eintraege) {
              const e = li.querySelector('.entfernung');
              if (e)
                e.textContent = ` · ${km < 10 ? km.toFixed(1).replace('.', ',') : Math.round(km)} km`;
              liste.append(li);
            }
            liste.classList.add('nach-entfernung');
            if (hinweis) hinweis.textContent = 'Liste nach Entfernung sortiert.';
          },
          () => {
            knopf.disabled = false;
            if (hinweis)
              hinweis.textContent =
                'Standort nicht verfügbar – bitte im Browser erlauben oder die Karte selbst verschieben.';
          },
          { enableHighAccuracy: false, timeout: 10_000, maximumAge: 300_000 },
        );
      });
    }
  }
</script>
<style>
  .kartenleiste {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin: 0 0 12px;
  }
  .zeitwahl {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .zeitwahl a {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    padding: 0 14px;
    border: 1px solid var(--linie);
    border-radius: 999px;
    text-decoration: none;
    color: var(--tinte);
    font-weight: 600;
  }
  .zeitwahl a[aria-current] {
    background: var(--rot);
    border-color: var(--rot);
    color: var(--papier);
  }
  .nach-entfernung {
    columns: 1;
  }
</style>
