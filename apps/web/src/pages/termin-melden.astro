---
export const prerender = true;
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';

// TODO: echte Kontaktadresse eintragen
const KONTAKT = 'termine@kirmeskalender-thueringen.de';
---

<Base
  title="Kirmes-Termin melden – Kirmeskalender Thüringen"
  description="Kirmesgesellschaften und Veranstalter melden hier kostenlos ihre Kirmes-Termine in Thüringen."
>
  <section class="einstieg">
    <h1>Termin melden</h1>
    <p class="unterzeile">
      Für Kirmesgesellschaften, Vereine und Veranstalter – kostenlos. Neue Termine, Korrekturen oder
      einfach die Bestätigung, dass ein Termin stimmt: Alles hilft.
    </p>
    <p>
      Am schnellsten geht es mit dem Formular. Es öffnet euer E-Mail-Programm mit einer fertigen
      Nachricht. Ihr könnt auch direkt schreiben an <a href={`mailto:${KONTAKT}`}>{KONTAKT}</a>.
    </p>
  </section>
  <form class="melden" id="melden" data-kontakt={KONTAKT}>
    <div class="zwei">
      <label>Ort *<input name="ort" required placeholder="z. B. Mühlberg" /></label>
      <label>Landkreis<input name="kreis" placeholder="z. B. Gotha" /></label>
    </div>
    <div class="zwei">
      <label>Datum *<input name="datum" type="date" required /></label>
      <label>Uhrzeit<input name="zeit" type="time" /></label>
    </div>
    <label
      >Veranstaltung *<input
        name="titel"
        required
        placeholder="z. B. Kirmestanz mit „Band XY“"
      /></label
    >
    <label
      >Veranstaltungsort<input
        name="location"
        placeholder="z. B. Festzelt, Kulturhaus, Saal"
      /></label
    >
    <label
      >Weitere Infos<textarea
        name="info"
        rows="4"
        placeholder="Programm, Eintritt, Link zur Kirmesgesellschaft …"></textarea></label
    >
    <label>Dein Name / Kirmesgesellschaft *<input name="absender" required /></label>
    <p class="klein leise">
      Beim Absenden öffnet sich dein E-Mail-Programm mit einer vorbereiteten Nachricht an {KONTAKT}.
      Wir prüfen jede Meldung vor der Veröffentlichung.
    </p>
    <div><button type="submit">Termin senden</button></div>
  </form>

  <section class="lesetext" id="festplatz">
    <h2>Festplatz auf der Karte eintragen</h2>
    <p>
      Jeder Termin hat einen Knopf „Route“, der Google Maps oder Apple Karten öffnet. Ohne genaue
      Angabe führt er nur in den Ort. Damit eure Gäste direkt am Festzelt, Saal oder Sportplatz
      ankommen, könnt ihr den Platz selbst eintragen:
    </p>
    <ol>
      <li>Schreibt uns, für welchen Ort ihr zuständig seid.</li>
      <li>Ihr bekommt einen persönlichen Link – ohne Anmeldung und ohne Passwort.</li>
      <li>
        Über den Link setzt ihr den Pin auf der Karte, gebt die Adresse ein oder nutzt direkt vor
        Ort euren Handy-Standort.
      </li>
    </ol>
    <p>
      <a
        class="knopf zweit"
        href={`mailto:${KONTAKT}?subject=${encodeURIComponent('Link für den Festplatz')}`}
        ><Icon name="ort" />Link anfordern</a
      >
    </p>
  </section>
</Base>

<script>
  const form = document.getElementById('melden') as HTMLFormElement;
  const KONTAKT = form.dataset.kontakt ?? '';
  const ort = new URLSearchParams(location.search).get('ort');
  if (ort) (form.elements.namedItem('ort') as HTMLInputElement).value = ort;
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const f = Object.fromEntries(new FormData(form));
    const body = [
      `Ort: ${f.ort}${f.kreis ? ` (${f.kreis})` : ''}`,
      `Datum: ${f.datum}${f.zeit ? `, ${f.zeit} Uhr` : ''}`,
      `Veranstaltung: ${f.titel}`,
      f.location && `Veranstaltungsort: ${f.location}`,
      f.info && `Infos: ${f.info}`,
      `Gemeldet von: ${f.absender}`,
    ]
      .filter(Boolean)
      .join('\n');
    location.href = `mailto:${KONTAKT}?subject=${encodeURIComponent(`Kirmes-Termin: ${f.ort} ${f.datum}`)}&body=${encodeURIComponent(body)}`;
  });
</script>
