---
/**
 * Termin melden: Assistent ohne Anmeldung, die Redaktion prüft jeden Vorschlag. Der frühere
 * „Festplatz-Link anfordern“ entfällt (Issue #229) – dauerhaft pflegen geht über „Mitmachen“.
 */
import KirmesAssistent from '../components/KirmesAssistent.astro';
import { assistent } from '../lib/assistent';
import { listeOrte, eingabeVorschlaege } from '../lib/api';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { FORMULAR_COOKIE, csrfToken } from '../lib/csrf';

Astro.response.headers.set('Cache-Control', 'no-store');
const csrf = csrfToken(Astro.cookies, { cookie: FORMULAR_COOKIE, pfad: '/termin-melden' });
const stand = await assistent(Astro, false);
if (stand instanceof Response) return stand;
const [orte, vorschlaege] = await Promise.all([listeOrte(), eingabeVorschlaege()]);
---

<Base
  title="Kirmes-Termin melden – Kirmeskalender Thüringen"
  description="Kirmesgesellschaften und Veranstalter melden hier kostenlos ihre Kirmes-Termine in Thüringen."
>
  <section class="einstieg">
    <h1>Termin melden</h1>
    <p class="unterzeile">
      Eure Kirmes fehlt? Schlagt einen Termin oder das ganze Programm vor – kostenlos und ohne
      Anmeldung. Die Redaktion prüft die Angaben vor der Veröffentlichung.
    </p>
  </section>

  {/* Hinweis aufs Mitmachen (Issue #252) – oben, nur vor dem Assistenten; alte Links auf #festplatz landen hier */}
  {stand.schritt === 1 && !Astro.url.searchParams.has('gesendet') && (
    <aside id="festplatz" class="kasten mitmachen-hinweis">
      <p>
        <strong>Noch nicht dabei mit eurer Kirmesgesellschaft?</strong>
        <a class="mehr" href="/redaktion-mitmachen">
          Mit eigenem Zugang mitmachen <Icon name="pfeil" />
        </a>
      </p>
      <p>
        <strong>Du willst Teil der Redaktion werden?</strong>
        <a class="mehr" href="/redaktion-mitmachen#redaktion">
          In der Redaktion mitmachen <Icon name="pfeil" />
        </a>
      </p>
    </aside>
  )}

  {Astro.url.searchParams.has('gesendet') ? (
    <>
      <p class="meldung erfolg" role="status">
        Danke! Dein Vorschlag ist angekommen. Die Redaktion prüft ihn vor der Veröffentlichung.
      </p>
      <aside class="kasten mitmachen-hinweis">
        <p>
          <strong>Noch nicht dabei mit eurer Kirmesgesellschaft?</strong> Dann macht gerne mit: Mit
          einem eigenen Zugang tragt ihr eure Kirmes beim nächsten Mal direkt selbst ein – sofort
          sichtbar und als „bestätigt“ markiert.
        </p>
        <p>
          <strong>Du willst Teil der Redaktion werden?</strong> Hilf mit, die Kirmes in deiner
          Gegend aktuell zu halten.
        </p>
        <div class="weiter-knoepfe">
          <a class="knopf" href="/redaktion-mitmachen">
            Mit eurer Kirmesgesellschaft mitmachen
          </a>
          <a class="knopf zweit" href="/redaktion-mitmachen#redaktion">
            In der Redaktion mitmachen
          </a>
        </div>
      </aside>
      <div class="weiter-knoepfe">
        <a class="knopf" href="/termin-melden">
          Weitere Kirmes melden
        </a>
        <a class="knopf zweit" href="/termine">
          Zu den Terminen
        </a>
      </div>
    </>
  ) : (
    <KirmesAssistent
      stand={stand}
      csrf={csrf}
      orte={orte}
      bands={vorschlaege.bands}
      titel={vorschlaege.titel}
    />
  )}
</Base>
<style>
  .mitmachen-hinweis {
    border-left: 4px solid var(--rot);
    margin: 0 0 24px;
  }
  .mitmachen-hinweis .mehr {
    display: flex;
    gap: 6px;
    width: fit-content;
  }
  .mitmachen-hinweis p {
    margin: 0;
  }
  .mitmachen-hinweis p + p {
    margin-top: 10px;
  }
  .weiter-knoepfe {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 16px 0 32px;
  }
</style>
