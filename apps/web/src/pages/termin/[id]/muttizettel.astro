---
import Base from '../../../layouts/Base.astro';
import Muttizettel from '../../../components/Muttizettel.astro';
import { findeTermin } from '../../../lib/api';
import { datumLangJahr } from '../../../lib/anzeige';

const t = await findeTermin(Astro.params.id ?? '');
if (!t) return Astro.rewrite('/404');
Astro.response.headers.set('Cache-Control', 'public, max-age=300');
---

<Base
  title={`Muttizettel für ${t.titel} in ${t.ort.name} am ${datumLangJahr(t.datum)}`}
  description={`Vorlage Erziehungsbeauftragung (Muttizettel) für ${t.titel} in ${t.ort.name} – vorausgefüllt zum Drucken.`}
  noindex
>
  <p class="brotkrumen">
    <a href={`/orte/${t.ort.slug}`}>{t.ort.name}</a> ›<a href={`/termin/${t.id}`}>{t.titel}</a>
  </p>
  <Muttizettel termin={t} />
</Base>
