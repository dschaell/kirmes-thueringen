---
/**
 * „Mehr“ als eigene Seite (Issue #374) statt Aufklapp-Menü: alle weiteren Ziele, Schriftgröße und
 * Design auf einen Blick – gruppiert wie die Einstellungen am iPhone.
 */
import Base from '../layouts/Base.astro';
import DesignSchalter from '../components/DesignSchalter.astro';
import Icon from '../components/Icon.astro';
import SchriftSchalter from '../components/SchriftSchalter.astro';
import { UNTERSTUETZEN_URL } from '../lib/anzeige';

type Eintrag = {
  href: string;
  text: string;
  icon: Parameters<typeof Icon>[0]['name'];
  extern?: boolean;
};
const gruppen: { titel: string; eintraege: Eintrag[] }[] = [
  {
    titel: 'Entdecken',
    eintraege: [
      { href: '/termine?zeit=wochenende', text: 'Dieses Wochenende', icon: 'kalender' },
      { href: '/gemerkt', text: 'Gemerkte Termine', icon: 'stern' },
      { href: '/neuigkeiten', text: 'Neuigkeiten & Fotos', icon: 'foto' },
      { href: '/orte', text: 'Orte A–Z', icon: 'ort' },
      { href: '/kreise', text: 'Landkreise', icon: 'karte' },
    ],
  },
  {
    titel: 'Für die Kirmes',
    eintraege: [
      { href: '/kalender-abonnieren', text: 'Kalender abonnieren', icon: 'abo' },
      { href: '/muttizettel', text: 'Muttizettel-Vorlage', icon: 'dokument' },
      { href: '/ueber-die-kirmes', text: 'Über die Kirmes', icon: 'info' },
    ],
  },
  {
    titel: 'Mitmachen',
    eintraege: [
      { href: '/termin-melden', text: 'Termin melden', icon: 'stift' },
      {
        href: '/redaktion-mitmachen',
        text: 'Mitmachen (Kirmesgesellschaften & Redaktion)',
        icon: 'glocke',
      },
    ],
  },
  {
    titel: 'Rechtliches & Unterstützen',
    eintraege: [
      { href: UNTERSTUETZEN_URL, text: 'Mit PayPal unterstützen', icon: 'teilen', extern: true },
      { href: '/impressum', text: 'Impressum', icon: 'info' },
      { href: '/datenschutz', text: 'Datenschutz', icon: 'dokument' },
    ],
  },
];
Astro.response.headers.set('Cache-Control', 'public, max-age=3600');
---

<Base
  title="Mehr – Kirmeskalender Thüringen"
  description="Alle Seiten, Schriftgröße und Design."
  noindex
>
  <section class="einstieg">
    <h1>Mehr</h1>
  </section>

  <section class="mehr-anmelden" aria-labelledby="mehr-anmelden">
    <h2 id="mehr-anmelden">Kirmesgesellschaft oder Redaktion?</h2>
    <p>Termine, Beiträge und Fotos für euren Ort pflegen.</p>
    <a class="knopf" href="/admin/anmelden" rel="nofollow">
      Anmelden
    </a>
  </section>

  {gruppen.slice(0, 3).map((g) => (
    <section class="mehr-gruppe" aria-labelledby={`mehr-${g.titel}`}>
      <h2 id={`mehr-${g.titel}`}>{g.titel}</h2>
      <ul>
        {g.eintraege.map((e) => (
          <li>
            <a href={e.href} rel={e.href.startsWith('/admin') ? 'nofollow' : undefined}>
              <span class="mehr-icon" aria-hidden="true">
                <Icon name={e.icon} groesse={20} />
              </span>
              <span class="mehr-text">{e.text}</span>
              <Icon name="pfeil" groesse={18} />
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}

  <section class="mehr-gruppe mehr-darstellung" aria-labelledby="mehr-darstellung">
    <h2 id="mehr-darstellung">Darstellung</h2>
    <div class="mehr-karte">
      <SchriftSchalter id="schrift-mehr" />
      <DesignSchalter id="design-mehr" />
    </div>
  </section>

  {gruppen.slice(3).map((g) => (
    <section class="mehr-gruppe" aria-labelledby={`mehr-${g.titel}`}>
      <h2 id={`mehr-${g.titel}`}>{g.titel}</h2>
      <ul>
        {g.eintraege.map((e) => (
          <li>
            <a
              href={e.href}
              target={e.extern ? '_blank' : undefined}
              rel={e.extern ? 'noopener' : undefined}
            >
              <span class="mehr-icon" aria-hidden="true">
                <Icon name={e.icon} groesse={20} />
              </span>
              <span class="mehr-text">
                {e.text}
                {e.extern && <span class="sr-only"> (öffnet PayPal)</span>}
              </span>
              <Icon name="pfeil" groesse={18} />
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</Base>

<style>
  .einstieg {
    padding-bottom: 0;
  }
  .mehr-gruppe {
    margin: 20px 0 0;
  }
  /* Anmelden gut sichtbar (Issue #381) */
  .mehr-anmelden {
    display: grid;
    gap: 8px;
    margin: 16px 0 0;
    padding: 14px;
    border: 1px solid var(--linie);
    border-radius: 16px;
    background: var(--flaeche);
  }
  .mehr-anmelden h2 {
    margin: 0;
    font-size: 1.05rem;
  }
  .mehr-anmelden p {
    margin: 0;
    color: var(--grau);
  }
  .mehr-anmelden .knopf {
    justify-content: center;
    min-height: 48px;
  }
  .mehr-gruppe h2 {
    margin: 0 0 8px 4px;
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--grau);
  }
  .mehr-gruppe ul,
  .mehr-karte {
    margin: 0;
    padding: 0;
    list-style: none;
    border: 1px solid var(--linie);
    border-radius: 16px;
    background: var(--flaeche);
    overflow: hidden;
  }
  .mehr-gruppe li + li {
    border-top: 1px solid var(--linie);
  }
  .mehr-gruppe a {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 52px;
    padding: 8px 14px;
    color: var(--tinte);
    text-decoration: none;
    font-weight: 600;
  }
  .mehr-gruppe a:hover {
    background: var(--papier);
  }
  .mehr-text {
    flex: 1;
  }
  .mehr-icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: var(--knopf);
    color: var(--auf-knopf);
  }
  .mehr-gruppe a > :global(.icon:last-child) {
    color: var(--grau);
  }
  .mehr-karte {
    display: grid;
    gap: 16px;
    padding: 14px;
  }
</style>
