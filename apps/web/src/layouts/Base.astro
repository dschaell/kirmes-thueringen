---
import '../styles/global.css';
// Schriften vorladen: kein Springen des Layouts beim Nachladen (Issue #123)
import Icon from '../components/Icon.astro';
import { ohneSchraegstrich, UNTERSTUETZEN_URL } from '../lib/anzeige';

interface Props {
  title: string;
  description: string;
  jsonLd?: unknown[];
  /** Für Seiten, die nicht in Suchmaschinen sollen (z. B. Verwaltung) */
  noindex?: boolean;
  /** Eigenes Vorschaubild (1200×630), sonst /og.png (Issue #110) */
  bild?: string;
  /** Redaktion: schlanker Kopf ohne öffentliche Navigation (Issue #91) */
  kompakt?: boolean;
}
const {
  title,
  description,
  jsonLd = [],
  noindex = false,
  kompakt = false,
  bild = '/og.png',
} = Astro.props;
const pfad = ohneSchraegstrich(Astro.url.pathname);
const canonical = new URL(pfad, Astro.site);
const nav = [
  ['/termine', 'Termine'],
  ['/orte', 'Orte A–Z'],
  ['/karte', 'Karte'],
  ['/kreise', 'Landkreise'],
  ['/termin-melden', 'Termin melden'],
  ['/ueber-die-kirmes', 'Über die Kirmes'],
];
/** Handy (Issue #294): Leiste unten für den Daumen, der Rest unter „Mehr“ */
const unten = [
  ['/termine', 'Termine', 'kalender'],
  ['/karte', 'Karte', 'karte'],
  ['/termin-melden', 'Melden', 'stift'],
] as const;
// „Start“ nicht hier: das Logo führt zur Startseite, sonst wäre „Mehr“ dort markiert
const mehr = [
  ['/gemerkt', 'Gemerkte Termine'],
  // Beiträge mit Fotos (Issue #352)
  ['/neuigkeiten', 'Neuigkeiten'],
  ['/orte', 'Orte A–Z'],
  ['/kreise', 'Landkreise'],
  ['/kalender-abonnieren', 'Kalender abonnieren'],
  ['/ueber-die-kirmes', 'Über die Kirmes'],
  ['/redaktion-mitmachen', 'Mitmachen'],
];
const aktiv = (href: string) => (href === '/' ? pfad === '/' : pfad.startsWith(href));
/** JSON sicher in <script> einbetten: „<“ maskieren, damit kein Titel das Script-Tag beenden kann. */
const alsJsonLd = (j: unknown) => JSON.stringify(j).replace(/</g, '\\u003c');
import SchriftSchalter from '../components/SchriftSchalter.astro';
import DesignSchalter from '../components/DesignSchalter.astro';
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <script is:inline src="/einstellungen.js"></script>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <link rel="canonical" href={canonical} />
    )}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- Google-Suche bevorzugt ein Icon in Vielfachen von 48 px (Issue #276) -->
    <link rel="icon" href="/icon-192.png" sizes="192x192" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link
      rel="alternate"
      type="text/calendar"
      title="Kirmeskalender Thüringen (iCal)"
      href="/kalender.ics"
    />
    <meta name="theme-color" content="#a4161a" />
    {/* App vom Home-Bildschirm: Seite reicht bis unter die Uhr, der rote Streifen liegt darunter (Issue #363) */}
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <!-- Google Search Console (Issue #272) – öffentlich, kein Geheimnis -->
    <meta name="google-site-verification" content="DME4qv1UoCKgnUoRWc4mPl6ZZ_MMN8T_wHEMTQDY9S4" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content="Kirmeskalender Thüringen" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(bild, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd.filter(Boolean).map((j) => (
      <script type="application/ld+json" set:html={alsJsonLd(j)} />
    ))}
  </head>
  <body>
    <a class="sprung" href="#inhalt">
      Zum Inhalt springen
    </a>
    <header class:list={['kopf', { kompakt }]}>
      <div class="wrap">
        <a class="marke" href="/">
          <img src="/favicon.svg" alt="" width="36" height="36" />
          <span>
            Kirmeskalender<small>Thüringen</small>
          </span>
        </a>
        {kompakt ? (
          <nav class="nav nav-kompakt" aria-label="Hauptnavigation">
            <a href="/">Zur Website</a>
          </nav>
        ) : (
          <nav class="nav" aria-label="Hauptnavigation">
            {nav.map(([href, label]) => (
              <a href={href} aria-current={pfad.startsWith(href!) ? 'page' : undefined}>
                {label}
              </a>
            ))}
          </nav>
        )}
      </div>
    </header>
    {!kompakt && <div class="wimpel" aria-hidden="true" />}
    {!kompakt && (
      <nav class="leiste" aria-label="Schnellnavigation">
        {unten.map(([href, label, icon]) => (
          <a href={href} aria-current={aktiv(href) ? 'page' : undefined}>
            <Icon name={icon} groesse={22} />
            {label}
          </a>
        ))}
        <details class="leiste-mehr">
          <summary>
            <Icon name="menue" groesse={22} />
            Mehr
          </summary>
          <div class="leiste-menue">
            {mehr.map(([href, label]) => (
              <a href={href} aria-current={aktiv(href!) ? 'page' : undefined}>
                {label}
              </a>
            ))}
            <SchriftSchalter id="schrift-leiste" />
            <DesignSchalter id="design-leiste" />
          </div>
        </details>
      </nav>
    )}
    <main id="inhalt" class="wrap">
      <slot />
    </main>
    <footer class="fuss">
      <div class="wrap">
        <div>
          <h2>Kirmeskalender Thüringen</h2>
          <p>
            Wann ist wo Kirmes? Hier stehen die Termine der Kirmesgesellschaften aus ganz Thüringen
            – vom Kirmestanz über den Kindertanz bis zur Kirmesbeerdigung.
          </p>
          <p class="leise klein">
            Kostenlos, werbefrei und ohne Tracking. Alle Angaben ohne Gewähr – im Zweifel beim
            Veranstalter nachfragen.
          </p>
        </div>
        <div>
          <h2>Termine</h2>
          <ul>
            <li>
              <a href="/termine?zeit=wochenende">Dieses Wochenende</a>
            </li>
            <li>
              <a href="/termine">Alle Termine</a>
            </li>
            <li>
              <a href="/gemerkt">Gemerkte Termine</a>
            </li>
            <li>
              <a href="/neuigkeiten">Neuigkeiten</a>
            </li>
            <li>
              <a href="/orte">Orte A–Z</a>
            </li>
            <li>
              <a href="/kalender-abonnieren">Kalender abonnieren</a>
            </li>
            <li>
              <a href="/muttizettel">Muttizettel-Vorlage</a>
            </li>
          </ul>
        </div>
        <div>
          <h2>Für Kirmesgesellschaften</h2>
          <ul>
            <li>
              <a href="/termin-melden">Termin melden</a>
            </li>
          </ul>
        </div>
        <div>
          <h2>Mitmachen</h2>
          <ul>
            <li>
              <a href="/ueber-die-kirmes#ueber-diesen-kalender">Über diesen Kalender</a>
            </li>
            <li>
              <a href="/redaktion-mitmachen">Mitmachen (Kirmesgesellschaften &amp; Redaktion)</a>
            </li>
            <li>
              <a href={UNTERSTUETZEN_URL} target="_blank" rel="noopener">
                Mit PayPal unterstützen <span aria-hidden="true">↗</span>
                <span class="sr-only">(öffnet PayPal)</span>
              </a>
            </li>
            <li>
              <a href="/admin/anmelden" rel="nofollow">
                Anmelden (Redaktion)
              </a>
            </li>
          </ul>
        </div>
        <SchriftSchalter id="schrift-fuss" />
        <DesignSchalter id="design-fuss" />
        <div class="recht">
          <span>© {new Date().getFullYear()} Kirmeskalender Thüringen</span>
          <span>
            Ortsdaten © <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>
            -Mitwirkende · <a href="/impressum">Impressum</a> ·{' '}
            <a href="/datenschutz">Datenschutz</a>
          </span>
        </div>
      </div>
    </footer>
    <script>
      import '../scripts/formularfelder';
      import '../scripts/schrift';
      import '../scripts/ungespeichert';
      import '../scripts/entwuerfe';

      // „Mehr“ der Leiste unten (Issue #294): schließt bei Tipp daneben und mit Esc
      const leisteMehr = document.querySelector<HTMLDetailsElement>('.leiste-mehr');
      document.addEventListener('click', (e) => {
        if (leisteMehr?.open && !leisteMehr.contains(e.target as Node)) leisteMehr.open = false;
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && leisteMehr?.open) {
          leisteMehr.open = false;
          leisteMehr.querySelector('summary')?.focus();
        }
      });

      // Mitteilung der Redaktion: die neueste einmal anzeigen; nach dem Schließen erst die nächste neue.
      // Inhalte nur als Text (textContent) – nie als HTML.
      const SCHLUESSEL = 'kirmes-mitteilung-gelesen';
      const gelesen = (() => {
        try {
          return Number(localStorage.getItem(SCHLUESSEL) ?? 0);
        } catch {
          return 0;
        }
      })();
      if (!location.pathname.startsWith('/admin')) {
        fetch('/mitteilung.json')
          .then((r) => (r.status === 200 ? r.json() : null))
          .then((m: { id: string; titel: string; text: string; link: string | null } | null) => {
            if (!m || Number(m.id) <= gelesen) return;
            const d = document.createElement('dialog');
            d.className = 'mitteilung';
            d.setAttribute('aria-labelledby', 'mitteilung-titel');
            const kopf = document.createElement('p');
            kopf.className = 'mitteilung-art';
            kopf.textContent = 'Mitteilung';
            const h = document.createElement('h2');
            h.id = 'mitteilung-titel';
            h.textContent = m.titel;
            const text = document.createElement('div');
            text.className = 'mitteilung-text';
            for (const absatz of m.text.split(/\n{2,}/)) {
              const p = document.createElement('p');
              p.textContent = absatz;
              text.append(p);
            }
            const knoepfe = document.createElement('div');
            knoepfe.className = 'knopfreihe';
            if (m.link && /^(https:\/\/|\/)/.test(m.link)) {
              const a = document.createElement('a');
              a.className = 'knopf';
              a.href = m.link;
              a.textContent = 'Mehr erfahren';
              knoepfe.append(a);
            }
            const zu = document.createElement('button');
            zu.className = m.link ? 'knopf zweit' : 'knopf';
            zu.type = 'button';
            zu.textContent = 'Verstanden';
            zu.addEventListener('click', () => d.close());
            knoepfe.append(zu);
            d.append(kopf, h, text, knoepfe);
            d.addEventListener('close', () => {
              try {
                localStorage.setItem(SCHLUESSEL, m.id);
              } catch {
                /* privater Modus – dann eben beim nächsten Besuch erneut */
              }
              d.remove();
            });
            document.body.append(d);
            d.show();
            // show() fokussiert den Knopf und scrollt dabei ans Ende – Überschrift wieder ins Bild (Issue #257)
            d.scrollTop = 0;
          })
          .catch(() => {});
      }
    </script>
  </body>
</html>
