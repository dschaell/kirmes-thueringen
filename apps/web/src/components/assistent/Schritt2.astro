---
/** Schritt 2: Was ist los – aus KirmesAssistent.astro (Issue #199). */
import type { AssistentStand } from '../../lib/assistent';
import { KATEGORIEN, datumKurz, datumLangJahr, heute } from '../../lib/anzeige';
interface Props {
  s: AssistentStand;
  redaktion: boolean;
  ortName: string;
}
const { s, redaktion, ortName } = Astro.props;
const jahr = heute().slice(0, 4);
const NEU = 'Neue Veranstaltung';
---

<h2>Was ist los in {ortName}?</h2>
{redaktion && s.vorschlag && (s.kontaktName || s.kontaktEmail || s.nachricht) && (
  <section class="kasten einsender" aria-label="Eingereicht von">
    <p class="klein leise">Eingereicht von</p>
    <p>
      {s.kontaktName || 'ohne Namen'}
      {s.kontaktEmail && (
        <>
          {' · '}
          <a href={`mailto:${s.kontaktEmail}`}>{s.kontaktEmail}</a>
        </>
      )}
    </p>
    {s.nachricht && <p class="nachricht">{s.nachricht}</p>}
  </section>
)}
{s.vorjahrVon && (
  <p class="kasten klein">
    <strong>Vom Vorjahr übernommen</strong> (damals ab {datumLangJahr(s.vorjahrVon)}). Die neuen
    Tage sind geschätzt: gleicher Wochentag in derselben Woche des Monats (z. B. „4. Donnerstag im
    Oktober“). Bitte mit der Kirmesgesellschaft oder ihrer Ankündigung abgleichen.
  </p>
)}
<p class="leise">
  {s.vorschlag
    ? 'Prüfe den Vorschlag: Was nicht stattfindet, löschen. Titel, Tag, Uhrzeit oder Art über „ändern“ korrigieren.'
    : redaktion
      ? 'Jede Veranstaltung mit Titel, Tag und Uhrzeit eintragen. Was nicht stattfindet: „Löschen“.'
      : 'Tragt jede Veranstaltung eurer Kirmes ein – Titel, Tag und Uhrzeit. Was nicht stattfindet, einfach löschen.'}
</p>
{s.zeilen.length === 0 && (
  <p class="kasten">Noch keine Veranstaltung – unten „+ Veranstaltung hinzufügen“ wählen.</p>
)}
<ul class="programm-kompakt" data-neu={NEU}>
  {s.zeilen.map((z, i) => (
    <li class="programmzeile">
      <div class="zeilenkopf">
        <strong class="zeilentitel">{z.titel.trim() || NEU}</strong>
        <span class="klein leise zeitangabe">
          {[datumKurz(z.datum, jahr), z.beginn && `${z.beginn} Uhr`].filter(Boolean).join(' · ')}
        </span>
      </div>
      <button
        class="zeile-loeschen"
        name="aktion"
        value={`loeschen-${i}`}
        formnovalidate
        aria-label={`${z.titel.trim() || NEU} löschen`}
      >
        Löschen
      </button>
      <details open={!z.titel.trim()}>
        <summary aria-label={`${z.titel.trim() || NEU} ändern`}>ändern</summary>
        <div class="zeilenfelder">
          <label>
            Veranstaltung
            <input
              name={`titel-${i}`}
              list="titel-assistent"
              maxlength="200"
              value={z.titel}
              placeholder="z. B. Kirmestanz, Gottesdienst, Ständchen"
            />
          </label>
          <div class="zwei">
            <label>
              Tag
              <input name={`datum-${i}`} type="date" value={z.datum} />
            </label>
            <label>
              Uhrzeit
              <input name={`beginn-${i}`} type="time" value={z.beginn ?? ''} />
            </label>
          </div>
          <label>
            Art
            <select name={`kat-${i}`}>
              <option value="" selected={!z.kategorie}>
                Automatisch (aus dem Titel)
              </option>
              {Object.entries(KATEGORIEN).map(([k, { label }]) => (
                <option value={k} selected={z.kategorie === k}>
                  {label}
                </option>
              ))}
            </select>
          </label>
        </div>
      </details>
    </li>
  ))}
</ul>
<button class="knopf zweit" name="aktion" value="eigen" formnovalidate>
  + Veranstaltung hinzufügen
</button>
<div class="knopfreihe">
  <>
    <button class="knopf zweit" name="aktion" value="zurueck" formnovalidate>
      Zurück
    </button>
    <button class="knopf" name="aktion" value="weiter">
      Weiter zu den Details
    </button>
  </>
</div>
