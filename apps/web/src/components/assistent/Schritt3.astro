---
/** Schritt 3: Details – aus KirmesAssistent.astro (Issue #199). */
import type { AssistentStand } from '../../lib/assistent';
import { mitEssen } from '../../lib/assistent';
import TerminFelder from '../admin/TerminFelder.astro';
import { erkenneKategorie } from '@kirmes/core';
import { anzahl, datumLangJahr, uhrzeitText } from '../../lib/anzeige';
interface Props {
  s: AssistentStand;
  redaktion: boolean;
  ortName: string;
}
const { s, redaktion, ortName } = Astro.props;
const aktive = s.zeilen.filter((z) => z.aktiv).length;
// Plakat / Flyer (Issue #353): nur beim Neuanlegen in der Redaktion
const mitPlakat = redaktion && !s.vorschlag;
const BILDER = 'image/jpeg,image/png,image/webp';
// Dateien überstehen kein erneutes Anzeigen des Formulars
const plakatErneut = s.fehler.length > 0 || (s.doppelt?.length ?? 0) > 0;
/** Bisherige Feldnamen des Assistenten (programm.ts liest sie so ein) */
const NAMEN: Record<string, string> = {
  veranstaltungsort: 'wo',
  standort: 'karte',
  muttizettel: 'mutti',
};
const namen = (feld: string, i: number, j?: number) =>
  feld === 'speise'
    ? `gericht-${i}-${j}`
    : feld === 'preis'
      ? `preis-${i}-${j}`
      : `${NAMEN[feld] ?? feld}-${i}`;
---

<h2>Programm prüfen und Details ergänzen</h2>
{redaktion && s.vorschlag && (s.kontaktName || s.kontaktEmail || s.nachricht) && (
  <section class="kasten einsender" aria-label="Eingereicht von">
    <p class="klein leise">Eingereicht von</p>
    <p>
      {s.kontaktName || 'ohne Namen'}
      {s.kontaktEmail && (
        <>
          {' · '}
          <a href={`mailto:${s.kontaktEmail}`}>{s.kontaktEmail}</a>
        </>
      )}
    </p>
    {s.nachricht && <p class="nachricht">{s.nachricht}</p>}
  </section>
)}
<p>
  <strong>{ortName}</strong> –{' '}
  {anzahl(s.zeilen.filter((z) => z.aktiv).length, 'Veranstaltung', 'Veranstaltungen')}{' '}
  {s.zeilen.filter((z) => z.aktiv).length === 1
    ? redaktion
      ? 'wird veröffentlicht'
      : 'wird vorgeschlagen'
    : redaktion
      ? 'werden veröffentlicht'
      : 'werden vorgeschlagen'}
  . Ort, Musik, Eintritt, Essen & Getränke – alles freiwillig.
</p>
<p class="klein leise">Titel, Tag oder Uhrzeit ändern: „Zurück zum Programm“.</p>
{mitPlakat && (
  <fieldset class="gruppe plakat-hochladen">
    <legend>Plakat / Flyer für die ganze Kirmes</legend>
    <label>
      Plakat, Flyer oder Foto hochladen (optional)
      <input type="file" name="plakat" accept={BILDER} />
      <span class="klein leise">
        Erscheint bei allen Veranstaltungen ohne eigenes Bild. JPEG, PNG oder WebP, höchstens 8 MB.
        Nur Bilder, an denen ihr die Rechte habt. Wir speichern eine verkleinerte Kopie ohne
        Metadaten.
      </span>
    </label>
    {plakatErneut && (
      <p class="klein">
        <strong>Bilder bitte noch einmal auswählen</strong> – sie wurden nicht behalten.
      </p>
    )}
  </fieldset>
)}
{s.zeilen.map(
  (z, i) =>
    z.aktiv && (
      // Wenige Veranstaltungen: Details gleich offen; viele: zugeklappt, aber deutlich (Issue #353)
      <details class="veranstaltung" open={aktive <= 3}>
        <summary>
          <strong>{z.titel}</strong>
          <span class="leise klein">
            {datumLangJahr(z.datum)}
            {uhrzeitText(z) && ` · ${uhrzeitText(z)} Uhr`}
          </span>
          <span class="details-hinweis">
            Details: Ort, Musik, Eintritt, Essen{mitPlakat && ', Plakat'} …
          </span>
        </summary>
        <div class="details-inhalt">
          <TerminFelder
            w={{
              ...z,
              kategorie: z.kategorie || erkenneKategorie(z.titel),
              standort: z.karte ?? '',
              essen: mitEssen(z),
            }}
            name={(feld, j) => namen(feld, i, j)}
            mitWann={false}
            mitKarte={!redaktion || !s.vorschlag}
            gerichtAktion={`gerichte-${i}`}
            kartenHinweis={
              redaktion
                ? 'Wird als Platz im Ort gespeichert – gilt für alle Termine mit gleichem „Wo genau?“.'
                : 'Nur Links von Google Maps. Wir speichern nur den Kartenpunkt, die Redaktion prüft ihn.'
            }
            veranstalterPlatzhalter={`Kirmesgesellschaft ${ortName}`}
            listen={{ bands: 'bands-assistent', plaetze: 'plaetze-assistent' }}
          >
            {redaktion && z.platz && (
              <div class="kasten kartenpunkt" slot="wo">
                <p class="klein">
                  Kartenpunkt vom Einsender:{' '}
                  <a
                    href={`https://www.google.com/maps/search/?api=1&query=${z.platz.lat},${z.platz.lon}`}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    auf der Karte ansehen
                  </a>
                </p>
                <label class="klein">
                  <input
                    type="checkbox"
                    name={`platz-${i}`}
                    checked={z.platzUebernehmen === true}
                  />{' '}
                  Als Platz „{z.veranstaltungsort || '–'}“ in {ortName} übernehmen (gilt dann für
                  alle Termine mit diesem „Wo genau?“)
                </label>
              </div>
            )}
            {mitPlakat && (
              <fieldset class="gruppe plakat-hochladen">
                <legend>Plakat / Flyer</legend>
                <label>
                  Eigenes Bild nur für diese Veranstaltung (optional)
                  <input type="file" name={`plakat-${i}`} accept={BILDER} />
                  <span class="klein leise">Sonst gilt das Plakat für die ganze Kirmes.</span>
                </label>
              </fieldset>
            )}
          </TerminFelder>
        </div>
      </details>
    ),
)}
{redaktion && (s.doppelt?.length ?? 0) > 0 && (
  <section class="kasten doppelt" role="alert" aria-labelledby="doppelt-titel">
    <h3 id="doppelt-titel">Gibt es das schon?</h3>
    <ul>
      {s.doppelt?.map((d) => (
        <li>{d}</li>
      ))}
    </ul>
    <p class="klein">
      Vielleicht hat jemand aus der Redaktion die Kirmes schon eingetragen. Bitte kurz prüfen.
    </p>
    <label>
      <input type="checkbox" name="doppeltOk" /> Geprüft – trotzdem zusätzlich anlegen
    </label>
  </section>
)}
{redaktion ? null : (
  <>
    <h3>Für Rückfragen (freiwillig)</h3>
    <label>
      Name / Kirmesgesellschaft
      <input name="kontaktName" maxlength="120" autocomplete="organization" value={s.kontaktName} />
    </label>
    <label>
      E-Mail
      <input
        name="kontaktEmail"
        type="email"
        maxlength="200"
        autocomplete="email"
        value={s.kontaktEmail}
      />
    </label>
    <label>
      Nachricht an die Redaktion
      <textarea name="nachricht" maxlength="2000" rows="3" set:text={s.nachricht} />
    </label>
    <p class="klein leise">
      Dein Vorschlag wird erst nach Prüfung veröffentlicht. Kontaktdaten dienen nur Rückfragen und
      werden nach der Prüfung gelöscht. Mehr im <a href="/datenschutz#vorschlaege">Datenschutz</a>.
    </p>
  </>
)}
<div class="knopfreihe">
  <>
    <button class="knopf zweit" name="aktion" value="zurueck" formnovalidate>
      Zurück zum Programm
    </button>
    <button class="knopf" name="aktion" value="speichern">
      {redaktion
        ? s.vorschlag
          ? 'Prüfung abschließen und übernehmen'
          : 'Kirmes speichern'
        : 'Vorschlag senden'}
    </button>
  </>
</div>
