---
/**
 * Terminliste wie im Veranstaltungskalender einer Zeitung: Überschrift je Tag, darunter kompakte Zeilen.
 * „Route“ öffnet Google Maps bzw. auf Apple-Geräten Apple Karten (siehe Skript unten).
 */
import type { TerminDto } from '../lib/api';
import {
  monatName,
  eigenerPlatz,
  platzText,
  relativerTag,
  routenLinks,
  tagMonat,
  wochentag,
  artName,
  plakatPfad,
  bandsAus,
} from '../lib/anzeige';
import Icon from './Icon.astro';

interface Props {
  termine: TerminDto[];
  /** Ort in jeder Zeile verlinken (auf Ortsseiten überflüssig) */
  ortLinks?: boolean;
  /** Zwischenüberschriften je Monat */
  monate?: boolean;
  /** Erklärung zu unbestätigten Terminen über der Liste */
  hinweis?: boolean;
  /** Eigenen Leer-Hinweis zeigen (aus, wenn die Seite selbst Auswege anbietet) */
  leer?: boolean;
  /** Entfernung in km je Termin-ID (Umkreissuche, Issue #296) */
  entfernung?: Record<string, number>;
}
const {
  termine,
  ortLinks = true,
  monate = true,
  hinweis = true,
  leer = true,
  entfernung,
} = Astro.props;

type Tag = { datum: string; termine: TerminDto[] };
const gruppen: { monat: string; tage: Tag[] }[] = [];
for (const t of termine) {
  const monat = monate ? monatName(t.datum) : '';
  let g = gruppen.at(-1);
  if (!g || g.monat !== monat) gruppen.push((g = { monat, tage: [] }));
  let tag = g.tage.at(-1);
  if (!tag || tag.datum !== t.datum) g.tage.push((tag = { datum: t.datum, termine: [] }));
  tag.termine.push(t);
}
const unbestaetigt = termine.some((t) => !t.bestaetigt);
---

{leer && termine.length === 0 && (
  <p class="leer">Für diesen Zeitraum sind keine Termine eingetragen.</p>
)}
{hinweis && unbestaetigt && (
  <p class="hinweis-liste">
    Termine ohne{' '}
    <span class="bestaetigt">
      <Icon name="haken" groesse={14} />
      bestätigt
    </span>{' '}
    stammen aus öffentlichen Ankündigungen und sind noch nicht vom Veranstalter bestätigt.
  </p>
)}
{gruppen.map((g) => (
  <>
    {g.monat && gruppen.length > 1 && <h2 class="monat">{g.monat}</h2>}
    {g.tage.map((tag) => (
      <section class="tag" aria-labelledby={`tag-${tag.datum}`}>
        <h3 class="tag-kopf" id={`tag-${tag.datum}`}>
          <span>
            {wochentag(tag.datum)}, {tagMonat(tag.datum)}
          </span>
          {relativerTag(tag.datum) && <span class="relativ">{relativerTag(tag.datum)}</span>}
        </h3>
        <ul class="eintraege">
          {tag.termine.map((t) => {
            const route = routenLinks(t);
            return (
              <li class="eintrag">
                <span class:list={['zeit', { offen: !t.beginn }]}>
                  {t.beginn ?? 'ganztags'}
                  {t.beginn && t.ende && t.ende !== t.beginn && (
                    <span class="bis">bis {t.ende}</span>
                  )}
                </span>
                <div>
                  {t.plakat && (
                    // Vorschau (Issue #306): feste Größe, damit nichts springt
                    <img
                      class="liste-plakat"
                      src={plakatPfad(t.id, t.plakat, 'klein')}
                      alt=""
                      width="56"
                      height="80"
                      loading="lazy"
                      decoding="async"
                    />
                  )}
                  <a class="titel" href={`/termin/${t.id}`}>
                    {t.titel}
                  </a>{' '}
                  {/* Leerzeichen: sonst darf iOS-Safari nicht vor dem Etikett umbrechen (Issue #366) */}
                  <span class={`kat kat-${t.kategorie}`}>{artName(t.kategorie, true)}</span>
                  {t.muttizettel && <span class="mutti">U18 nur mit Muttizettel</span>}
                  {t.bestaetigt && (
                    <span class="bestaetigt" title="Vom Veranstalter bestätigt">
                      <Icon name="haken" groesse={14} />
                      bestätigt
                    </span>
                  )}
                  <div class="wo">
                    {ortLinks ? (
                      <a class="ortname" href={`/orte/${t.ort.slug}`}>
                        {t.ort.name}
                      </a>
                    ) : (
                      <span class="ortname">{t.ort.name}</span>
                    )}
                    {platzText(t) && <> · {platzText(t)}</>}
                    {entfernung?.[t.id] !== undefined && (
                      <span class="entfernung">
                        {' '}
                        · {Math.max(1, Math.round(entfernung[t.id]!))} km
                      </span>
                    )}
                  </div>
                  {t.band && (
                    <div class="band">
                      <Icon name="musik" groesse={14} />
                      <span class="sr-only">Musik: </span>
                      <ul class="bands">
                        {bandsAus(t.band).map((b) => (
                          <li>{b}</li>
                        ))}
                      </ul>
                    </div>
                  )}
                </div>
                <div class="aktionen">
                  {route && (
                    <a
                      class="route"
                      href={route.google}
                      data-apple={route.apple}
                      rel="noopener"
                      target="_blank"
                      aria-label={`Route nach ${t.ort.name}${eigenerPlatz(t) ? `, ${eigenerPlatz(t)}` : ''}`}
                    >
                      <Icon name="route" groesse={16} />
                      Route
                    </a>
                  )}
                  <button
                    type="button"
                    class="merken"
                    data-merken={t.id}
                    aria-pressed="false"
                    aria-label={`${t.titel} in ${t.ort.name} merken`}
                    hidden
                  >
                    <Icon name="stern" groesse={16} />
                    <span class="merken-text">Merken</span>
                  </button>
                </div>
              </li>
            );
          })}
        </ul>
      </section>
    ))}
  </>
))}

<script>
  import '../scripts/merken';
  // Auf iPhone, iPad und Mac Apple Karten öffnen, sonst Google Maps.
  if (/iPhone|iPad|Macintosh/.test(navigator.userAgent)) {
    for (const a of document.querySelectorAll<HTMLAnchorElement>('a[data-apple]')) {
      a.href = a.dataset.apple!;
    }
  }
</script>
