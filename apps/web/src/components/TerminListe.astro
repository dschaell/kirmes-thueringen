---
import type { TerminDto } from '../lib/api';
import { KATEGORIEN, kreisName, monatName } from '../lib/anzeige';

interface Props {
  termine: TerminDto[];
  ortLinks?: boolean;
  gruppieren?: boolean;
}
const { termine, ortLinks = true, gruppieren = true } = Astro.props;

const gruppen = new Map<string, TerminDto[]>();
for (const t of termine) {
  const key = gruppieren ? monatName(t.datum) : '';
  gruppen.set(key, [...(gruppen.get(key) ?? []), t]);
}
const wt = (iso: string) =>
  new Date(iso).toLocaleDateString('de-DE', { weekday: 'short', timeZone: 'UTC' });
const mon = (iso: string) =>
  new Date(iso).toLocaleDateString('de-DE', { month: 'short', timeZone: 'UTC' });
---

{termine.length === 0 && <p class="leer">Keine Termine gefunden.</p>}
{
  [...gruppen].map(([monat, liste]) => (
    <section>
      {monat && <h2 class="monat">{monat}</h2>}
      <ul class="liste">
        {liste.map((t) => (
          <li class="termin" id={t.id}>
            <div class="kal" aria-hidden="true">
              <div class="wt">{wt(t.datum)}</div>
              <div class="tag">{+t.datum.slice(8, 10)}</div>
              <div class="mon">{mon(t.datum)}</div>
            </div>
            <div>
              <h3>
                {KATEGORIEN[t.kategorie].emoji} {t.titel}
              </h3>
              <div class="meta">
                <span>
                  📍 {ortLinks ? <a href={`/orte/${t.ort.slug}`}>{t.ort.name}</a> : t.ort.name}
                  <span title={kreisName(t.ort.landkreis)}> ({t.ort.landkreis})</span>
                </span>
                {t.veranstaltungsort && <span>🏛️ {t.veranstaltungsort}</span>}
                {t.beginn && <span>🕗 {t.beginn} Uhr</span>}
                {!t.bestaetigt && (
                  <span
                    class="badge warn"
                    title="Datum aus Vorjahren hochgerechnet – noch nicht vom Veranstalter bestätigt"
                  >
                    unbestätigt
                  </span>
                )}
              </div>
            </div>
          </li>
        ))}
      </ul>
    </section>
  ))
}
