---
import type { AssistentStand } from '../lib/assistent';
import Schritt1 from './assistent/Schritt1.astro';
import Schritt2 from './assistent/Schritt2.astro';
import Schritt3 from './assistent/Schritt3.astro';
import type { OrtUebersichtDto } from '../lib/api';
import { LANDKREISE, kreisKurz } from '../lib/anzeige';
import { aehnlicheOrte, bezeichner } from '../lib/ortssuche';
import { nurEigenerOrt, type LandkreisKuerzel } from '@kirmes/core';
interface Props {
  stand: AssistentStand;
  redaktion?: boolean;
  csrf: string;
  orte: OrtUebersichtDto[];
  bands?: string[];
  titel?: string[];
  plaetze?: string[];
}
const {
  stand: s,
  redaktion = false,
  csrf,
  orte,
  bands = [],
  titel = [],
  plaetze = [],
} = Astro.props;
// Kirmesgesellschaft: fester Ort ohne Suche (Issue #180)
const kgOrt = redaktion && nurEigenerOrt(Astro.locals);
const ort = orte.find((o) => o.slug === s.ortSlug);
// Frisch angelegter Ort steht evtl. noch nicht in der (zwischengespeicherten) Ortsliste
const ortName = ort?.name ?? s.ortEingabe ?? s.ortSlug;
// Redaktion: Ort nicht im Verzeichnis → ähnliche Orte oder neu anlegen (Issue #167)
const unbekannt = redaktion && s.schritt === 1 && s.ortUnbekannt === true;
const aehnliche = unbekannt ? aehnlicheOrte(orte, s.ortEingabe ?? '') : [];
const neuerOrtName = (s.ortEingabe ?? '').replace(/\s*\([^)]*\)\s*$/, '').trim();
const kreise = (Object.keys(LANDKREISE) as LandkreisKuerzel[]).sort((a, b) =>
  kreisKurz(a).localeCompare(kreisKurz(b), 'de'),
);
const ortBezeichnung = bezeichner(orte);
const ortText = ort ? ortBezeichnung(ort) : (s.ortEingabe ?? s.ortSlug);
const eigeneDauer = Number(s.tage) > 4;
---

<div class="kirmes-assistent">
  <ol class="schritte" aria-label="Fortschritt">
    {['Wo und wann?', 'Was ist los?', 'Details'].map((t, i) => (
      <li aria-current={s.schritt === i + 1 ? 'step' : undefined}>
        <span>{i + 1}</span>
        {t}
      </li>
    ))}
  </ol>
  {s.fehler.length > 0 && (
    <div class="meldung" role="alert">
      <>
        <p>Bitte prüfe deine Angaben:</p>
        <ul>
          {s.fehler.map((f) => (
            <li>{f}</li>
          ))}
        </ul>
      </>
      {redaktion && (
        <a
          href={`/admin?zeitraum=alle&q=${encodeURIComponent(ortName)}`}
          target="_blank"
          rel="noopener"
        >
          Vorhandene Termine in einem neuen Fenster suchen
        </a>
      )}
    </div>
  )}
  <form method="post" class="melden" data-ungespeichert>
    <input type="hidden" name="csrf_token" value={csrf} />
    <input type="hidden" name="stand" value={JSON.stringify(s)} />
    <label class="falle" aria-hidden="true">
      Webseite
      <input name="webseite" tabindex="-1" autocomplete="off" />
    </label>
    {s.schritt === 1 && (
      <Schritt1
        s={s}
        kgOrt={kgOrt}
        ort={ort}
        unbekannt={unbekannt}
        aehnliche={aehnliche}
        neuerOrtName={neuerOrtName}
        kreise={kreise}
        ortText={ortText}
        eigeneDauer={eigeneDauer}
      />
    )}
    {s.schritt === 2 && <Schritt2 s={s} redaktion={redaktion} ortName={ortName} />}
    {s.schritt === 3 && <Schritt3 s={s} redaktion={redaktion} ortName={ortName} />}
  </form>
  <datalist id="bands-assistent">
    {bands.map((b) => (
      <option value={b} />
    ))}
  </datalist>
  <datalist id="titel-assistent">
    {titel.map((t) => (
      <option value={t} />
    ))}
  </datalist>
  <datalist id="plaetze-assistent">
    {plaetze.map((p) => (
      <option value={p} />
    ))}
  </datalist>
</div>
<style is:global>
  /* Global, aber unter .kirmes-assistent begrenzt – wirkt so auch in den Schritt-Komponenten (#199) */
  .kirmes-assistent {
    max-width: 680px;
  }
  .kirmes-assistent {
    .zeitraumfelder {
      grid-template-columns: 1fr;
    }
    @media (min-width: 700px) {
      .zeitraumfelder {
        grid-template-columns: 0.8fr 1.2fr;
      }
      .eigene-dauer {
        grid-column: 2;
      }
    }
    .schritte {
      display: flex;
      list-style: none;
      padding: 0;
      gap: 10px;
      margin: 24px 0;
    }
    .schritte li {
      flex: 1;
      font-size: 0.9rem;
      color: var(--grau);
      border-bottom: 3px solid var(--linie);
      padding-bottom: 12px;
    }
    .schritte li[aria-current] {
      color: var(--rot);
      font-weight: 700;
      border-color: var(--rot);
    }
    .schritte span {
      display: block;
      font-weight: 700;
      margin-bottom: 4px;
    }
    .programm {
      display: grid;
      gap: 16px;
    }
    .veranstaltung {
      min-width: 0;
      border: 1px solid var(--linie);
      border-radius: var(--r);
      padding: 16px;
      margin: 0;
      background: var(--flaeche);
    }
    .veranstaltung legend {
      padding: 0 8px;
      font-weight: 700;
    }
    .veranstaltung legend label {
      display: inline;
    }
    .veranstaltung summary {
      cursor: pointer;
      min-height: 44px;
    }
    .veranstaltung summary span {
      display: block;
      margin-top: 4px;
    }
    .details-inhalt {
      display: grid;
      gap: 16px;
      margin-top: 16px;
    }
    .speisen-felder {
      display: grid;
      gap: 12px;
    }
    /* Essen & Getränke erst nach Haken – auch ohne JavaScript (Issue #155) */
    .details-inhalt:not(:has(input[name^='essen-']:checked)) .speisen-felder {
      display: none;
    }
    .abgewaehlt {
      opacity: 0.65;
    }
    /* Schritt 2: eine kompakte Zeile je Veranstaltung (Issue #87) */
    .programm-kompakt {
      list-style: none;
      padding: 0;
      margin: 0 0 16px;
      border: 1px solid var(--linie);
      border-radius: var(--r);
      background: var(--flaeche);
    }
    .programmzeile {
      position: relative;
      padding: 6px 12px;
    }
    .programmzeile + .programmzeile {
      border-top: 1px solid var(--linie);
    }
    .programmzeile:has(input[type='checkbox']:checked) {
      opacity: 1;
    }
    .programmzeile:has(input[type='checkbox']:not(:checked)) {
      opacity: 0.65;
    }
    .zeilenwahl {
      padding-right: 72px;
      display: flex;
      align-items: center;
      gap: 12px;
      min-height: 52px;
      cursor: pointer;
    }
    .zeilenwahl input {
      width: 24px;
      height: 24px;
      flex: none;
    }
    .zeilenwahl > span {
      display: grid;
      gap: 2px;
    }
    .programmzeile summary {
      position: absolute;
      top: 10px;
      right: 8px;
      min-height: 44px;
      display: inline-flex;
      align-items: center;
      padding: 0 8px;
      cursor: pointer;
      color: var(--fokus);
      text-decoration: underline;
      list-style: none;
    }
    .programmzeile summary::-webkit-details-marker {
      display: none;
    }
    .zeilenfelder {
      display: grid;
      gap: 12px;
      padding: 4px 0 12px;
    }
    .zeilenfelder input {
      width: 100%;
      max-width: none;
    }
    .knopfreihe {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
    }
    button {
      min-height: 44px;
    }
    .einsender p {
      margin: 0 0 4px;
    }
    .einsender .nachricht {
      white-space: pre-line;
    }
    /* Ort fehlt im Verzeichnis (Issue #167) */
    .neuer-ort {
      display: grid;
      gap: 10px;
      margin: 4px 0 16px;
    }
    .neuer-ort h3 {
      margin: 0;
    }
    .neuer-ort .aehnliche {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }
    .kartenpunkt {
      display: grid;
      gap: 6px;
    }
    /* Mögliche Doppelungen (Issue #178) */
    .doppelt {
      border-color: var(--gold);
      display: grid;
      gap: 8px;
    }
    .doppelt h3,
    .doppelt ul {
      margin: 0;
    }
  }
</style>
<script>
  import '../scripts/ortssuche';
  import '../scripts/programmreihenfolge';
  import '../scripts/eigene-dauer';
  import '../scripts/kartenlink-name';
</script>
