---
/**
 * Optionale Endzeit (Issue #286), z. B. Kartenvorverkauf 10–12 Uhr. Das Feld erscheint erst nach dem
 * Haken – auch ohne JavaScript; ohne Haken wird keine Endzeit gespeichert.
 */
interface Props {
  ende: string;
  /** Anhang an die Feldnamen, z. B. „-0“ im Kirmes-Assistenten (mitende-0, ende-0) */
  zusatz?: string;
}
const { ende, zusatz = '' } = Astro.props;
---

<div class="endzeit">
  <label class="klein">
    <input
      type="checkbox"
      class="mitende"
      name={`mitende${zusatz}`}
      value="ja"
      checked={Boolean(ende)}
    />{' '}
    Endzeit angeben (z. B. Kartenvorverkauf bis 12 Uhr)
  </label>
  <label class="endzeit-feld">
    Ende
    <input type="time" name={`ende${zusatz}`} value={ende} />
    <span class="klein leise">Früher als der Beginn = nach Mitternacht.</span>
  </label>
</div>
<style>
  .endzeit {
    display: grid;
    gap: 0.5rem;
  }
  .endzeit-feld {
    display: none !important;
  }
  .endzeit:has(.mitende:checked) .endzeit-feld {
    display: grid !important;
  }
</style>
