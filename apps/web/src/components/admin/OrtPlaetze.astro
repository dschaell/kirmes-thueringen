---
/** Plätze eines Ortes mit Kartenpunkt (Kirche, Festzelt …) – aus admin/termine.astro (Issue #199). */
import CsrfFeld from './CsrfFeld.astro';
import Icon from '../Icon.astro';
interface Props {
  ort: { name: string };
  plaetze: { name: string; koordinate: { lat: number; lon: number } }[];
  offen: boolean;
  googleSuche: string;
}
const { ort, plaetze, offen, googleSuche } = Astro.props;
---

<details class="filter plaetze" id="plaetze" open={offen}>
  <summary>
    <Icon name="route" />
    Plätze in {ort.name} ({plaetze.length}) – für die genaue Route
  </summary>
  <p class="leise klein">
    Einmal pro Ort anlegen, z. B. „Kirche“, „Festzelt“, „Kulturhaus“. Termine, deren „Wo genau?“
    gleich heißt, führen dann per „Route“ genau dorthin. Ein Platz ohne Namen gilt für alle übrigen
    Termine des Ortes.
  </p>
  {plaetze.length > 0 && (
    <table class="admin-tabelle">
      <tbody>
        {plaetze.map((pl) => (
          <tr>
            <td>
              <strong>{pl.name || 'Hauptfestplatz'}</strong>
            </td>
            <td class="klein">
              <a
                href={`https://www.google.com/maps/search/?api=1&query=${pl.koordinate.lat},${pl.koordinate.lon}`}
                target="_blank"
                rel="noopener"
              >
                In Google Maps prüfen
              </a>
            </td>
            <td>
              <form method="post">
                <CsrfFeld />
                <input type="hidden" name="aktion" value="platz-loeschen" />
                <input type="hidden" name="platzname" value={pl.name} />
                <button class="knopf zweit" type="submit">
                  Löschen
                </button>
              </form>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  )}
  <form class="melden" method="post" data-ungespeichert>
    <CsrfFeld />
    <input type="hidden" name="aktion" value="platz" />
    <div class="zwei">
      <label>
        Name des Platzes (optional)
        <input
          name="platzname"
          maxlength="120"
          list="vo-liste"
          placeholder="leer = Name aus dem Link, sonst Hauptfestplatz"
        />
      </label>
      <label>
        Standort aus Google Maps *
        <input
          name="standort"
          data-kartenlink-name="platzname"
          required
          maxlength="2000"
          placeholder="https://maps.app.goo.gl/… oder 50.8475, 11.0412"
        />
      </label>
    </div>
    <p class="leise klein">
      So geht's:{' '}
      <a href={googleSuche} target="_blank" rel="noopener">
        {ort.name} in Google Maps öffnen
      </a>
      , lange auf die Stelle tippen (Pin setzen), „Teilen“ → „Link kopieren“, hier einfügen.
    </p>
    <div>
      <button class="knopf zweit" type="submit">
        Platz speichern
      </button>
    </div>
  </form>
</details>
