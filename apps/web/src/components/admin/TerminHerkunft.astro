---
import type { TerminHerkunft } from '@kirmes/core';
interface Props {
  herkunft?: TerminHerkunft;
}
const { herkunft: h } = Astro.props;
const name =
  h?.name ??
  (h?.weg === 'bearbeitungslink'
    ? 'Kirmesgesellschaft'
    : h?.angelegtAm
      ? 'Nicht mehr zuordenbar'
      : 'Nicht dokumentiert');
const zeit = (iso: string) =>
  new Date(iso).toLocaleString('de-DE', {
    dateStyle: 'medium',
    timeStyle: 'short',
    timeZone: 'Europe/Berlin',
  });
const datum = h?.angelegtAm ? zeit(h.angelegtAm) : null;
// Zuletzt bearbeitet (Issue #181)
const g = h?.geaendert;
const gName =
  g?.name ?? (g?.weg === 'bearbeitungslink' ? 'Kirmesgesellschaft' : 'Nicht mehr zuordenbar');
---

<p class="klein leise">
  {h
    ? `${h.weg === 'vorschlag' ? 'Übernommen von' : 'Angelegt von'}: ${name}`
    : 'Erstellerangabe derzeit nicht verfügbar.'}
  {datum && ` · ${datum}`}
  {h?.weg === 'vorschlag' && ' · aus öffentlichem Vorschlag übernommen'}
  {h?.weg === 'bearbeitungslink' && ' · über Bearbeitungslink'}
</p>
{g && (
  <p class="klein leise">
    Zuletzt bearbeitet von: {gName} · {zeit(g.am)}
    {g.weg === 'bearbeitungslink' && ' · über Bearbeitungslink'}
  </p>
)}
