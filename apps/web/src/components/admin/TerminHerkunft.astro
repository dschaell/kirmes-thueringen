---
import type { TerminHerkunft } from '@kirmes/core';
interface Props {
  herkunft?: TerminHerkunft;
  /** Eine Zeile für lange Listen (Issue #331) */
  kompakt?: boolean;
}
const { herkunft: h, kompakt = false } = Astro.props;
// Unbekannte Herkunft (z. B. vor Einführung des Protokolls) wird nicht angezeigt – Issue #218
const name =
  h?.name ??
  (h?.weg === 'bearbeitungslink'
    ? 'Kirmesgesellschaft'
    : h?.angelegtAm
      ? 'Konto inzwischen gelöscht'
      : null);
const zeit = (iso: string) =>
  new Date(iso).toLocaleString('de-DE', {
    dateStyle: 'medium',
    timeStyle: 'short',
    timeZone: 'Europe/Berlin',
  });
const datum = h?.angelegtAm ? zeit(h.angelegtAm) : null;
// Zuletzt bearbeitet (Issue #181)
const g = h?.geaendert;
const gName =
  g?.name ?? (g?.weg === 'bearbeitungslink' ? 'Kirmesgesellschaft' : 'Konto inzwischen gelöscht');
---

{kompakt && h && name && (
  <p class="klein leise">
    {`${h.weg === 'vorschlag' ? 'Übernommen' : 'Angelegt'}: ${name}`}
    {datum && ` · ${datum}`}
    {g && ` · zuletzt bearbeitet: ${gName}, ${zeit(g.am)}`}
  </p>
)}
{!kompakt && h && name && (
  <p class="klein leise">
    {`${h.weg === 'vorschlag' ? 'Übernommen von' : 'Angelegt von'}: ${name}`}
    {datum && ` · ${datum}`}
    {h.weg === 'vorschlag' && ' · aus öffentlichem Vorschlag übernommen'}
    {h.weg === 'bearbeitungslink' && ' · über Bearbeitungslink'}
  </p>
)}
{!kompakt && g && (
  <p class="klein leise">
    Zuletzt bearbeitet von: {gName} · {zeit(g.am)}
    {g.weg === 'bearbeitungslink' && ' · über Bearbeitungslink'}
  </p>
)}
