---
/** Neuer Einzeltermin mit Recherche-Assistent – aus admin/termine.astro (Issue #199). */
import CsrfFeld from './CsrfFeld.astro';
import TerminFelder, { type TerminWerte } from './TerminFelder.astro';
import Icon from '../Icon.astro';
interface Props {
  einzelWerte: TerminWerte | null;
  /** Platzhalter für „Veranstalter“ */
  ortName: string;
  veranstaltungsorte: string[];
}
const { einzelWerte, ortName, veranstaltungsorte } = Astro.props;
---

<h2>Neuer Termin</h2>
<details class="filter" open>
  <summary>
    <Icon name="suche" />
    Recherche-Assistent: Text aus Instagram, Facebook oder Amtsblatt einfügen
  </summary>
  <div class="filterfelder">
    <textarea
      id="assistent"
      rows="5"
      placeholder="Text der Ankündigung hier einfügen – Datum, Uhrzeit, Titel und Ort werden vorgeschlagen."
    />
    <p class="leise klein" id="assistent-info">
      Datum, Uhrzeit, Titel und Ort werden ins Formular übernommen – bitte vor dem Speichern prüfen.
    </p>
  </div>
</details>

<form class="melden" method="post" id="terminformular" enctype="multipart/form-data">
  <CsrfFeld />
  <input type="hidden" name="aktion" value="speichern" />
  <TerminFelder
    w={einzelWerte ?? {}}
    artAutomatisch
    gerichtAktion={null}
    veranstalterPlatzhalter={ortName}
    kartenHinweis="Wird als Platz im Ort gespeichert – gilt für alle Termine mit gleichem „Wo genau?“."
    listen={{ titel: 'titel-liste', bands: 'band-liste', plaetze: 'vo-liste' }}
  >
    <fieldset class="gruppe plakat-hochladen">
      <legend>Plakat / Flyer</legend>
      <label>
        Plakat, Flyer oder Foto hochladen (optional)
        <input type="file" name="plakat" accept="image/jpeg,image/png,image/webp" />
        <span class="klein leise">
          JPEG, PNG oder WebP, höchstens 8 MB. Nur Bilder, an denen ihr die Rechte habt. Wir
          speichern eine verkleinerte Kopie ohne Metadaten.
        </span>
      </label>
    </fieldset>
  </TerminFelder>
  <datalist id="vo-liste">
    {veranstaltungsorte.map((v) => (
      <option value={v!} />
    ))}
  </datalist>
  <div class="knopfreihe">
    <button class="knopf" type="submit">
      Speichern
    </button>
  </div>
</form>

<script>
  import { erkenneTerminAusText } from '@kirmes/core';

  const feld = document.getElementById('assistent') as HTMLTextAreaElement | null;
  const formular = document.getElementById('terminformular') as HTMLFormElement | null;
  const info = document.getElementById('assistent-info');
  if (feld && formular && info) {
    const setze = (name: string, wert: string | null) => {
      const el = formular.elements.namedItem(name) as HTMLInputElement | null;
      if (el && wert) el.value = wert;
    };
    feld.addEventListener('input', () => {
      const heute = new Intl.DateTimeFormat('en-CA', { timeZone: 'Europe/Berlin' }).format(
        new Date(),
      );
      const v = erkenneTerminAusText(feld.value, heute);
      setze('datum', v.datum);
      setze('beginn', v.beginn);
      setze('titel', v.titel);
      setze('veranstaltungsort', v.veranstaltungsort);
      const gefunden = [
        v.datum && 'Datum',
        v.beginn && 'Uhrzeit',
        v.titel && 'Titel',
        v.veranstaltungsort && 'Ort',
      ].filter(Boolean);
      info.textContent = gefunden.length
        ? `Erkannt: ${gefunden.join(', ')} – bitte im Formular prüfen.`
        : 'Nichts erkannt – bitte Felder von Hand ausfüllen.';
    });
  }
</script>
